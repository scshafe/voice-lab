{
  "$defs": {
    "AudioFileEvidence": {
      "additionalProperties": false,
      "properties": {
        "audio": {
          "anyOf": [
            {
              "$ref": "#/$defs/AudioSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "kind": {
          "enum": [
            "utterance",
            "room-tone",
            "calibration"
          ],
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "prompt_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/StableId"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "size_bytes": {
          "exclusiveMinimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "transcript": {
          "anyOf": [
            {
              "maxLength": 2000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Transcript"
        }
      },
      "required": [
        "path",
        "kind",
        "sha256",
        "size_bytes"
      ],
      "title": "AudioFileEvidence",
      "type": "object"
    },
    "AudioSpec": {
      "additionalProperties": false,
      "properties": {
        "channels": {
          "maximum": 32,
          "minimum": 1,
          "title": "Channels",
          "type": "integer"
        },
        "duration_seconds": {
          "exclusiveMinimum": 0.0,
          "title": "Duration Seconds",
          "type": "number"
        },
        "encoding": {
          "enum": [
            "pcm_s16le",
            "pcm_s24le",
            "pcm_s32le"
          ],
          "title": "Encoding",
          "type": "string"
        },
        "frames": {
          "minimum": 1,
          "title": "Frames",
          "type": "integer"
        },
        "sample_rate_hz": {
          "maximum": 384000,
          "minimum": 8000,
          "title": "Sample Rate Hz",
          "type": "integer"
        },
        "sample_width_bytes": {
          "enum": [
            2,
            3,
            4
          ],
          "title": "Sample Width Bytes",
          "type": "integer"
        }
      },
      "required": [
        "sample_rate_hz",
        "channels",
        "sample_width_bytes",
        "encoding",
        "frames",
        "duration_seconds"
      ],
      "title": "AudioSpec",
      "type": "object"
    },
    "CaptureDevice": {
      "additionalProperties": false,
      "properties": {
        "backend": {
          "default": "avfoundation",
          "enum": [
            "avfoundation",
            "coreaudio",
            "portaudio"
          ],
          "title": "Backend",
          "type": "string"
        },
        "calibration_sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/Sha256"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "device_id": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Device Id",
          "type": "string"
        },
        "display_name": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Display Name",
          "type": "string"
        },
        "microphone_serial": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Microphone Serial"
        }
      },
      "required": [
        "device_id",
        "display_name"
      ],
      "title": "CaptureDevice",
      "type": "object"
    },
    "MeasurementSegment": {
      "additionalProperties": false,
      "description": "One segment of a UMIK-1 measurement session as it was recorded (its take in the\npackage is ``path``). Values the session did not record are null.",
      "properties": {
        "clipped_samples": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Clipped Samples"
        },
        "duration_seconds": {
          "anyOf": [
            {
              "$ref": "#/$defs/_Finite"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "input_overflows": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Overflows"
        },
        "key": {
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
          "title": "Key",
          "type": "string"
        },
        "label": {
          "anyOf": [
            {
              "$ref": "#/$defs/_MeasurementText"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "mode": {
          "anyOf": [
            {
              "maxLength": 32,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mode"
        },
        "path": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "peak_dbfs": {
          "anyOf": [
            {
              "$ref": "#/$defs/_Finite"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "rms_dbfs": {
          "anyOf": [
            {
              "$ref": "#/$defs/_Finite"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "started_at": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Started At"
        }
      },
      "required": [
        "key",
        "path"
      ],
      "title": "MeasurementSegment",
      "type": "object"
    },
    "MeasurementSession": {
      "additionalProperties": false,
      "description": "What a UMIK-1 measurement session recorded about itself beyond its audio\n(``journey.measurement_package``): the mouth-to-capsule distance, the input level and\nhow it was pinned, the calibration file, the client, and each segment's label, start,\nduration and levels. Absolute levels and spectra are comparable across sessions only at\nthe same distance and level, so these travel with the takes.",
      "properties": {
        "calibration_file": {
          "anyOf": [
            {
              "$ref": "#/$defs/_MeasurementText"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "client": {
          "anyOf": [
            {
              "$ref": "#/$defs/_MeasurementText"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "controlled": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Controlled"
        },
        "distance_cm": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 10000,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Distance Cm"
        },
        "input_level_control": {
          "anyOf": [
            {
              "$ref": "#/$defs/_MeasurementText"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "input_level_muted": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Level Muted"
        },
        "input_level_source": {
          "anyOf": [
            {
              "$ref": "#/$defs/_MeasurementText"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "input_volume": {
          "anyOf": [
            {
              "$ref": "#/$defs/_Finite"
            },
            {
              "type": "null"
            }
          ]
        },
        "level_pinned_at": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Level Pinned At"
        },
        "schema_version": {
          "const": "cole-voice-lab.measurement-session/v1",
          "default": "cole-voice-lab.measurement-session/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "segments": {
          "default": [],
          "items": {
            "$ref": "#/$defs/MeasurementSegment"
          },
          "title": "Segments",
          "type": "array"
        },
        "source_session_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Source Session Id",
          "type": "string"
        }
      },
      "required": [
        "source_session_id",
        "distance_cm",
        "input_volume"
      ],
      "title": "MeasurementSession",
      "type": "object"
    },
    "Sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "StableId": {
      "maxLength": 128,
      "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?$",
      "type": "string"
    },
    "_Finite": {
      "maximum": 1000000,
      "minimum": -1000000,
      "type": "number"
    },
    "_MeasurementText": {
      "maxLength": 500,
      "minLength": 1,
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "capture_device": {
      "$ref": "#/$defs/CaptureDevice"
    },
    "capture_host": {
      "maxLength": 255,
      "minLength": 1,
      "title": "Capture Host",
      "type": "string"
    },
    "captured_at": {
      "format": "date-time",
      "title": "Captured At",
      "type": "string"
    },
    "files": {
      "items": {
        "$ref": "#/$defs/AudioFileEvidence"
      },
      "minItems": 1,
      "title": "Files",
      "type": "array"
    },
    "finalized_at": {
      "format": "date-time",
      "title": "Finalized At",
      "type": "string"
    },
    "intended_format": {
      "const": "mono-48000-pcm-s24le",
      "default": "mono-48000-pcm-s24le",
      "title": "Intended Format",
      "type": "string"
    },
    "measurement": {
      "anyOf": [
        {
          "$ref": "#/$defs/MeasurementSession"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "processing_applied": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Processing Applied",
      "type": "array"
    },
    "prompt_suite_id": {
      "$ref": "#/$defs/StableId"
    },
    "schema_version": {
      "const": "cole-voice-lab.capture-manifest/v1",
      "default": "cole-voice-lab.capture-manifest/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "session_id": {
      "$ref": "#/$defs/StableId"
    },
    "subject_id": {
      "$ref": "#/$defs/StableId"
    }
  },
  "required": [
    "session_id",
    "subject_id",
    "prompt_suite_id",
    "capture_host",
    "captured_at",
    "finalized_at",
    "capture_device",
    "files"
  ],
  "title": "CaptureManifest",
  "type": "object"
}
