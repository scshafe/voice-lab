{
  "$defs": {
    "BlobRef": {
      "additionalProperties": false,
      "description": "One stored blob, named by the SHA-256 and size of the bytes the store keeps.",
      "properties": {
        "sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "size": {
          "maximum": 16777216,
          "minimum": 0,
          "title": "Size",
          "type": "integer"
        }
      },
      "required": [
        "sha256",
        "size"
      ],
      "title": "BlobRef",
      "type": "object"
    },
    "FileClass": {
      "enum": [
        "records",
        "prompt-database",
        "recordings",
        "derived-edits",
        "training"
      ],
      "type": "string"
    },
    "ManifestEntryKind": {
      "enum": [
        "file",
        "pin"
      ],
      "type": "string"
    },
    "PinSource": {
      "maxLength": 256,
      "pattern": "^[a-z][a-z0-9_-]{0,63}(?:\\.[a-z][a-z0-9_-]{0,63}){0,7}$",
      "type": "string"
    },
    "RelativePath": {
      "maxLength": 1024,
      "minLength": 1,
      "type": "string"
    },
    "Sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "StorageCounter": {
      "maximum": 9223372036854775807,
      "minimum": 0,
      "type": "integer"
    }
  },
  "additionalProperties": false,
  "description": "One file of a stored library generation: its planned entry plus its chunk refs.\n\nEvery ``PlannedManifestEntry`` rule applies. ``chunks`` are the refs of the file's stored\npieces, in order: a ``file`` entry has them exactly when ``size`` is above 0, and a\n``pin`` entry has none.",
  "properties": {
    "chunks": {
      "items": {
        "$ref": "#/$defs/BlobRef"
      },
      "title": "Chunks",
      "type": "array"
    },
    "file_class": {
      "$ref": "#/$defs/FileClass"
    },
    "kind": {
      "$ref": "#/$defs/ManifestEntryKind"
    },
    "mode": {
      "enum": [
        256,
        384
      ],
      "title": "Mode",
      "type": "integer"
    },
    "path": {
      "$ref": "#/$defs/RelativePath"
    },
    "pin_source": {
      "anyOf": [
        {
          "$ref": "#/$defs/PinSource"
        },
        {
          "type": "null"
        }
      ]
    },
    "sha256": {
      "$ref": "#/$defs/Sha256"
    },
    "size": {
      "$ref": "#/$defs/StorageCounter"
    }
  },
  "required": [
    "path",
    "file_class",
    "kind",
    "sha256",
    "size",
    "mode",
    "pin_source",
    "chunks"
  ],
  "title": "ManifestEntry",
  "type": "object"
}
