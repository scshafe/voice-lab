{
  "$defs": {
    "RecordingBuildIdentity": {
      "additionalProperties": false,
      "description": "Exact executable, source-tree and environment identities; mutable tags are insufficient.",
      "properties": {
        "build_id": {
          "$ref": "#/$defs/StableId"
        },
        "environment_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "executable_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "source_sha256": {
          "$ref": "#/$defs/Sha256"
        }
      },
      "required": [
        "build_id",
        "source_sha256",
        "executable_sha256",
        "environment_sha256"
      ],
      "title": "RecordingBuildIdentity",
      "type": "object"
    },
    "Sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "StableId": {
      "maxLength": 128,
      "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?$",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "build": {
      "$ref": "#/$defs/RecordingBuildIdentity"
    },
    "generation": {
      "$ref": "#/$defs/StableId"
    },
    "kind": {
      "const": "hello",
      "default": "hello",
      "title": "Kind",
      "type": "string"
    },
    "schema_version": {
      "const": "cole-voice-lab.recording-analysis-worker/v1",
      "default": "cole-voice-lab.recording-analysis-worker/v1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "generation",
    "build"
  ],
  "title": "AnalysisWorkerHello",
  "type": "object"
}
