{
  "$defs": {
    "AcceptedUtteranceBinding": {
      "additionalProperties": false,
      "description": "Immutable coordinates for one utterance in the accepted raw store.",
      "properties": {
        "audio": {
          "$ref": "#/$defs/AudioSpec"
        },
        "prompt_id": {
          "$ref": "#/$defs/StableId"
        },
        "prompt_suite_id": {
          "$ref": "#/$defs/StableId"
        },
        "raw_audio_path": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Raw Audio Path",
          "type": "string"
        },
        "raw_audio_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "raw_audio_size_bytes": {
          "exclusiveMinimum": 0,
          "title": "Raw Audio Size Bytes",
          "type": "integer"
        },
        "raw_manifest_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "raw_session_path": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Raw Session Path",
          "type": "string"
        },
        "session_id": {
          "$ref": "#/$defs/StableId"
        },
        "source_qc_passed": {
          "const": true,
          "default": true,
          "title": "Source Qc Passed",
          "type": "boolean"
        },
        "source_qc_report_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "subject_id": {
          "$ref": "#/$defs/StableId"
        },
        "transcript": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Transcript",
          "type": "string"
        }
      },
      "required": [
        "raw_session_path",
        "raw_manifest_sha256",
        "raw_audio_path",
        "raw_audio_sha256",
        "raw_audio_size_bytes",
        "audio",
        "session_id",
        "subject_id",
        "prompt_suite_id",
        "prompt_id",
        "transcript",
        "source_qc_report_sha256"
      ],
      "title": "AcceptedUtteranceBinding",
      "type": "object"
    },
    "AudioSpec": {
      "additionalProperties": false,
      "properties": {
        "channels": {
          "maximum": 32,
          "minimum": 1,
          "title": "Channels",
          "type": "integer"
        },
        "duration_seconds": {
          "exclusiveMinimum": 0.0,
          "title": "Duration Seconds",
          "type": "number"
        },
        "encoding": {
          "enum": [
            "pcm_s16le",
            "pcm_s24le",
            "pcm_s32le"
          ],
          "title": "Encoding",
          "type": "string"
        },
        "frames": {
          "minimum": 1,
          "title": "Frames",
          "type": "integer"
        },
        "sample_rate_hz": {
          "maximum": 384000,
          "minimum": 8000,
          "title": "Sample Rate Hz",
          "type": "integer"
        },
        "sample_width_bytes": {
          "enum": [
            2,
            3,
            4
          ],
          "title": "Sample Width Bytes",
          "type": "integer"
        }
      },
      "required": [
        "sample_rate_hz",
        "channels",
        "sample_width_bytes",
        "encoding",
        "frames",
        "duration_seconds"
      ],
      "title": "AudioSpec",
      "type": "object"
    },
    "BoundHeadphoneReview": {
      "additionalProperties": false,
      "properties": {
        "file": {
          "$ref": "#/$defs/JsonEvidenceBinding"
        },
        "record": {
          "$ref": "#/$defs/HeadphoneReviewEvidence"
        }
      },
      "required": [
        "file",
        "record"
      ],
      "title": "BoundHeadphoneReview",
      "type": "object"
    },
    "ConsentEvidenceBinding": {
      "additionalProperties": false,
      "description": "A retired consent record's binding (D-050): only manifests written before carry one.",
      "properties": {
        "consent_id": {
          "$ref": "#/$defs/StableId"
        },
        "file": {
          "$ref": "#/$defs/JsonEvidenceBinding"
        },
        "purpose": {
          "enum": [
            "private-zero-shot-evaluation",
            "private-fine-tuning"
          ],
          "title": "Purpose",
          "type": "string"
        }
      },
      "required": [
        "file",
        "consent_id",
        "purpose"
      ],
      "title": "ConsentEvidenceBinding",
      "type": "object"
    },
    "HeadphoneReviewEvidence": {
      "additionalProperties": false,
      "description": "A human-authored pass for one exact accepted utterance.",
      "properties": {
        "audio_quality_passed": {
          "const": true,
          "title": "Audio Quality Passed",
          "type": "boolean"
        },
        "findings": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Findings",
          "type": "array"
        },
        "headphones_used": {
          "const": true,
          "title": "Headphones Used",
          "type": "boolean"
        },
        "prompt_id": {
          "$ref": "#/$defs/StableId"
        },
        "review_id": {
          "$ref": "#/$defs/StableId"
        },
        "reviewed_at": {
          "format": "date-time",
          "title": "Reviewed At",
          "type": "string"
        },
        "reviewer_id": {
          "$ref": "#/$defs/StableId"
        },
        "schema_version": {
          "const": "cole-voice-lab.headphone-review/v1",
          "default": "cole-voice-lab.headphone-review/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "session_id": {
          "$ref": "#/$defs/StableId"
        },
        "source_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "transcript_matches": {
          "const": true,
          "title": "Transcript Matches",
          "type": "boolean"
        }
      },
      "required": [
        "review_id",
        "reviewer_id",
        "session_id",
        "prompt_id",
        "source_sha256",
        "reviewed_at",
        "headphones_used",
        "transcript_matches",
        "audio_quality_passed"
      ],
      "title": "HeadphoneReviewEvidence",
      "type": "object"
    },
    "JsonEvidenceBinding": {
      "additionalProperties": false,
      "description": "An exact, asset-root-relative canonical JSON file.",
      "properties": {
        "path": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "size_bytes": {
          "exclusiveMinimum": 0,
          "maximum": 1048576,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ],
      "title": "JsonEvidenceBinding",
      "type": "object"
    },
    "ReferenceFileBinding": {
      "additionalProperties": false,
      "properties": {
        "audio": {
          "$ref": "#/$defs/AudioSpec"
        },
        "media_type": {
          "const": "audio/wav",
          "default": "audio/wav",
          "title": "Media Type",
          "type": "string"
        },
        "path": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "size_bytes": {
          "exclusiveMinimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "size_bytes",
        "audio"
      ],
      "title": "ReferenceFileBinding",
      "type": "object"
    },
    "Sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "StableId": {
      "maxLength": 128,
      "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?$",
      "type": "string"
    },
    "cole_voice_lab__references__NonBlank__1": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "cole_voice_lab__references__NonBlank__2": {
      "maxLength": 4096,
      "minLength": 1,
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "consent": {
      "anyOf": [
        {
          "$ref": "#/$defs/ConsentEvidenceBinding"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "created_by": {
      "$ref": "#/$defs/cole_voice_lab__references__NonBlank__1"
    },
    "headphone_review": {
      "$ref": "#/$defs/BoundHeadphoneReview"
    },
    "output": {
      "$ref": "#/$defs/ReferenceFileBinding"
    },
    "provenance_statement": {
      "$ref": "#/$defs/cole_voice_lab__references__NonBlank__2"
    },
    "purpose": {
      "const": "private-zero-shot-evaluation",
      "default": "private-zero-shot-evaluation",
      "title": "Purpose",
      "type": "string"
    },
    "reference_id": {
      "$ref": "#/$defs/StableId"
    },
    "schema_version": {
      "const": "cole-voice-lab.reference-manifest/v1",
      "default": "cole-voice-lab.reference-manifest/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/AcceptedUtteranceBinding"
    },
    "transformation": {
      "const": "none-byte-for-byte-copy",
      "default": "none-byte-for-byte-copy",
      "title": "Transformation",
      "type": "string"
    }
  },
  "required": [
    "reference_id",
    "created_at",
    "created_by",
    "source",
    "output",
    "headphone_review",
    "provenance_statement"
  ],
  "title": "ReferenceManifest",
  "type": "object"
}
