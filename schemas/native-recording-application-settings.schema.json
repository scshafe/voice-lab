{
  "$defs": {
    "CaptureDevice": {
      "additionalProperties": false,
      "properties": {
        "backend": {
          "default": "avfoundation",
          "enum": [
            "avfoundation",
            "coreaudio"
          ],
          "title": "Backend",
          "type": "string"
        },
        "calibration_sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/Sha256"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "device_id": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Device Id",
          "type": "string"
        },
        "display_name": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Display Name",
          "type": "string"
        },
        "microphone_serial": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Microphone Serial"
        }
      },
      "required": [
        "device_id",
        "display_name"
      ],
      "title": "CaptureDevice",
      "type": "object"
    },
    "Sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "StableId": {
      "maxLength": 128,
      "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?$",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Operator settings for one native preview build.\n\n``purpose`` is the purpose of the catalog this build is meant to record; it has no\ndefault, so a physical-test build says so explicitly. It guards the build's asset root\nonly: at runtime the purpose that counts is that of the catalog the service pins from\nthe corpus store. ``finetune_runtime_root`` is the F5-TTS virtual environment the app's\nfine-tune jobs run in (an absolute, normalized path); without it fine-tuning is\nunavailable. The build passes it to the service as ``--finetune-runtime-root``.",
  "properties": {
    "asset_root": {
      "maxLength": 4096,
      "minLength": 1,
      "title": "Asset Root",
      "type": "string"
    },
    "capture_device": {
      "$ref": "#/$defs/CaptureDevice"
    },
    "capture_host": {
      "maxLength": 255,
      "minLength": 1,
      "title": "Capture Host",
      "type": "string"
    },
    "finetune_runtime_root": {
      "anyOf": [
        {
          "maxLength": 4096,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Finetune Runtime Root"
    },
    "pilot_approval_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Pilot Approval Path"
    },
    "pilot_approval_sha256": {
      "anyOf": [
        {
          "$ref": "#/$defs/Sha256"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "purpose": {
      "enum": [
        "capture-pilot",
        "capture-corpus",
        "held-out-evaluation",
        "physical-test"
      ],
      "title": "Purpose",
      "type": "string"
    },
    "schema_version": {
      "const": "cole-voice-lab.native-application-settings/v2",
      "default": "cole-voice-lab.native-application-settings/v2",
      "title": "Schema Version",
      "type": "string"
    },
    "subject_id": {
      "$ref": "#/$defs/StableId"
    }
  },
  "required": [
    "asset_root",
    "purpose",
    "subject_id",
    "capture_device",
    "capture_host"
  ],
  "title": "NativeRecordingApplicationSettings",
  "type": "object"
}
