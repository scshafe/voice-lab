{
  "$defs": {
    "CaptureDevice": {
      "additionalProperties": false,
      "properties": {
        "backend": {
          "default": "avfoundation",
          "enum": [
            "avfoundation",
            "coreaudio",
            "portaudio"
          ],
          "title": "Backend",
          "type": "string"
        },
        "calibration_sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/Sha256"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "device_id": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Device Id",
          "type": "string"
        },
        "display_name": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Display Name",
          "type": "string"
        },
        "microphone_serial": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Microphone Serial"
        }
      },
      "required": [
        "device_id",
        "display_name"
      ],
      "title": "CaptureDevice",
      "type": "object"
    },
    "CatalogReference": {
      "additionalProperties": false,
      "description": "A published catalog version by id, version, exact suite digest and snapshot digest.\n\n``catalog_sha256`` is the canonical digest of the suite alone (the digest every take\nand coverage projection keys on); ``snapshot_sha256`` is the sha256 of the exact\nsnapshot file bytes, so the alias half of the file is pinned too. ``suite_id`` and\n``purpose`` repeat what the snapshot's suite declares so contract-level checks (purpose\nagainst the capture gate) need no file read; the store verifies all of them against the\nsnapshot whenever a reference is materialized.",
      "properties": {
        "catalog_id": {
          "$ref": "#/$defs/StableId"
        },
        "catalog_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "catalog_version": {
          "$ref": "#/$defs/PositiveRevision"
        },
        "purpose": {
          "enum": [
            "capture-pilot",
            "capture-corpus",
            "held-out-evaluation",
            "physical-test"
          ],
          "title": "Purpose",
          "type": "string"
        },
        "snapshot_path": {
          "$ref": "#/$defs/RelativePath"
        },
        "snapshot_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "suite_id": {
          "$ref": "#/$defs/StableId"
        }
      },
      "required": [
        "catalog_id",
        "catalog_version",
        "catalog_sha256",
        "snapshot_sha256",
        "suite_id",
        "purpose",
        "snapshot_path"
      ],
      "title": "CatalogReference",
      "type": "object"
    },
    "ContinueLegacyRecordingCommand": {
      "additionalProperties": false,
      "description": "Continue an unfinished desktop session in a new native context.\n\n``context`` always embeds the session's frozen catalog and digest (the one place the\nembedded open-context form remains): a desktop session binds a catalog no corpus-store\nversion holds, and its sidecar evidence must match that catalog exactly.",
      "properties": {
        "command": {
          "const": "continue-legacy-recording",
          "default": "continue-legacy-recording",
          "title": "Command",
          "type": "string"
        },
        "context": {
          "$ref": "#/$defs/OpenContextCommand"
        },
        "operation_id": {
          "$ref": "#/$defs/StableId"
        },
        "session_evidence_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "session_id": {
          "$ref": "#/$defs/StableId"
        }
      },
      "required": [
        "operation_id",
        "session_id",
        "session_evidence_sha256",
        "context"
      ],
      "title": "ContinueLegacyRecordingCommand",
      "type": "object"
    },
    "DesktopSessionEvidence": {
      "additionalProperties": false,
      "description": "Private provenance sidecar, deliberately outside transferable packages.",
      "properties": {
        "capture_device": {
          "$ref": "#/$defs/CaptureDevice"
        },
        "capture_host": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Capture Host",
          "type": "string"
        },
        "catalog_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "catalog_suite": {
          "$ref": "#/$defs/PromptSuite"
        },
        "manifest_sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/Sha256"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "schema_version": {
          "const": "cole-voice-lab.capture-desktop-session/v1",
          "default": "cole-voice-lab.capture-desktop-session/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "selected_suite": {
          "$ref": "#/$defs/PromptSuite"
        },
        "session_id": {
          "$ref": "#/$defs/StableId"
        },
        "session_started_at": {
          "format": "date-time",
          "title": "Session Started At",
          "type": "string"
        },
        "subject_id": {
          "$ref": "#/$defs/StableId"
        },
        "takes": {
          "default": [],
          "items": {
            "$ref": "#/$defs/DesktopTakeEvidence"
          },
          "title": "Takes",
          "type": "array"
        }
      },
      "required": [
        "session_id",
        "subject_id",
        "catalog_suite",
        "catalog_sha256",
        "selected_suite",
        "session_started_at",
        "capture_device",
        "capture_host"
      ],
      "title": "DesktopSessionEvidence",
      "type": "object"
    },
    "DesktopTakeEvidence": {
      "additionalProperties": false,
      "description": "Take-start event, committed before opening the microphone.",
      "properties": {
        "accepted": {
          "default": false,
          "title": "Accepted",
          "type": "boolean"
        },
        "audio_sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/Sha256"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "capture_device": {
          "$ref": "#/$defs/CaptureDevice"
        },
        "prompt_id": {
          "$ref": "#/$defs/StableId"
        },
        "rejected": {
          "default": false,
          "title": "Rejected",
          "type": "boolean"
        },
        "take_started_at": {
          "format": "date-time",
          "title": "Take Started At",
          "type": "string"
        }
      },
      "required": [
        "prompt_id",
        "take_started_at",
        "capture_device"
      ],
      "title": "DesktopTakeEvidence",
      "type": "object"
    },
    "OpenContextCommand": {
      "additionalProperties": false,
      "description": "Open (or reuse) the native capture context of one subject on one catalog.\n\nThe app names the catalog its ``CatalogEvent`` delivered by ``catalog_reference``; the\nservice opens only the catalog it pinned for this process. The embedded form\n(``catalog`` plus ``catalog_sha256``) is legacy continuation only: it survives inside\n``ContinueLegacyRecordingCommand``, which binds a desktop session's frozen catalog that no\ncorpus-store version holds, and the service refuses it as a top-level command. Exactly\none form is present; absent fields are omitted, so an embedded command serializes (and\nreplays) byte-identically to the contract before the corpus store.",
      "properties": {
        "capture_device": {
          "$ref": "#/$defs/CaptureDevice"
        },
        "capture_host": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Capture Host",
          "type": "string"
        },
        "catalog": {
          "anyOf": [
            {
              "$ref": "#/$defs/PromptSuite"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "catalog_reference": {
          "anyOf": [
            {
              "$ref": "#/$defs/CatalogReference"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "catalog_sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/Sha256"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "command": {
          "const": "open-context",
          "default": "open-context",
          "title": "Command",
          "type": "string"
        },
        "expected_selection_revision": {
          "anyOf": [
            {
              "$ref": "#/$defs/Revision"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "new_setup": {
          "default": false,
          "title": "New Setup",
          "type": "boolean"
        },
        "operation_id": {
          "$ref": "#/$defs/StableId"
        },
        "pilot_approval_path": {
          "anyOf": [
            {
              "$ref": "#/$defs/RelativePath"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "pilot_approval_sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/Sha256"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "setup_description": {
          "default": "",
          "maxLength": 1024,
          "title": "Setup Description",
          "type": "string"
        },
        "subject_id": {
          "$ref": "#/$defs/StableId"
        }
      },
      "required": [
        "operation_id",
        "subject_id",
        "capture_device",
        "capture_host"
      ],
      "title": "OpenContextCommand",
      "type": "object"
    },
    "PositiveRevision": {
      "maximum": 9223372036854775807,
      "minimum": 1,
      "type": "integer"
    },
    "Prompt": {
      "additionalProperties": false,
      "description": "One catalog entry. Optional v2 fields are omitted when absent so v1 bytes never change.",
      "properties": {
        "category": {
          "enum": [
            "room-tone",
            "neutral",
            "conversational",
            "warm-narration",
            "technical",
            "numbers",
            "expressive",
            "reference",
            "procedure"
          ],
          "title": "Category",
          "type": "string"
        },
        "expected_seconds": {
          "exclusiveMinimum": 0.0,
          "maximum": 120.0,
          "title": "Expected Seconds",
          "type": "number"
        },
        "holdout": {
          "default": false,
          "title": "Holdout",
          "type": "boolean"
        },
        "instructions": {
          "anyOf": [
            {
              "maxLength": 2000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Instructions"
        },
        "labels": {
          "default": [],
          "items": {
            "$ref": "#/$defs/PromptLabel"
          },
          "maxItems": 8,
          "title": "Labels",
          "type": "array"
        },
        "prompt_id": {
          "$ref": "#/$defs/StableId"
        },
        "reference_candidate": {
          "default": false,
          "title": "Reference Candidate",
          "type": "boolean"
        },
        "style": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Style",
          "type": "string"
        },
        "text": {
          "anyOf": [
            {
              "maxLength": 2000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text"
        }
      },
      "required": [
        "prompt_id",
        "category",
        "style",
        "expected_seconds"
      ],
      "title": "Prompt",
      "type": "object"
    },
    "PromptLabel": {
      "maxLength": 32,
      "minLength": 2,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "type": "string"
    },
    "PromptSuite": {
      "additionalProperties": false,
      "properties": {
        "prompts": {
          "items": {
            "$ref": "#/$defs/Prompt"
          },
          "minItems": 1,
          "title": "Prompts",
          "type": "array"
        },
        "purpose": {
          "enum": [
            "capture-pilot",
            "capture-corpus",
            "held-out-evaluation",
            "physical-test"
          ],
          "title": "Purpose",
          "type": "string"
        },
        "schema_version": {
          "default": "cole-voice-lab.prompt-suite/v1",
          "enum": [
            "cole-voice-lab.prompt-suite/v1",
            "cole-voice-lab.prompt-suite/v2"
          ],
          "title": "Schema Version",
          "type": "string"
        },
        "suite_id": {
          "$ref": "#/$defs/StableId"
        }
      },
      "required": [
        "suite_id",
        "purpose",
        "prompts"
      ],
      "title": "PromptSuite",
      "type": "object"
    },
    "RelativePath": {
      "maxLength": 1024,
      "minLength": 1,
      "type": "string"
    },
    "Revision": {
      "maximum": 9223372036854775807,
      "minimum": 0,
      "type": "integer"
    },
    "Sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "StableId": {
      "maxLength": 128,
      "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?$",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "command": {
      "$ref": "#/$defs/ContinueLegacyRecordingCommand"
    },
    "original_evidence": {
      "$ref": "#/$defs/DesktopSessionEvidence"
    },
    "schema_version": {
      "const": "cole-voice-lab.recording-legacy-continuation/v1",
      "default": "cole-voice-lab.recording-legacy-continuation/v1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "command",
    "original_evidence"
  ],
  "title": "RecordingLegacyContinuation",
  "type": "object"
}
