        },
        "details": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "title": "Details",
          "type": "array"
        },
        "message": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "title": "RecordingError",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "error": {
      "$ref": "#/$defs/RecordingError"
    },
    "kind": {
      "const": "unknown",
      "default": "unknown",
      "title": "Kind",
      "type": "string"
    },
    "record_id": {
      "maxLength": 1024,
      "minLength": 1,
      "title": "Record Id",
      "type": "string"
    }
  },
  "required": [
    "record_id",
    "error"
  ],
  "title": "LegacyProjectionUnknown",
  "type": "object"
}
