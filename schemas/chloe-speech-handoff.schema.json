{
  "$defs": {
    "ChloeSpeechClearanceExport": {
      "additionalProperties": false,
      "properties": {
        "allowed_purposes": {
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "title": "Allowed Purposes",
          "type": "array"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/ChloeSpeechEvidenceExport"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "review_by": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Review By"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "scope": {
          "$ref": "#/$defs/cole_voice_lab__promotion__NonBlank__2"
        },
        "status": {
          "const": "approved",
          "default": "approved",
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "allowed_purposes",
        "scope",
        "evidence"
      ],
      "title": "ChloeSpeechClearanceExport",
      "type": "object"
    },
    "ChloeSpeechDeliveryExport": {
      "additionalProperties": false,
      "properties": {
        "pitch_semitones": {
          "default": 0.0,
          "maximum": 0.0,
          "minimum": 0.0,
          "title": "Pitch Semitones",
          "type": "number"
        },
        "provider_options": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Provider Options",
          "type": "object"
        },
        "rate": {
          "default": 1.0,
          "maximum": 1.0,
          "minimum": 1.0,
          "title": "Rate",
          "type": "number"
        },
        "style": {
          "default": null,
          "title": "Style",
          "type": "null"
        },
        "style_strength": {
          "default": null,
          "title": "Style Strength",
          "type": "null"
        },
        "volume_db": {
          "default": 0.0,
          "maximum": 0.0,
          "minimum": 0.0,
          "title": "Volume Db",
          "type": "number"
        }
      },
      "title": "ChloeSpeechDeliveryExport",
      "type": "object"
    },
    "ChloeSpeechDisclosureCueExport": {
      "additionalProperties": false,
      "description": "An actual public Cue-shaped segment, not merely a disclosure promise.",
      "properties": {
        "delivery": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Delivery",
          "type": "object"
        },
        "id": {
          "$ref": "#/$defs/StableId"
        },
        "pause_after_ms": {
          "maximum": 60000,
          "minimum": 0,
          "title": "Pause After Ms",
          "type": "integer"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "speaker_id": {
          "$ref": "#/$defs/StableId"
        },
        "text": {
          "$ref": "#/$defs/cole_voice_lab__promotion__NonBlank__4"
        },
        "voice_id": {
          "$ref": "#/$defs/StableId"
        }
      },
      "required": [
        "id",
        "speaker_id",
        "text",
        "voice_id",
        "pause_after_ms"
      ],
      "title": "ChloeSpeechDisclosureCueExport",
      "type": "object"
    },
    "ChloeSpeechDisclosureExport": {
      "additionalProperties": false,
      "properties": {
        "persistent": {
          "$ref": "#/$defs/cole_voice_lab__promotion__NonBlank__2"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "spoken": {
          "$ref": "#/$defs/cole_voice_lab__promotion__NonBlank__2"
        }
      },
      "required": [
        "spoken",
        "persistent"
      ],
      "title": "ChloeSpeechDisclosureExport",
      "type": "object"
    },
    "ChloeSpeechEvidenceExport": {
      "additionalProperties": false,
      "properties": {
        "details": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Details",
          "type": "object"
        },
        "kind": {
          "$ref": "#/$defs/StableId"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "uri": {
          "default": null,
          "title": "Uri",
          "type": "null"
        }
      },
      "required": [
        "kind",
        "path",
        "sha256"
      ],
      "title": "ChloeSpeechEvidenceExport",
      "type": "object"
    },
    "ChloeSpeechEvidenceIndexEntry": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "#/$defs/StableId"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "$ref": "#/$defs/Sha256"
        }
      },
      "required": [
        "kind",
        "path",
        "sha256"
      ],
      "title": "ChloeSpeechEvidenceIndexEntry",
      "type": "object"
    },
    "ChloeSpeechLicenseExport": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/$defs/cole_voice_lab__promotion__NonBlank__3"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "spdx_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Spdx Id"
        },
        "uri": {
          "anyOf": [
            {
              "maxLength": 2048,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Uri"
        }
      },
      "required": [
        "name"
      ],
      "title": "ChloeSpeechLicenseExport",
      "type": "object"
    },
    "ChloeSpeechModelExport": {
      "additionalProperties": false,
      "properties": {
        "artifacts": {
          "default": [],
          "maxItems": 0,
          "minItems": 0,
          "title": "Artifacts",
          "type": "array"
        },
        "id": {
          "$ref": "#/$defs/cole_voice_lab__promotion__NonBlank__1"
        },
        "revision": {
          "$ref": "#/$defs/cole_voice_lab__promotion__NonBlank__1"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "revision"
      ],
      "title": "ChloeSpeechModelExport",
      "type": "object"
    },
    "ChloeSpeechProvenanceExport": {
      "additionalProperties": false,
      "properties": {
        "clearance": {
          "$ref": "#/$defs/ChloeSpeechClearanceExport"
        },
        "created_by": {
          "$ref": "#/$defs/cole_voice_lab__promotion__NonBlank__3"
        },
        "disclosure": {
          "$ref": "#/$defs/ChloeSpeechDisclosureExport"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "source_kind": {
          "const": "human_recording",
          "default": "human_recording",
          "title": "Source Kind",
          "type": "string"
        }
      },
      "required": [
        "created_by",
        "clearance",
        "disclosure"
      ],
      "title": "ChloeSpeechProvenanceExport",
      "type": "object"
    },
    "ChloeSpeechReferenceAudioExport": {
      "additionalProperties": false,
      "properties": {
        "human_subject": {
          "const": true,
          "default": true,
          "title": "Human Subject",
          "type": "boolean"
        },
        "media_type": {
          "const": "audio/wav",
          "default": "audio/wav",
          "title": "Media Type",
          "type": "string"
        },
        "origin_voice_id": {
          "default": null,
          "title": "Origin Voice Id",
          "type": "null"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "provenance_path": {
          "title": "Provenance Path",
          "type": "string"
        },
        "provenance_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "size_bytes": {
          "exclusiveMinimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "subject_id": {
          "$ref": "#/$defs/StableId"
        }
      },
      "required": [
        "path",
        "sha256",
        "size_bytes",
        "subject_id",
        "provenance_path",
        "provenance_sha256"
      ],
      "title": "ChloeSpeechReferenceAudioExport",
      "type": "object"
    },
    "ChloeSpeechSubjectExport": {
      "additionalProperties": false,
      "properties": {
        "display_name": {
          "default": null,
          "title": "Display Name",
          "type": "null"
        },
        "id": {
          "$ref": "#/$defs/StableId"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "id"
      ],
      "title": "ChloeSpeechSubjectExport",
      "type": "object"
    },
    "ChloeSpeechVoiceManifestExport": {
      "additionalProperties": false,
      "properties": {
        "defaults": {
          "$ref": "#/$defs/ChloeSpeechDeliveryExport"
        },
        "id": {
          "$ref": "#/$defs/StableId"
        },
        "identity_kind": {
          "const": "human_authorized",
          "default": "human_authorized",
          "title": "Identity Kind",
          "type": "string"
        },
        "language": {
          "$ref": "#/$defs/LanguageTag"
        },
        "license": {
          "$ref": "#/$defs/ChloeSpeechLicenseExport"
        },
        "model": {
          "$ref": "#/$defs/ChloeSpeechModelExport"
        },
        "name": {
          "$ref": "#/$defs/cole_voice_lab__promotion__NonBlank__3"
        },
        "provenance": {
          "$ref": "#/$defs/ChloeSpeechProvenanceExport"
        },
        "provider_id": {
          "$ref": "#/$defs/ProviderId"
        },
        "provider_settings": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Provider Settings",
          "type": "object"
        },
        "provider_voice": {
          "$ref": "#/$defs/cole_voice_lab__promotion__NonBlank__1"
        },
        "recognizable_human": {
          "const": true,
          "default": true,
          "title": "Recognizable Human",
          "type": "boolean"
        },
        "reference_audio": {
          "$ref": "#/$defs/ChloeSpeechReferenceAudioExport"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "subject": {
          "$ref": "#/$defs/ChloeSpeechSubjectExport"
        },
        "watermarked": {
          "title": "Watermarked",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "name",
        "provider_id",
        "provider_voice",
        "model",
        "language",
        "subject",
        "license",
        "provenance",
        "reference_audio",
        "watermarked"
      ],
      "title": "ChloeSpeechVoiceManifestExport",
      "type": "object"
    },
    "JsonValue": {},
    "LanguageTag": {
      "maxLength": 64,
      "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$",
      "type": "string"
    },
    "ProviderId": {
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "type": "string"
    },
    "Sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "StableId": {
      "maxLength": 128,
      "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?$",
      "type": "string"
    },
    "cole_voice_lab__promotion__NonBlank__1": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "cole_voice_lab__promotion__NonBlank__2": {
      "maxLength": 4096,
      "minLength": 1,
      "type": "string"
    },
    "cole_voice_lab__promotion__NonBlank__3": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "cole_voice_lab__promotion__NonBlank__4": {
      "maxLength": 1000000,
      "minLength": 1,
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "JSON-ready, public-contract-shaped data for an explicit consumer import.",
  "properties": {
    "asset_paths_are_relative_to_caller_root": {
      "const": true,
      "default": true,
      "title": "Asset Paths Are Relative To Caller Root",
      "type": "boolean"
    },
    "copies_assets": {
      "const": false,
      "default": false,
      "title": "Copies Assets",
      "type": "boolean"
    },
    "lab_evidence": {
      "items": {
        "$ref": "#/$defs/ChloeSpeechEvidenceIndexEntry"
      },
      "minItems": 1,
      "title": "Lab Evidence",
      "type": "array"
    },
    "mutates_consumer": {
      "const": false,
      "default": false,
      "title": "Mutates Consumer",
      "type": "boolean"
    },
    "promotion_id": {
      "$ref": "#/$defs/StableId"
    },
    "promotion_sha256": {
      "$ref": "#/$defs/Sha256"
    },
    "purpose": {
      "const": "private-chloe-speech-rendering",
      "default": "private-chloe-speech-rendering",
      "title": "Purpose",
      "type": "string"
    },
    "required_disclosure_cues": {
      "items": {
        "$ref": "#/$defs/ChloeSpeechDisclosureCueExport"
      },
      "minItems": 1,
      "title": "Required Disclosure Cues",
      "type": "array"
    },
    "schema_version": {
      "const": "cole-voice-lab.chloespeech-handoff/v1",
      "default": "cole-voice-lab.chloespeech-handoff/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "voice_manifest": {
      "$ref": "#/$defs/ChloeSpeechVoiceManifestExport"
    }
  },
  "required": [
    "promotion_id",
    "promotion_sha256",
    "voice_manifest",
    "required_disclosure_cues",
    "lab_evidence"
  ],
  "title": "ChloeSpeechHandoff",
  "type": "object"
}
