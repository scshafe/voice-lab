{
  "$defs": {
    "CatalogReference": {
      "additionalProperties": false,
      "description": "A published catalog version by id, version, exact suite digest and snapshot digest.\n\n``catalog_sha256`` is the canonical digest of the suite alone (the digest every take\nand coverage projection keys on); ``snapshot_sha256`` is the sha256 of the exact\nsnapshot file bytes, so the alias half of the file is pinned too. ``suite_id`` and\n``purpose`` repeat what the snapshot's suite declares so contract-level checks (purpose\nagainst the capture gate) need no file read; the store verifies all of them against the\nsnapshot whenever a reference is materialized.",
      "properties": {
        "catalog_id": {
          "$ref": "#/$defs/StableId"
        },
        "catalog_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "catalog_version": {
          "$ref": "#/$defs/PositiveRevision"
        },
        "purpose": {
          "enum": [
            "capture-pilot",
            "capture-corpus",
            "held-out-evaluation",
            "physical-test"
          ],
          "title": "Purpose",
          "type": "string"
        },
        "snapshot_path": {
          "$ref": "#/$defs/RelativePath"
        },
        "snapshot_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "suite_id": {
          "$ref": "#/$defs/StableId"
        }
      },
      "required": [
        "catalog_id",
        "catalog_version",
        "catalog_sha256",
        "snapshot_sha256",
        "suite_id",
        "purpose",
        "snapshot_path"
      ],
      "title": "CatalogReference",
      "type": "object"
    },
    "FineTuneCorpusEntry": {
      "additionalProperties": false,
      "description": "One spoken prompt's current recording: the latest retained take and where its audio is.\n\n``prompt`` is the current catalog prompt (its text is the training transcript) and\n``prompt_sha256`` its digest. ``recorded_prompt_sha256`` is the digest the audio was\nrecorded against: equal to ``prompt_sha256`` unless the take counts through a\nkeep-recordings alias of the current prompt. Writers must always state it; ``None`` only\nappears in a stored entry written before the field existed (omitted again on output, so\nthat corpus keeps its exact bytes and digest).",
      "properties": {
        "date_precision": {
          "$ref": "#/$defs/FineTuneDatePrecision"
        },
        "frame_range": {
          "anyOf": [
            {
              "$ref": "#/$defs/RecordingFrameRange"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "prompt": {
          "$ref": "#/$defs/Prompt"
        },
        "prompt_id": {
          "$ref": "#/$defs/StableId"
        },
        "prompt_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "recorded_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/UtcTimestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "recorded_prompt_sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/Sha256"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "source_frames": {
          "minimum": 1,
          "title": "Source Frames",
          "type": "integer"
        },
        "source_kind": {
          "$ref": "#/$defs/FineTuneSourceKind"
        },
        "source_path": {
          "$ref": "#/$defs/RelativePath"
        },
        "source_sample_rate_hz": {
          "maximum": 384000,
          "minimum": 8000,
          "title": "Source Sample Rate Hz",
          "type": "integer"
        },
        "source_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "take_id": {
          "$ref": "#/$defs/StableId"
        }
      },
      "required": [
        "prompt_id",
        "prompt_sha256",
        "prompt",
        "take_id",
        "source_kind",
        "source_path",
        "source_sha256",
        "source_frames",
        "source_sample_rate_hz",
        "recorded_at",
        "date_precision"
      ],
      "title": "FineTuneCorpusEntry",
      "type": "object"
    },
    "FineTuneDatePrecision": {
      "enum": [
        "take",
        "session",
        "unknown"
      ],
      "type": "string"
    },
    "FineTuneSourceKind": {
      "enum": [
        "native",
        "legacy"
      ],
      "type": "string"
    },
    "FrameCount": {
      "maximum": 28800000,
      "minimum": 0,
      "type": "integer"
    },
    "PositiveRevision": {
      "maximum": 9223372036854775807,
      "minimum": 1,
      "type": "integer"
    },
    "Prompt": {
      "additionalProperties": false,
      "description": "One catalog entry. Optional v2 fields are omitted when absent so v1 bytes never change.",
      "properties": {
        "category": {
          "enum": [
            "room-tone",
            "neutral",
            "conversational",
            "warm-narration",
            "technical",
            "numbers",
            "expressive",
            "reference",
            "procedure"
          ],
          "title": "Category",
          "type": "string"
        },
        "expected_seconds": {
          "exclusiveMinimum": 0.0,
          "maximum": 120.0,
          "title": "Expected Seconds",
          "type": "number"
        },
        "holdout": {
          "default": false,
          "title": "Holdout",
          "type": "boolean"
        },
        "instructions": {
          "anyOf": [
            {
              "maxLength": 2000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Instructions"
        },
        "labels": {
          "default": [],
          "items": {
            "$ref": "#/$defs/PromptLabel"
          },
          "maxItems": 8,
          "title": "Labels",
          "type": "array"
        },
        "prompt_id": {
          "$ref": "#/$defs/StableId"
        },
        "reference_candidate": {
          "default": false,
          "title": "Reference Candidate",
          "type": "boolean"
        },
        "style": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Style",
          "type": "string"
        },
        "text": {
          "anyOf": [
            {
              "maxLength": 2000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text"
        }
      },
      "required": [
        "prompt_id",
        "category",
        "style",
        "expected_seconds"
      ],
      "title": "Prompt",
      "type": "object"
    },
    "PromptLabel": {
      "maxLength": 32,
      "minLength": 2,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "type": "string"
    },
    "RecordingFrameRange": {
      "additionalProperties": false,
      "description": "Source-frame recipe, independent from eventual derivative rendering.",
      "properties": {
        "end_frame": {
          "maximum": 28800000,
          "minimum": 1,
          "title": "End Frame",
          "type": "integer"
        },
        "source_frames": {
          "maximum": 28800000,
          "minimum": 1,
          "title": "Source Frames",
          "type": "integer"
        },
        "start_frame": {
          "$ref": "#/$defs/FrameCount"
        }
      },
      "required": [
        "source_frames",
        "start_frame",
        "end_frame"
      ],
      "title": "RecordingFrameRange",
      "type": "object"
    },
    "RelativePath": {
      "maxLength": 1024,
      "minLength": 1,
      "type": "string"
    },
    "Sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "StableId": {
      "maxLength": 128,
      "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?$",
      "type": "string"
    },
    "UtcTimestamp": {
      "format": "date-time",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "The live corpus for one subject and catalog: one entry per spoken prompt, catalog order.\n\n``catalog_reference`` names the published corpus-store catalog version the corpus was\nselected from; it is absent for a built-in catalog.",
  "properties": {
    "catalog_reference": {
      "anyOf": [
        {
          "$ref": "#/$defs/CatalogReference"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "catalog_sha256": {
      "$ref": "#/$defs/Sha256"
    },
    "catalog_suite_id": {
      "$ref": "#/$defs/StableId"
    },
    "entries": {
      "items": {
        "$ref": "#/$defs/FineTuneCorpusEntry"
      },
      "maxItems": 10000,
      "title": "Entries",
      "type": "array"
    },
    "missing_prompt_ids": {
      "items": {
        "$ref": "#/$defs/StableId"
      },
      "maxItems": 10000,
      "title": "Missing Prompt Ids",
      "type": "array"
    },
    "schema_version": {
      "const": "cole-voice-lab.finetune-corpus/v1",
      "default": "cole-voice-lab.finetune-corpus/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "selected_at": {
      "$ref": "#/$defs/UtcTimestamp"
    },
    "subject_id": {
      "$ref": "#/$defs/StableId"
    },
    "unknown_record_ids": {
      "items": {
        "type": "string"
      },
      "maxItems": 10000,
      "title": "Unknown Record Ids",
      "type": "array"
    }
  },
  "required": [
    "subject_id",
    "catalog_suite_id",
    "catalog_sha256",
    "entries",
    "missing_prompt_ids",
    "unknown_record_ids",
    "selected_at"
  ],
  "title": "FineTuneCorpus",
  "type": "object"
}
