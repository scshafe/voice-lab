{
  "$defs": {
    "AbsolutePath": {
      "maxLength": 4096,
      "minLength": 1,
      "type": "string"
    },
    "FineTunePinnedFile": {
      "additionalProperties": false,
      "description": "One pinned runtime file: its exact size and SHA-256.",
      "properties": {
        "sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "size_bytes": {
          "minimum": 1,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "sha256",
        "size_bytes"
      ],
      "title": "FineTunePinnedFile",
      "type": "object"
    },
    "FineTunePretrainedPins": {
      "additionalProperties": false,
      "description": "The pretrained files a runtime must hold, each pinned by size and SHA-256.\n\n``weights`` is ``pretrained/F5TTS_v1_Base/model_1250000.safetensors``;\n``vocoder_config`` and ``vocoder_model`` are ``pretrained/vocos-mel-24khz/config.yaml``\nand ``pytorch_model.bin``. Only tests substitute them (a stub runtime's few-byte files).",
      "properties": {
        "vocoder_config": {
          "$ref": "#/$defs/FineTunePinnedFile"
        },
        "vocoder_model": {
          "$ref": "#/$defs/FineTunePinnedFile"
        },
        "weights": {
          "$ref": "#/$defs/FineTunePinnedFile"
        }
      },
      "required": [
        "weights",
        "vocoder_config",
        "vocoder_model"
      ],
      "title": "FineTunePretrainedPins",
      "type": "object"
    },
    "Sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "StableId": {
      "maxLength": 128,
      "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?$",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "generation": {
      "$ref": "#/$defs/StableId"
    },
    "kind": {
      "const": "run",
      "default": "run",
      "title": "Kind",
      "type": "string"
    },
    "operation_id": {
      "$ref": "#/$defs/StableId"
    },
    "pretrained_pin": {
      "anyOf": [
        {
          "$ref": "#/$defs/FineTunePretrainedPins"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "request_sha256": {
      "$ref": "#/$defs/Sha256"
    },
    "run_id": {
      "$ref": "#/$defs/StableId"
    },
    "runtime_root": {
      "$ref": "#/$defs/AbsolutePath"
    },
    "schema_version": {
      "const": "cole-voice-lab.finetune-worker/v1",
      "default": "cole-voice-lab.finetune-worker/v1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "generation",
    "operation_id",
    "request_sha256",
    "run_id",
    "runtime_root"
  ],
  "title": "FineTuneWorkerRequest",
  "type": "object"
}
