{
  "$defs": {
    "Sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "StableId": {
      "maxLength": 128,
      "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?$",
      "type": "string"
    },
    "cole_voice_lab__promotion__NonBlank__1": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "cole_voice_lab__promotion__NonBlank__2": {
      "maxLength": 4096,
      "minLength": 1,
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Strict contents expected in the separately stored provenance document.",
  "properties": {
    "consent_evidence_sha256": {
      "$ref": "#/$defs/Sha256"
    },
    "consent_id": {
      "$ref": "#/$defs/StableId"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "created_by": {
      "$ref": "#/$defs/cole_voice_lab__promotion__NonBlank__1"
    },
    "human_subject": {
      "const": true,
      "default": true,
      "title": "Human Subject",
      "type": "boolean"
    },
    "provenance_id": {
      "$ref": "#/$defs/StableId"
    },
    "purpose": {
      "const": "private-chloe-speech-rendering",
      "default": "private-chloe-speech-rendering",
      "title": "Purpose",
      "type": "string"
    },
    "recognizable_human": {
      "const": true,
      "default": true,
      "title": "Recognizable Human",
      "type": "boolean"
    },
    "reference_path": {
      "maxLength": 4096,
      "minLength": 1,
      "title": "Reference Path",
      "type": "string"
    },
    "reference_sha256": {
      "$ref": "#/$defs/Sha256"
    },
    "schema_version": {
      "const": "cole-voice-lab.human-reference-provenance/v1",
      "default": "cole-voice-lab.human-reference-provenance/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "statement": {
      "$ref": "#/$defs/cole_voice_lab__promotion__NonBlank__2"
    },
    "subject_id": {
      "$ref": "#/$defs/StableId"
    }
  },
  "required": [
    "provenance_id",
    "subject_id",
    "reference_path",
    "reference_sha256",
    "consent_id",
    "consent_evidence_sha256",
    "created_at",
    "created_by",
    "statement"
  ],
  "title": "HumanReferenceProvenanceRecord",
  "type": "object"
}
