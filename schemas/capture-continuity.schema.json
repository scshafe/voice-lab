{
  "$defs": {
    "Sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Successful native input continuity bound to one exact, privately saved WAV.",
  "properties": {
    "backend": {
      "const": "coreaudio-audioqueue",
      "title": "Backend",
      "type": "string"
    },
    "callback_count": {
      "exclusiveMinimum": 0,
      "title": "Callback Count",
      "type": "integer"
    },
    "continuity_checked": {
      "title": "Continuity Checked",
      "type": "boolean"
    },
    "device_uid": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Device Uid",
      "type": "string"
    },
    "first_sample_time": {
      "title": "First Sample Time",
      "type": "number"
    },
    "frames": {
      "exclusiveMinimum": 0,
      "title": "Frames",
      "type": "integer"
    },
    "last_sample_end": {
      "title": "Last Sample End",
      "type": "number"
    },
    "output_name": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Output Name",
      "type": "string"
    },
    "received_frames": {
      "exclusiveMinimum": 0,
      "title": "Received Frames",
      "type": "integer"
    },
    "schema_version": {
      "const": "cole-voice-lab.capture-continuity/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "stop_reason": {
      "enum": [
        "requested",
        "maximum-duration"
      ],
      "title": "Stop Reason",
      "type": "string"
    },
    "success": {
      "title": "Success",
      "type": "boolean"
    },
    "wav_sha256": {
      "$ref": "#/$defs/Sha256"
    },
    "wav_size_bytes": {
      "exclusiveMinimum": 0,
      "title": "Wav Size Bytes",
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "backend",
    "device_uid",
    "output_name",
    "wav_sha256",
    "wav_size_bytes",
    "frames",
    "received_frames",
    "callback_count",
    "first_sample_time",
    "last_sample_end",
    "success",
    "continuity_checked",
    "stop_reason"
  ],
  "title": "CaptureContinuityEvidence",
  "type": "object"
}
