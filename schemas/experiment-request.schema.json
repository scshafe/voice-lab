{
  "$defs": {
    "CandidateId": {
      "maxLength": 80,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "type": "string"
    },
    "JsonValue": {},
    "ReferenceEvidence": {
      "additionalProperties": false,
      "properties": {
        "consent_path": {
          "anyOf": [
            {
              "maxLength": 1024,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Consent Path"
        },
        "consent_sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/Sha256"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "path": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "subject_id": {
          "$ref": "#/$defs/StableId"
        },
        "transcript": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Transcript",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256",
        "transcript",
        "subject_id"
      ],
      "title": "ReferenceEvidence",
      "type": "object"
    },
    "Sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "StableId": {
      "maxLength": 128,
      "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?$",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "candidate_id": {
      "$ref": "#/$defs/CandidateId"
    },
    "code_revision": {
      "pattern": "^[0-9a-f]{40,64}$",
      "title": "Code Revision",
      "type": "string"
    },
    "experiment_id": {
      "$ref": "#/$defs/StableId"
    },
    "language": {
      "default": "en",
      "maxLength": 64,
      "minLength": 2,
      "title": "Language",
      "type": "string"
    },
    "model_id": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Model Id",
      "type": "string"
    },
    "model_revision": {
      "pattern": "^[0-9a-f]{40,64}$",
      "title": "Model Revision",
      "type": "string"
    },
    "output_path": {
      "maxLength": 4096,
      "minLength": 1,
      "title": "Output Path",
      "type": "string"
    },
    "reference": {
      "$ref": "#/$defs/ReferenceEvidence"
    },
    "schema_version": {
      "const": "cole-voice-lab.worker-request/v1",
      "default": "cole-voice-lab.worker-request/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "seed": {
      "default": 0,
      "maximum": 9223372036854775807,
      "minimum": 0,
      "title": "Seed",
      "type": "integer"
    },
    "settings": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Settings",
      "type": "object"
    },
    "source_audio_path": {
      "anyOf": [
        {
          "maxLength": 4096,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Audio Path"
    },
    "source_audio_sha256": {
      "anyOf": [
        {
          "$ref": "#/$defs/Sha256"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "source_audio_size_bytes": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Audio Size Bytes"
    },
    "text": {
      "maxLength": 20000,
      "minLength": 1,
      "title": "Text",
      "type": "string"
    },
    "track": {
      "enum": [
        "direct-tts",
        "voice-conversion"
      ],
      "title": "Track",
      "type": "string"
    },
    "trial_id": {
      "$ref": "#/$defs/StableId"
    }
  },
  "required": [
    "experiment_id",
    "trial_id",
    "candidate_id",
    "track",
    "text",
    "output_path",
    "reference",
    "model_id",
    "model_revision",
    "code_revision"
  ],
  "title": "ExperimentRequest",
  "type": "object"
}
