{
  "$defs": {
    "FrameCount": {
      "maximum": 28800000,
      "minimum": 0,
      "type": "integer"
    },
    "PositiveRevision": {
      "maximum": 9223372036854775807,
      "minimum": 1,
      "type": "integer"
    },
    "RecordingFileIdentity": {
      "additionalProperties": false,
      "description": "Prepared authorization identity, including ctime to detect preserved-mtime changes.",
      "properties": {
        "ctime_ns": {
          "maximum": 9223372036854775807,
          "minimum": -9223372036854775808,
          "title": "Ctime Ns",
          "type": "integer"
        },
        "device": {
          "$ref": "#/$defs/Revision"
        },
        "inode": {
          "$ref": "#/$defs/Revision"
        },
        "mode": {
          "maximum": 4294967295,
          "minimum": 0,
          "title": "Mode",
          "type": "integer"
        },
        "mtime_ns": {
          "maximum": 9223372036854775807,
          "minimum": -9223372036854775808,
          "title": "Mtime Ns",
          "type": "integer"
        },
        "relative_path": {
          "$ref": "#/$defs/RelativePath"
        },
        "size_bytes": {
          "$ref": "#/$defs/Revision"
        }
      },
      "required": [
        "relative_path",
        "device",
        "inode",
        "size_bytes",
        "mode",
        "mtime_ns",
        "ctime_ns"
      ],
      "title": "RecordingFileIdentity",
      "type": "object"
    },
    "RecordingFrameRange": {
      "additionalProperties": false,
      "description": "Source-frame recipe, independent from eventual derivative rendering.",
      "properties": {
        "end_frame": {
          "maximum": 28800000,
          "minimum": 1,
          "title": "End Frame",
          "type": "integer"
        },
        "source_frames": {
          "maximum": 28800000,
          "minimum": 1,
          "title": "Source Frames",
          "type": "integer"
        },
        "start_frame": {
          "$ref": "#/$defs/FrameCount"
        }
      },
      "required": [
        "source_frames",
        "start_frame",
        "end_frame"
      ],
      "title": "RecordingFrameRange",
      "type": "object"
    },
    "RelativePath": {
      "maxLength": 1024,
      "minLength": 1,
      "type": "string"
    },
    "Revision": {
      "maximum": 9223372036854775807,
      "minimum": 0,
      "type": "integer"
    },
    "Sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "StableId": {
      "maxLength": 128,
      "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?$",
      "type": "string"
    },
    "UtcTimestamp": {
      "format": "date-time",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "completed_at": {
      "$ref": "#/$defs/UtcTimestamp"
    },
    "derived_path": {
      "title": "Derived Path",
      "type": "string"
    },
    "derived_sha256": {
      "$ref": "#/$defs/Sha256"
    },
    "derived_size_bytes": {
      "exclusiveMinimum": 44,
      "title": "Derived Size Bytes",
      "type": "integer"
    },
    "edit_revision": {
      "$ref": "#/$defs/PositiveRevision"
    },
    "frame_range": {
      "$ref": "#/$defs/RecordingFrameRange"
    },
    "recipe_sha256": {
      "$ref": "#/$defs/Sha256"
    },
    "schema_version": {
      "const": "cole-voice-lab.recording-edit-derivative/v1",
      "default": "cole-voice-lab.recording-edit-derivative/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "source_identity": {
      "$ref": "#/$defs/RecordingFileIdentity"
    },
    "source_sha256": {
      "$ref": "#/$defs/Sha256"
    },
    "take_id": {
      "$ref": "#/$defs/StableId"
    }
  },
  "required": [
    "recipe_sha256",
    "take_id",
    "source_sha256",
    "edit_revision",
    "frame_range",
    "source_identity",
    "derived_path",
    "derived_sha256",
    "derived_size_bytes",
    "completed_at"
  ],
  "title": "RecordingEditDerivative",
  "type": "object"
}
