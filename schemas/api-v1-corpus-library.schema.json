{
  "$defs": {
    "CatalogReference": {
      "additionalProperties": false,
      "description": "A published catalog version by id, version, exact suite digest and snapshot digest.\n\n``catalog_sha256`` is the canonical digest of the suite alone (the digest every take\nand coverage projection keys on); ``snapshot_sha256`` is the sha256 of the exact\nsnapshot file bytes, so the alias half of the file is pinned too. ``suite_id`` and\n``purpose`` repeat what the snapshot's suite declares so contract-level checks (purpose\nagainst the capture gate) need no file read; the store verifies all of them against the\nsnapshot whenever a reference is materialized.",
      "properties": {
        "catalog_id": {
          "$ref": "#/$defs/StableId"
        },
        "catalog_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "catalog_version": {
          "$ref": "#/$defs/PositiveRevision"
        },
        "purpose": {
          "enum": [
            "capture-pilot",
            "capture-corpus",
            "held-out-evaluation",
            "physical-test"
          ],
          "title": "Purpose",
          "type": "string"
        },
        "snapshot_path": {
          "$ref": "#/$defs/RelativePath"
        },
        "snapshot_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "suite_id": {
          "$ref": "#/$defs/StableId"
        }
      },
      "required": [
        "catalog_id",
        "catalog_version",
        "catalog_sha256",
        "snapshot_sha256",
        "suite_id",
        "purpose",
        "snapshot_path"
      ],
      "title": "CatalogReference",
      "type": "object"
    },
    "LibraryCoverage": {
      "additionalProperties": false,
      "description": "The totals of the rows (``recorded`` is ``kept`` plus ``needs_attention``), and how\nmany takes count for a prompt of this version and how many count for none.",
      "properties": {
        "draft": {
          "minimum": 0,
          "title": "Draft",
          "type": "integer"
        },
        "kept": {
          "minimum": 0,
          "title": "Kept",
          "type": "integer"
        },
        "missing": {
          "minimum": 0,
          "title": "Missing",
          "type": "integer"
        },
        "needs_attention": {
          "minimum": 0,
          "title": "Needs Attention",
          "type": "integer"
        },
        "prompts": {
          "minimum": 0,
          "title": "Prompts",
          "type": "integer"
        },
        "recorded": {
          "minimum": 0,
          "title": "Recorded",
          "type": "integer"
        },
        "takes": {
          "minimum": 0,
          "title": "Takes",
          "type": "integer"
        },
        "uncounted_takes": {
          "minimum": 0,
          "title": "Uncounted Takes",
          "type": "integer"
        }
      },
      "required": [
        "prompts",
        "recorded",
        "kept",
        "needs_attention",
        "draft",
        "missing",
        "takes",
        "uncounted_takes"
      ],
      "title": "LibraryCoverage",
      "type": "object"
    },
    "LibraryRow": {
      "additionalProperties": false,
      "description": "One prompt of the active catalog version, in catalog order, and where it stands.\n\n``latest_*`` describe the take that stands for the prompt: its newest kept take, else\nits newest undecided one; ``take_count`` counts its whole history.",
      "properties": {
        "category": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Category",
          "type": "string"
        },
        "holdout": {
          "title": "Holdout",
          "type": "boolean"
        },
        "labels": {
          "items": {
            "$ref": "#/$defs/PromptLabel"
          },
          "title": "Labels",
          "type": "array"
        },
        "latest_duration_seconds": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Latest Duration Seconds"
        },
        "latest_requested_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Latest Requested At"
        },
        "latest_take_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/TakeId"
            },
            {
              "type": "null"
            }
          ]
        },
        "prompt_id": {
          "$ref": "#/$defs/StableId"
        },
        "prompt_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "status": {
          "$ref": "#/$defs/PromptStatus"
        },
        "take_count": {
          "minimum": 0,
          "title": "Take Count",
          "type": "integer"
        }
      },
      "required": [
        "prompt_id",
        "prompt_sha256",
        "category",
        "labels",
        "holdout",
        "status",
        "take_count",
        "latest_take_id",
        "latest_requested_at",
        "latest_duration_seconds"
      ],
      "title": "LibraryRow",
      "type": "object"
    },
    "PositiveRevision": {
      "maximum": 9223372036854775807,
      "minimum": 1,
      "type": "integer"
    },
    "PromptLabel": {
      "maxLength": 32,
      "minLength": 2,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "type": "string"
    },
    "PromptStatus": {
      "enum": [
        "missing",
        "draft",
        "kept",
        "needs-attention"
      ],
      "type": "string"
    },
    "RelativePath": {
      "maxLength": 1024,
      "minLength": 1,
      "type": "string"
    },
    "Sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "StableId": {
      "maxLength": 128,
      "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?$",
      "type": "string"
    },
    "TakeId": {
      "pattern": "^take-[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "``GET /api/v1/corpus/library``: the subject's library of the active catalog version.\n\n``rows`` are the version's prompts in catalog order, each with its status\n(``missing``/``draft``/``kept``/``needs-attention``), its take count and the take that\nstands for it; ``coverage`` totals them. The answer's ``ETag`` is the read model's digest\n(``corpus_read_model``), which changes exactly when any row or history does.",
  "properties": {
    "catalog": {
      "$ref": "#/$defs/CatalogReference"
    },
    "coverage": {
      "$ref": "#/$defs/LibraryCoverage"
    },
    "rows": {
      "items": {
        "$ref": "#/$defs/LibraryRow"
      },
      "title": "Rows",
      "type": "array"
    },
    "schema_version": {
      "const": "cole-voice-lab.api.corpus-library/v1",
      "default": "cole-voice-lab.api.corpus-library/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "subject_id": {
      "$ref": "#/$defs/StableId"
    }
  },
  "required": [
    "subject_id",
    "catalog",
    "coverage",
    "rows"
  ],
  "title": "CorpusLibrary",
  "type": "object"
}
