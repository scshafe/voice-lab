{
  "$defs": {
    "ErrorCode": {
      "enum": [
        "RECORDING.INVALID_MESSAGE",
        "RECORDING.VERSION_MISMATCH",
        "RECORDING.BUILD_MISMATCH",
        "RECORDING.STALE_REVISION",
        "RECORDING.STALE_GENERATION",
        "RECORDING.OWNERSHIP_CONFLICT",
        "RECORDING.INVALID_TRANSITION",
        "RECORDING.DEVICE_UNAVAILABLE",
        "RECORDING.PERMISSION_DENIED",
        "RECORDING.PLAYBACK_ACTIVE",
        "RECORDING.DISK_SPACE",
        "RECORDING.WRITE_FAILED",
        "RECORDING.WAVEFORM_CACHE_UNAVAILABLE",
        "RECORDING.CONTINUITY_FAILED",
        "RECORDING.CAPTURE_OVERFLOW",
        "RECORDING.PARENT_LOST",
        "RECORDING.SOURCE_CHANGED",
        "RECORDING.HISTORY_UNKNOWN",
        "RECORDING.GATE_NOT_READY",
        "RECORDING.ANALYSIS_FAILED",
        "RECORDING.PLAYBACK_FAILED",
        "RECORDING.EDIT_FAILED",
        "RECORDING.PACKAGE_INCOMPLETE",
        "RECORDING.CANCELLED",
        "CORPUS.NO_ACTIVE_CATALOG",
        "CORPUS.CATALOG_UNKNOWN",
        "CORPUS.SNAPSHOT_MISMATCH",
        "CORPUS.STORE_MISSING"
      ],
      "type": "string"
    },
    "RecordingError": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "details": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "title": "Details",
          "type": "array"
        },
        "message": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "title": "RecordingError",
      "type": "object"
    },
    "RecordingPackageJob": {
      "additionalProperties": false,
      "properties": {
        "attempt": {
          "default": 0,
          "maximum": 3,
          "minimum": 0,
          "title": "Attempt",
          "type": "integer"
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/RecordingError"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "group_id": {
          "$ref": "#/$defs/StableId"
        },
        "manifest_sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/Sha256"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "operation_id": {
          "$ref": "#/$defs/StableId"
        },
        "queued_at": {
          "$ref": "#/$defs/UtcTimestamp"
        },
        "request_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "state": {
          "default": "queued",
          "enum": [
            "queued",
            "running",
            "prepared",
            "blocked",
            "failed"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "operation_id",
        "group_id",
        "request_sha256",
        "queued_at"
      ],
      "title": "RecordingPackageJob",
      "type": "object"
    },
    "Sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "StableId": {
      "maxLength": 128,
      "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?$",
      "type": "string"
    },
    "UtcTimestamp": {
      "format": "date-time",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "jobs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/RecordingPackageJob"
      },
      "maxItems": 16,
      "title": "Jobs",
      "type": "array"
    },
    "schema_version": {
      "const": "cole-voice-lab.recording-package-queue/v1",
      "default": "cole-voice-lab.recording-package-queue/v1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "title": "RecordingPackageQueueHead",
  "type": "object"
}
