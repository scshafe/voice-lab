{
  "$defs": {
    "FrameCount": {
      "maximum": 28800000,
      "minimum": 0,
      "type": "integer"
    },
    "Prompt": {
      "additionalProperties": false,
      "description": "One catalog entry. Optional v2 fields are omitted when absent so v1 bytes never change.",
      "properties": {
        "category": {
          "enum": [
            "room-tone",
            "neutral",
            "conversational",
            "warm-narration",
            "technical",
            "numbers",
            "expressive",
            "reference",
            "procedure"
          ],
          "title": "Category",
          "type": "string"
        },
        "expected_seconds": {
          "exclusiveMinimum": 0.0,
          "maximum": 120.0,
          "title": "Expected Seconds",
          "type": "number"
        },
        "holdout": {
          "default": false,
          "title": "Holdout",
          "type": "boolean"
        },
        "instructions": {
          "anyOf": [
            {
              "maxLength": 2000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Instructions"
        },
        "labels": {
          "default": [],
          "items": {
            "$ref": "#/$defs/PromptLabel"
          },
          "maxItems": 8,
          "title": "Labels",
          "type": "array"
        },
        "prompt_id": {
          "$ref": "#/$defs/StableId"
        },
        "reference_candidate": {
          "default": false,
          "title": "Reference Candidate",
          "type": "boolean"
        },
        "style": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Style",
          "type": "string"
        },
        "text": {
          "anyOf": [
            {
              "maxLength": 2000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text"
        }
      },
      "required": [
        "prompt_id",
        "category",
        "style",
        "expected_seconds"
      ],
      "title": "Prompt",
      "type": "object"
    },
    "PromptLabel": {
      "maxLength": 32,
      "minLength": 2,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "type": "string"
    },
    "RecordingFrameRange": {
      "additionalProperties": false,
      "description": "Source-frame recipe, independent from eventual derivative rendering.",
      "properties": {
        "end_frame": {
          "maximum": 28800000,
          "minimum": 1,
          "title": "End Frame",
          "type": "integer"
        },
        "source_frames": {
          "maximum": 28800000,
          "minimum": 1,
          "title": "Source Frames",
          "type": "integer"
        },
        "start_frame": {
          "$ref": "#/$defs/FrameCount"
        }
      },
      "required": [
        "source_frames",
        "start_frame",
        "end_frame"
      ],
      "title": "RecordingFrameRange",
      "type": "object"
    },
    "RecordingPackageEntry": {
      "additionalProperties": false,
      "properties": {
        "analysis_sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/Sha256"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "catalog_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "decision_revision": {
          "anyOf": [
            {
              "$ref": "#/$defs/Revision"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "edit_identity_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "edit_revision": {
          "anyOf": [
            {
              "$ref": "#/$defs/Revision"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "frame_range": {
          "anyOf": [
            {
              "$ref": "#/$defs/RecordingFrameRange"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "group_id": {
          "$ref": "#/$defs/StableId"
        },
        "original_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "package_relative_path": {
          "$ref": "#/$defs/RelativePath"
        },
        "prompt": {
          "$ref": "#/$defs/Prompt"
        },
        "recorded_at": {
          "$ref": "#/$defs/UtcTimestamp"
        },
        "subject_id": {
          "$ref": "#/$defs/StableId"
        },
        "take_id": {
          "$ref": "#/$defs/StableId"
        }
      },
      "required": [
        "take_id",
        "group_id",
        "subject_id",
        "catalog_sha256",
        "prompt",
        "package_relative_path",
        "original_sha256",
        "recorded_at",
        "edit_identity_sha256"
      ],
      "title": "RecordingPackageEntry",
      "type": "object"
    },
    "RelativePath": {
      "maxLength": 1024,
      "minLength": 1,
      "type": "string"
    },
    "Revision": {
      "maximum": 9223372036854775807,
      "minimum": 0,
      "type": "integer"
    },
    "Sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "StableId": {
      "maxLength": 128,
      "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?$",
      "type": "string"
    },
    "UtcTimestamp": {
      "format": "date-time",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Committed external package provenance projected into one current take.",
  "properties": {
    "entry": {
      "$ref": "#/$defs/RecordingPackageEntry"
    },
    "manifest_sha256": {
      "$ref": "#/$defs/Sha256"
    },
    "package_map_sha256": {
      "$ref": "#/$defs/Sha256"
    },
    "session_id": {
      "$ref": "#/$defs/StableId"
    }
  },
  "required": [
    "session_id",
    "manifest_sha256",
    "package_map_sha256",
    "entry"
  ],
  "title": "RecordingPackagePublication",
  "type": "object"
}
