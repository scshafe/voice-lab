{
  "$defs": {
    "FrameCount": {
      "maximum": 28800000,
      "minimum": 0,
      "type": "integer"
    },
    "RecordingFileIdentity": {
      "additionalProperties": false,
      "description": "Prepared authorization identity, including ctime to detect preserved-mtime changes.",
      "properties": {
        "ctime_ns": {
          "maximum": 9223372036854775807,
          "minimum": -9223372036854775808,
          "title": "Ctime Ns",
          "type": "integer"
        },
        "device": {
          "$ref": "#/$defs/Revision"
        },
        "inode": {
          "$ref": "#/$defs/Revision"
        },
        "mode": {
          "maximum": 4294967295,
          "minimum": 0,
          "title": "Mode",
          "type": "integer"
        },
        "mtime_ns": {
          "maximum": 9223372036854775807,
          "minimum": -9223372036854775808,
          "title": "Mtime Ns",
          "type": "integer"
        },
        "relative_path": {
          "$ref": "#/$defs/RelativePath"
        },
        "size_bytes": {
          "$ref": "#/$defs/Revision"
        }
      },
      "required": [
        "relative_path",
        "device",
        "inode",
        "size_bytes",
        "mode",
        "mtime_ns",
        "ctime_ns"
      ],
      "title": "RecordingFileIdentity",
      "type": "object"
    },
    "RecordingFrameRange": {
      "additionalProperties": false,
      "description": "Source-frame recipe, independent from eventual derivative rendering.",
      "properties": {
        "end_frame": {
          "maximum": 28800000,
          "minimum": 1,
          "title": "End Frame",
          "type": "integer"
        },
        "source_frames": {
          "maximum": 28800000,
          "minimum": 1,
          "title": "Source Frames",
          "type": "integer"
        },
        "start_frame": {
          "$ref": "#/$defs/FrameCount"
        }
      },
      "required": [
        "source_frames",
        "start_frame",
        "end_frame"
      ],
      "title": "RecordingFrameRange",
      "type": "object"
    },
    "RelativePath": {
      "maxLength": 1024,
      "minLength": 1,
      "type": "string"
    },
    "Revision": {
      "maximum": 9223372036854775807,
      "minimum": 0,
      "type": "integer"
    },
    "Sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "StableId": {
      "maxLength": 128,
      "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?$",
      "type": "string"
    },
    "UtcTimestamp": {
      "format": "date-time",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "analysis_job_sha256": {
      "$ref": "#/$defs/Sha256"
    },
    "analysis_sha256": {
      "$ref": "#/$defs/Sha256"
    },
    "decision_revision": {
      "$ref": "#/$defs/Revision"
    },
    "edit_identity_sha256": {
      "$ref": "#/$defs/Sha256"
    },
    "edit_revision": {
      "$ref": "#/$defs/Revision"
    },
    "frame_range": {
      "$ref": "#/$defs/RecordingFrameRange"
    },
    "original_path": {
      "$ref": "#/$defs/RelativePath"
    },
    "original_sha256": {
      "$ref": "#/$defs/Sha256"
    },
    "original_size_bytes": {
      "exclusiveMinimum": 0,
      "title": "Original Size Bytes",
      "type": "integer"
    },
    "prompt_id": {
      "$ref": "#/$defs/StableId"
    },
    "recorded_at": {
      "$ref": "#/$defs/UtcTimestamp"
    },
    "seal_sha256": {
      "$ref": "#/$defs/Sha256"
    },
    "source_identity": {
      "$ref": "#/$defs/RecordingFileIdentity"
    },
    "take_id": {
      "$ref": "#/$defs/StableId"
    }
  },
  "required": [
    "take_id",
    "original_path",
    "original_sha256",
    "original_size_bytes",
    "seal_sha256",
    "prompt_id",
    "recorded_at",
    "source_identity",
    "decision_revision",
    "edit_revision",
    "frame_range",
    "edit_identity_sha256",
    "analysis_job_sha256",
    "analysis_sha256"
  ],
  "title": "RecordingPackageSource",
  "type": "object"
}
