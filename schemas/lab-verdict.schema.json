{
  "$defs": {
    "BlindId": {
      "pattern": "^sample-[0-9a-f]{16}$",
      "type": "string"
    },
    "CandidateId": {
      "maxLength": 80,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "type": "string"
    },
    "RevealEntry": {
      "additionalProperties": false,
      "properties": {
        "blind_id": {
          "$ref": "#/$defs/BlindId"
        },
        "candidate_id": {
          "$ref": "#/$defs/CandidateId"
        },
        "experiment_id": {
          "$ref": "#/$defs/StableId"
        },
        "output_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "plan_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "prompt_id": {
          "$ref": "#/$defs/StableId"
        },
        "reference_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "request_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "result_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "run_manifest_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "seed": {
          "title": "Seed",
          "type": "integer"
        },
        "source_audio_sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/Sha256"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "timing_mode": {
          "enum": [
            "cold",
            "warm"
          ],
          "title": "Timing Mode",
          "type": "string"
        },
        "track": {
          "enum": [
            "direct-tts",
            "voice-conversion"
          ],
          "title": "Track",
          "type": "string"
        },
        "trial_id": {
          "$ref": "#/$defs/StableId"
        }
      },
      "required": [
        "blind_id",
        "experiment_id",
        "trial_id",
        "candidate_id",
        "track",
        "prompt_id",
        "output_sha256",
        "seed",
        "timing_mode",
        "reference_sha256",
        "request_sha256",
        "plan_sha256",
        "run_manifest_sha256",
        "result_sha256"
      ],
      "title": "RevealEntry",
      "type": "object"
    },
    "Sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "StableId": {
      "maxLength": 128,
      "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?$",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "The blind-review decision that names the sole promotable run.",
  "properties": {
    "approved": {
      "const": true,
      "default": true,
      "title": "Approved",
      "type": "boolean"
    },
    "auxiliary_source_manifest_sha256": {
      "additionalProperties": {
        "$ref": "#/$defs/Sha256"
      },
      "title": "Auxiliary Source Manifest Sha256",
      "type": "object"
    },
    "blind_package_manifest_sha256": {
      "$ref": "#/$defs/Sha256"
    },
    "decided_at": {
      "format": "date-time",
      "title": "Decided At",
      "type": "string"
    },
    "decision": {
      "const": "promote",
      "default": "promote",
      "title": "Decision",
      "type": "string"
    },
    "experiment_id": {
      "$ref": "#/$defs/StableId"
    },
    "listening_summary_evidence_sha256": {
      "$ref": "#/$defs/Sha256"
    },
    "model_lock_evidence_sha256": {
      "$ref": "#/$defs/Sha256"
    },
    "model_source_manifest_sha256": {
      "$ref": "#/$defs/Sha256"
    },
    "reference_sha256": {
      "$ref": "#/$defs/Sha256"
    },
    "review_id": {
      "$ref": "#/$defs/StableId"
    },
    "schema_version": {
      "const": "cole-voice-lab.promotion-verdict/v2",
      "default": "cole-voice-lab.promotion-verdict/v2",
      "title": "Schema Version",
      "type": "string"
    },
    "score_sheet_evidence_sha256": {
      "$ref": "#/$defs/Sha256"
    },
    "selection_policy": {
      "const": "highest-direct-tts-overall-mean-no-ties",
      "default": "highest-direct-tts-overall-mean-no-ties",
      "title": "Selection Policy",
      "type": "string"
    },
    "trial_policy": {
      "const": "explicit-reviewed-winning-candidate-cell",
      "default": "explicit-reviewed-winning-candidate-cell",
      "title": "Trial Policy",
      "type": "string"
    },
    "verdict_id": {
      "$ref": "#/$defs/StableId"
    },
    "winning_candidate_id": {
      "$ref": "#/$defs/CandidateId"
    },
    "winning_reveal_entry": {
      "$ref": "#/$defs/RevealEntry"
    },
    "winning_run_evidence_sha256": {
      "$ref": "#/$defs/Sha256"
    },
    "winning_trial_id": {
      "$ref": "#/$defs/StableId"
    },
    "worker_model_evidence_sha256": {
      "$ref": "#/$defs/Sha256"
    }
  },
  "required": [
    "verdict_id",
    "experiment_id",
    "review_id",
    "winning_candidate_id",
    "winning_trial_id",
    "reference_sha256",
    "winning_run_evidence_sha256",
    "model_lock_evidence_sha256",
    "model_source_manifest_sha256",
    "auxiliary_source_manifest_sha256",
    "worker_model_evidence_sha256",
    "blind_package_manifest_sha256",
    "score_sheet_evidence_sha256",
    "listening_summary_evidence_sha256",
    "winning_reveal_entry",
    "decided_at"
  ],
  "title": "LabVerdictRecord",
  "type": "object"
}
