{
  "$defs": {
    "ErrorCode": {
      "enum": [
        "RECORDING.INVALID_MESSAGE",
        "RECORDING.VERSION_MISMATCH",
        "RECORDING.BUILD_MISMATCH",
        "RECORDING.STALE_REVISION",
        "RECORDING.STALE_GENERATION",
        "RECORDING.OWNERSHIP_CONFLICT",
        "RECORDING.INVALID_TRANSITION",
        "RECORDING.DEVICE_UNAVAILABLE",
        "RECORDING.PERMISSION_DENIED",
        "RECORDING.PLAYBACK_ACTIVE",
        "RECORDING.DISK_SPACE",
        "RECORDING.WRITE_FAILED",
        "RECORDING.WAVEFORM_CACHE_UNAVAILABLE",
        "RECORDING.CONTINUITY_FAILED",
        "RECORDING.CAPTURE_OVERFLOW",
        "RECORDING.PARENT_LOST",
        "RECORDING.SOURCE_CHANGED",
        "RECORDING.HISTORY_UNKNOWN",
        "RECORDING.GATE_NOT_READY",
        "RECORDING.ANALYSIS_FAILED",
        "RECORDING.PLAYBACK_FAILED",
        "RECORDING.EDIT_FAILED",
        "RECORDING.PACKAGE_INCOMPLETE",
        "RECORDING.CANCELLED",
        "CORPUS.NO_ACTIVE_CATALOG",
        "CORPUS.SNAPSHOT_MISMATCH",
        "CORPUS.STORE_MISSING",
        "FINETUNE.CATALOG_HELD_OUT",
        "FINETUNE.CHECKPOINT_MISSING",
        "FINETUNE.CORPUS_INCOMPLETE",
        "FINETUNE.CORPUS_PROJECTION_FAILED",
        "FINETUNE.DOWNLOADS_NOT_ALLOWED",
        "FINETUNE.DOWNLOAD_FAILED",
        "FINETUNE.EMPTY_CORPUS",
        "FINETUNE.FFMPEG_FAILED",
        "FINETUNE.FFMPEG_UNAVAILABLE",
        "FINETUNE.INTERRUPTED",
        "FINETUNE.JOB_ACTIVE",
        "FINETUNE.PRETRAINED_MISMATCH",
        "FINETUNE.REFERENCE_MISSING",
        "FINETUNE.REQUIREMENTS_MISSING",
        "FINETUNE.RUNTIME_FAILED",
        "FINETUNE.RUNTIME_UNAVAILABLE",
        "FINETUNE.RUN_EXISTS",
        "FINETUNE.SOURCE_CHANGED",
        "FINETUNE.TRAINING_FAILED",
        "FINETUNE.UNSUPPORTED_TEXT"
      ],
      "type": "string"
    },
    "FrameCount": {
      "maximum": 28800000,
      "minimum": 0,
      "type": "integer"
    },
    "PositiveRevision": {
      "maximum": 9223372036854775807,
      "minimum": 1,
      "type": "integer"
    },
    "RecordingEdit": {
      "additionalProperties": false,
      "description": "One exact source's effective frame selection and recoverable removal state.",
      "properties": {
        "derived_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Derived Path"
        },
        "derived_sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/Sha256"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "end_frame": {
          "exclusiveMinimum": 0,
          "title": "End Frame",
          "type": "integer"
        },
        "prompt_id": {
          "$ref": "#/$defs/StableId"
        },
        "removal_reason": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Removal Reason"
        },
        "removed": {
          "default": false,
          "title": "Removed",
          "type": "boolean"
        },
        "sample_rate": {
          "const": 48000,
          "default": 48000,
          "title": "Sample Rate",
          "type": "integer"
        },
        "schema_version": {
          "const": "cole-voice-lab.recording-edit/v1",
          "default": "cole-voice-lab.recording-edit/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "session_id": {
          "$ref": "#/$defs/StableId"
        },
        "source_frames": {
          "exclusiveMinimum": 0,
          "title": "Source Frames",
          "type": "integer"
        },
        "source_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "start_frame": {
          "minimum": 0,
          "title": "Start Frame",
          "type": "integer"
        },
        "subject_id": {
          "$ref": "#/$defs/StableId"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        }
      },
      "required": [
        "subject_id",
        "session_id",
        "prompt_id",
        "source_sha256",
        "source_frames",
        "start_frame",
        "end_frame",
        "updated_at"
      ],
      "title": "RecordingEdit",
      "type": "object"
    },
    "RecordingEditDerivative": {
      "additionalProperties": false,
      "properties": {
        "completed_at": {
          "$ref": "#/$defs/UtcTimestamp"
        },
        "derived_path": {
          "title": "Derived Path",
          "type": "string"
        },
        "derived_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "derived_size_bytes": {
          "exclusiveMinimum": 44,
          "title": "Derived Size Bytes",
          "type": "integer"
        },
        "edit_revision": {
          "$ref": "#/$defs/PositiveRevision"
        },
        "frame_range": {
          "$ref": "#/$defs/RecordingFrameRange"
        },
        "recipe_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "schema_version": {
          "const": "cole-voice-lab.recording-edit-derivative/v1",
          "default": "cole-voice-lab.recording-edit-derivative/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "source_identity": {
          "$ref": "#/$defs/RecordingFileIdentity"
        },
        "source_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "take_id": {
          "$ref": "#/$defs/StableId"
        }
      },
      "required": [
        "recipe_sha256",
        "take_id",
        "source_sha256",
        "edit_revision",
        "frame_range",
        "source_identity",
        "derived_path",
        "derived_sha256",
        "derived_size_bytes",
        "completed_at"
      ],
      "title": "RecordingEditDerivative",
      "type": "object"
    },
    "RecordingError": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "details": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "title": "Details",
          "type": "array"
        },
        "message": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "title": "RecordingError",
      "type": "object"
    },
    "RecordingFileIdentity": {
      "additionalProperties": false,
      "description": "Prepared authorization identity, including ctime to detect preserved-mtime changes.",
      "properties": {
        "ctime_ns": {
          "maximum": 9223372036854775807,
          "minimum": -9223372036854775808,
          "title": "Ctime Ns",
          "type": "integer"
        },
        "device": {
          "$ref": "#/$defs/Revision"
        },
        "inode": {
          "$ref": "#/$defs/Revision"
        },
        "mode": {
          "maximum": 4294967295,
          "minimum": 0,
          "title": "Mode",
          "type": "integer"
        },
        "mtime_ns": {
          "maximum": 9223372036854775807,
          "minimum": -9223372036854775808,
          "title": "Mtime Ns",
          "type": "integer"
        },
        "relative_path": {
          "$ref": "#/$defs/RelativePath"
        },
        "size_bytes": {
          "$ref": "#/$defs/Revision"
        }
      },
      "required": [
        "relative_path",
        "device",
        "inode",
        "size_bytes",
        "mode",
        "mtime_ns",
        "ctime_ns"
      ],
      "title": "RecordingFileIdentity",
      "type": "object"
    },
    "RecordingFrameRange": {
      "additionalProperties": false,
      "description": "Source-frame recipe, independent from eventual derivative rendering.",
      "properties": {
        "end_frame": {
          "maximum": 28800000,
          "minimum": 1,
          "title": "End Frame",
          "type": "integer"
        },
        "source_frames": {
          "maximum": 28800000,
          "minimum": 1,
          "title": "Source Frames",
          "type": "integer"
        },
        "start_frame": {
          "$ref": "#/$defs/FrameCount"
        }
      },
      "required": [
        "source_frames",
        "start_frame",
        "end_frame"
      ],
      "title": "RecordingFrameRange",
      "type": "object"
    },
    "RecordingLegacyEditResult": {
      "additionalProperties": false,
      "properties": {
        "edit": {
          "anyOf": [
            {
              "$ref": "#/$defs/RecordingEdit"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/RecordingError"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "intent_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "schema_version": {
          "const": "cole-voice-lab.recording-legacy-edit-result/v1",
          "default": "cole-voice-lab.recording-legacy-edit-result/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "intent_sha256"
      ],
      "title": "RecordingLegacyEditResult",
      "type": "object"
    },
    "RelativePath": {
      "maxLength": 1024,
      "minLength": 1,
      "type": "string"
    },
    "Revision": {
      "maximum": 9223372036854775807,
      "minimum": 0,
      "type": "integer"
    },
    "Sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "StableId": {
      "maxLength": 128,
      "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?$",
      "type": "string"
    },
    "UtcTimestamp": {
      "format": "date-time",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/RecordingError"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "legacy_result": {
      "anyOf": [
        {
          "$ref": "#/$defs/RecordingLegacyEditResult"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "recipe_sha256": {
      "$ref": "#/$defs/Sha256"
    },
    "result": {
      "anyOf": [
        {
          "$ref": "#/$defs/RecordingEditDerivative"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "schema_version": {
      "const": "cole-voice-lab.recording-edit-job-reply/v1",
      "default": "cole-voice-lab.recording-edit-job-reply/v1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "recipe_sha256"
  ],
  "title": "RecordingEditJobReply",
  "type": "object"
}
