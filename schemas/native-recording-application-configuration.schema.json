{
  "$defs": {
    "CaptureDevice": {
      "additionalProperties": false,
      "properties": {
        "backend": {
          "default": "avfoundation",
          "enum": [
            "avfoundation",
            "coreaudio"
          ],
          "title": "Backend",
          "type": "string"
        },
        "calibration_sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/Sha256"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "device_id": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Device Id",
          "type": "string"
        },
        "display_name": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Display Name",
          "type": "string"
        },
        "microphone_serial": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Microphone Serial"
        }
      },
      "required": [
        "device_id",
        "display_name"
      ],
      "title": "CaptureDevice",
      "type": "object"
    },
    "NativeRecordingPeerConfiguration": {
      "additionalProperties": false,
      "properties": {
        "arguments": {
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "title": "Arguments",
          "type": "array"
        },
        "build": {
          "$ref": "#/$defs/RecordingBuildIdentity"
        },
        "build_identity_path": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Build Identity Path",
          "type": "string"
        },
        "environment": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "title": "Environment"
        },
        "executable": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Executable",
          "type": "string"
        }
      },
      "required": [
        "executable",
        "arguments",
        "environment",
        "build",
        "build_identity_path"
      ],
      "title": "NativeRecordingPeerConfiguration",
      "type": "object"
    },
    "RecordingBuildIdentity": {
      "additionalProperties": false,
      "description": "Exact executable, source-tree and environment identities; mutable tags are insufficient.",
      "properties": {
        "build_id": {
          "$ref": "#/$defs/StableId"
        },
        "environment_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "executable_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "source_sha256": {
          "$ref": "#/$defs/Sha256"
        }
      },
      "required": [
        "build_id",
        "source_sha256",
        "executable_sha256",
        "environment_sha256"
      ],
      "title": "RecordingBuildIdentity",
      "type": "object"
    },
    "Sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "StableId": {
      "maxLength": 128,
      "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?$",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "The private launch configuration the native app reads (exact key set on both sides).\n\nIt carries no catalog: after the handshake the app asks the service for the catalog the\nservice pinned from the subject's active corpus-store version. ``purpose`` repeats the\nsettings' declared catalog purpose so release verification can re-check the root.",
  "properties": {
    "asset_root": {
      "title": "Asset Root",
      "type": "string"
    },
    "capture_device": {
      "$ref": "#/$defs/CaptureDevice"
    },
    "capture_host": {
      "title": "Capture Host",
      "type": "string"
    },
    "client_build": {
      "$ref": "#/$defs/RecordingBuildIdentity"
    },
    "client_build_path": {
      "title": "Client Build Path",
      "type": "string"
    },
    "pilot_approval_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Pilot Approval Path"
    },
    "pilot_approval_sha256": {
      "anyOf": [
        {
          "$ref": "#/$defs/Sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "purpose": {
      "enum": [
        "capture-pilot",
        "capture-corpus",
        "held-out-evaluation",
        "physical-test"
      ],
      "title": "Purpose",
      "type": "string"
    },
    "recorder": {
      "$ref": "#/$defs/NativeRecordingPeerConfiguration"
    },
    "schema_directory": {
      "title": "Schema Directory",
      "type": "string"
    },
    "schema_version": {
      "const": "cole-voice-lab.recording-application/v2",
      "default": "cole-voice-lab.recording-application/v2",
      "title": "Schema Version",
      "type": "string"
    },
    "service": {
      "$ref": "#/$defs/NativeRecordingPeerConfiguration"
    },
    "subject_id": {
      "$ref": "#/$defs/StableId"
    }
  },
  "required": [
    "asset_root",
    "schema_directory",
    "client_build",
    "client_build_path",
    "purpose",
    "subject_id",
    "capture_device",
    "capture_host",
    "pilot_approval_path",
    "pilot_approval_sha256",
    "recorder",
    "service"
  ],
  "title": "NativeRecordingApplicationConfiguration",
  "type": "object"
}
