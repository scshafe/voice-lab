{
  "$defs": {
    "AssetFileBinding": {
      "additionalProperties": false,
      "description": "An asset-root-relative, byte-for-byte file binding.",
      "properties": {
        "media_type": {
          "maxLength": 200,
          "minLength": 3,
          "title": "Media Type",
          "type": "string"
        },
        "path": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "size_bytes": {
          "exclusiveMinimum": 0,
          "maximum": 8589934592,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "size_bytes",
        "media_type"
      ],
      "title": "AssetFileBinding",
      "type": "object"
    },
    "CandidateId": {
      "maxLength": 80,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "type": "string"
    },
    "LanguageTag": {
      "maxLength": 64,
      "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$",
      "type": "string"
    },
    "ProviderId": {
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "type": "string"
    },
    "Sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "StableId": {
      "maxLength": 128,
      "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?$",
      "type": "string"
    },
    "cole_voice_lab__promotion__NonBlank__1": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "cole_voice_lab__promotion__NonBlank__2": {
      "maxLength": 500,
      "minLength": 1,
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Identity and output evidence for the exact run selected for promotion.",
  "properties": {
    "audition_settings_sha256": {
      "$ref": "#/$defs/Sha256"
    },
    "candidate_id": {
      "$ref": "#/$defs/CandidateId"
    },
    "code_revision": {
      "pattern": "^[0-9a-f]{40,64}$",
      "title": "Code Revision",
      "type": "string"
    },
    "completed_at": {
      "format": "date-time",
      "title": "Completed At",
      "type": "string"
    },
    "consent_evidence_sha256": {
      "$ref": "#/$defs/Sha256"
    },
    "environment_fingerprint_sha256": {
      "$ref": "#/$defs/Sha256"
    },
    "experiment_id": {
      "$ref": "#/$defs/StableId"
    },
    "language": {
      "$ref": "#/$defs/LanguageTag"
    },
    "model_id": {
      "$ref": "#/$defs/cole_voice_lab__promotion__NonBlank__2"
    },
    "model_revision": {
      "pattern": "^[0-9a-f]{40,64}$",
      "title": "Model Revision",
      "type": "string"
    },
    "output": {
      "$ref": "#/$defs/AssetFileBinding"
    },
    "plan_sha256": {
      "$ref": "#/$defs/Sha256"
    },
    "provider_id": {
      "$ref": "#/$defs/ProviderId"
    },
    "provider_projection_id": {
      "const": "cole-voice-lab.worker-provider-projection/v1",
      "default": "cole-voice-lab.worker-provider-projection/v1",
      "title": "Provider Projection Id",
      "type": "string"
    },
    "provider_settings_sha256": {
      "$ref": "#/$defs/Sha256"
    },
    "provider_voice": {
      "$ref": "#/$defs/cole_voice_lab__promotion__NonBlank__1"
    },
    "reference_sha256": {
      "$ref": "#/$defs/Sha256"
    },
    "request_sha256": {
      "$ref": "#/$defs/Sha256"
    },
    "result_sha256": {
      "$ref": "#/$defs/Sha256"
    },
    "run_manifest_sha256": {
      "$ref": "#/$defs/Sha256"
    },
    "schema_version": {
      "const": "cole-voice-lab.promotion-run/v2",
      "default": "cole-voice-lab.promotion-run/v2",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "const": "complete",
      "default": "complete",
      "title": "Status",
      "type": "string"
    },
    "track": {
      "const": "direct-tts",
      "default": "direct-tts",
      "title": "Track",
      "type": "string"
    },
    "trial_id": {
      "$ref": "#/$defs/StableId"
    },
    "watermarked": {
      "title": "Watermarked",
      "type": "boolean"
    }
  },
  "required": [
    "experiment_id",
    "trial_id",
    "candidate_id",
    "plan_sha256",
    "run_manifest_sha256",
    "result_sha256",
    "request_sha256",
    "provider_id",
    "provider_voice",
    "model_id",
    "model_revision",
    "code_revision",
    "reference_sha256",
    "consent_evidence_sha256",
    "language",
    "audition_settings_sha256",
    "provider_settings_sha256",
    "environment_fingerprint_sha256",
    "output",
    "watermarked",
    "completed_at"
  ],
  "title": "WinningRunRecord",
  "type": "object"
}
