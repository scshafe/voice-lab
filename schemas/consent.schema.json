{
  "$defs": {
    "StableId": {
      "maxLength": 128,
      "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?$",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "allowed_execution_boundaries": {
      "items": {
        "enum": [
          "capture-host",
          "tailnet-local-host",
          "home-host"
        ],
        "type": "string"
      },
      "title": "Allowed Execution Boundaries",
      "type": "array"
    },
    "allowed_purposes": {
      "items": {
        "enum": [
          "private-zero-shot-evaluation",
          "private-fine-tuning",
          "private-home-host-synthesis",
          "private-assistant-speech",
          "private-chloe-speech-rendering"
        ],
        "type": "string"
      },
      "title": "Allowed Purposes",
      "type": "array"
    },
    "approved": {
      "title": "Approved",
      "type": "boolean"
    },
    "attestation": {
      "enum": [
        "self-recorded-and-self-authorized",
        "pending-subject-attestation"
      ],
      "title": "Attestation",
      "type": "string"
    },
    "consent_id": {
      "$ref": "#/$defs/StableId"
    },
    "disclosure_required": {
      "const": true,
      "default": true,
      "title": "Disclosure Required",
      "type": "boolean"
    },
    "effective_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Effective At"
    },
    "expires_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expires At"
    },
    "hosted_transfer_allowed": {
      "const": false,
      "default": false,
      "title": "Hosted Transfer Allowed",
      "type": "boolean"
    },
    "revoked_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Revoked At"
    },
    "schema_version": {
      "const": "cole-voice-lab.consent/v1",
      "default": "cole-voice-lab.consent/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "subject_id": {
      "$ref": "#/$defs/StableId"
    }
  },
  "required": [
    "consent_id",
    "subject_id",
    "approved",
    "attestation",
    "allowed_purposes",
    "allowed_execution_boundaries"
  ],
  "title": "ConsentRecord",
  "type": "object"
}
