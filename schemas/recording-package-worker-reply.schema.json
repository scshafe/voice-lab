{
  "$defs": {
    "CaptureDevice": {
      "additionalProperties": false,
      "properties": {
        "backend": {
          "default": "avfoundation",
          "enum": [
            "avfoundation",
            "coreaudio"
          ],
          "title": "Backend",
          "type": "string"
        },
        "calibration_sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/Sha256"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "device_id": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Device Id",
          "type": "string"
        },
        "display_name": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Display Name",
          "type": "string"
        },
        "microphone_serial": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Microphone Serial"
        }
      },
      "required": [
        "device_id",
        "display_name"
      ],
      "title": "CaptureDevice",
      "type": "object"
    },
    "CatalogReference": {
      "additionalProperties": false,
      "description": "A published catalog version by id, version, exact suite digest and snapshot digest.\n\n``catalog_sha256`` is the canonical digest of the suite alone (the digest every take\nand coverage projection keys on); ``snapshot_sha256`` is the sha256 of the exact\nsnapshot file bytes, so the alias half of the file is pinned too. ``suite_id`` and\n``purpose`` repeat what the snapshot's suite declares so contract-level checks (purpose\nagainst the capture gate) need no file read; the store verifies all of them against the\nsnapshot whenever a reference is materialized.",
      "properties": {
        "catalog_id": {
          "$ref": "#/$defs/StableId"
        },
        "catalog_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "catalog_version": {
          "$ref": "#/$defs/PositiveRevision"
        },
        "purpose": {
          "enum": [
            "capture-pilot",
            "capture-corpus",
            "held-out-evaluation",
            "physical-test"
          ],
          "title": "Purpose",
          "type": "string"
        },
        "snapshot_path": {
          "$ref": "#/$defs/RelativePath"
        },
        "snapshot_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "suite_id": {
          "$ref": "#/$defs/StableId"
        }
      },
      "required": [
        "catalog_id",
        "catalog_version",
        "catalog_sha256",
        "snapshot_sha256",
        "suite_id",
        "purpose",
        "snapshot_path"
      ],
      "title": "CatalogReference",
      "type": "object"
    },
    "ErrorCode": {
      "enum": [
        "RECORDING.INVALID_MESSAGE",
        "RECORDING.VERSION_MISMATCH",
        "RECORDING.BUILD_MISMATCH",
        "RECORDING.STALE_REVISION",
        "RECORDING.STALE_GENERATION",
        "RECORDING.OWNERSHIP_CONFLICT",
        "RECORDING.INVALID_TRANSITION",
        "RECORDING.DEVICE_UNAVAILABLE",
        "RECORDING.PERMISSION_DENIED",
        "RECORDING.PLAYBACK_ACTIVE",
        "RECORDING.DISK_SPACE",
        "RECORDING.WRITE_FAILED",
        "RECORDING.WAVEFORM_CACHE_UNAVAILABLE",
        "RECORDING.CONTINUITY_FAILED",
        "RECORDING.CAPTURE_OVERFLOW",
        "RECORDING.PARENT_LOST",
        "RECORDING.SOURCE_CHANGED",
        "RECORDING.HISTORY_UNKNOWN",
        "RECORDING.GATE_NOT_READY",
        "RECORDING.ANALYSIS_FAILED",
        "RECORDING.PLAYBACK_FAILED",
        "RECORDING.EDIT_FAILED",
        "RECORDING.PACKAGE_INCOMPLETE",
        "RECORDING.CANCELLED",
        "CORPUS.NO_ACTIVE_CATALOG",
        "CORPUS.CATALOG_UNKNOWN",
        "CORPUS.SNAPSHOT_MISMATCH",
        "CORPUS.STORE_MISSING"
      ],
      "type": "string"
    },
    "FrameCount": {
      "maximum": 28800000,
      "minimum": 0,
      "type": "integer"
    },
    "PositiveRevision": {
      "maximum": 9223372036854775807,
      "minimum": 1,
      "type": "integer"
    },
    "PreparedCaptureGate": {
      "additionalProperties": false,
      "description": "Previously verified corpus approval identity, invalidated when its evidence changes.",
      "properties": {
        "approval_path": {
          "anyOf": [
            {
              "$ref": "#/$defs/RelativePath"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "approval_sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/Sha256"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "evidence_sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/Sha256"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "state": {
          "enum": [
            "not-required",
            "ready",
            "unprepared",
            "invalid"
          ],
          "title": "State",
          "type": "string"
        },
        "verified_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/UtcTimestamp"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "state"
      ],
      "title": "PreparedCaptureGate",
      "type": "object"
    },
    "Prompt": {
      "additionalProperties": false,
      "description": "One catalog entry. Optional v2 fields are omitted when absent so v1 bytes never change.",
      "properties": {
        "category": {
          "enum": [
            "room-tone",
            "neutral",
            "conversational",
            "warm-narration",
            "technical",
            "numbers",
            "expressive",
            "reference",
            "procedure"
          ],
          "title": "Category",
          "type": "string"
        },
        "expected_seconds": {
          "exclusiveMinimum": 0.0,
          "maximum": 120.0,
          "title": "Expected Seconds",
          "type": "number"
        },
        "holdout": {
          "default": false,
          "title": "Holdout",
          "type": "boolean"
        },
        "instructions": {
          "anyOf": [
            {
              "maxLength": 2000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Instructions"
        },
        "labels": {
          "default": [],
          "items": {
            "$ref": "#/$defs/PromptLabel"
          },
          "maxItems": 8,
          "title": "Labels",
          "type": "array"
        },
        "prompt_id": {
          "$ref": "#/$defs/StableId"
        },
        "reference_candidate": {
          "default": false,
          "title": "Reference Candidate",
          "type": "boolean"
        },
        "style": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Style",
          "type": "string"
        },
        "text": {
          "anyOf": [
            {
              "maxLength": 2000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text"
        }
      },
      "required": [
        "prompt_id",
        "category",
        "style",
        "expected_seconds"
      ],
      "title": "Prompt",
      "type": "object"
    },
    "PromptLabel": {
      "maxLength": 32,
      "minLength": 2,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "type": "string"
    },
    "PromptSuite": {
      "additionalProperties": false,
      "properties": {
        "prompts": {
          "items": {
            "$ref": "#/$defs/Prompt"
          },
          "minItems": 1,
          "title": "Prompts",
          "type": "array"
        },
        "purpose": {
          "enum": [
            "capture-pilot",
            "capture-corpus",
            "held-out-evaluation",
            "physical-test"
          ],
          "title": "Purpose",
          "type": "string"
        },
        "schema_version": {
          "default": "cole-voice-lab.prompt-suite/v1",
          "enum": [
            "cole-voice-lab.prompt-suite/v1",
            "cole-voice-lab.prompt-suite/v2"
          ],
          "title": "Schema Version",
          "type": "string"
        },
        "suite_id": {
          "$ref": "#/$defs/StableId"
        }
      },
      "required": [
        "suite_id",
        "purpose",
        "prompts"
      ],
      "title": "PromptSuite",
      "type": "object"
    },
    "RecordingBuildIdentity": {
      "additionalProperties": false,
      "description": "Exact executable, source-tree and environment identities; mutable tags are insufficient.",
      "properties": {
        "build_id": {
          "$ref": "#/$defs/StableId"
        },
        "environment_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "executable_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "source_sha256": {
          "$ref": "#/$defs/Sha256"
        }
      },
      "required": [
        "build_id",
        "source_sha256",
        "executable_sha256",
        "environment_sha256"
      ],
      "title": "RecordingBuildIdentity",
      "type": "object"
    },
    "RecordingError": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "details": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "title": "Details",
          "type": "array"
        },
        "message": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "title": "RecordingError",
      "type": "object"
    },
    "RecordingFrameRange": {
      "additionalProperties": false,
      "description": "Source-frame recipe, independent from eventual derivative rendering.",
      "properties": {
        "end_frame": {
          "maximum": 28800000,
          "minimum": 1,
          "title": "End Frame",
          "type": "integer"
        },
        "source_frames": {
          "maximum": 28800000,
          "minimum": 1,
          "title": "Source Frames",
          "type": "integer"
        },
        "start_frame": {
          "$ref": "#/$defs/FrameCount"
        }
      },
      "required": [
        "source_frames",
        "start_frame",
        "end_frame"
      ],
      "title": "RecordingFrameRange",
      "type": "object"
    },
    "RecordingGroup": {
      "additionalProperties": false,
      "description": "One capture context: subject, catalog, device, host and corpus gate.\n\nrecording-group/v1 embeds the exact ``catalog`` (every group written before the corpus\nstore; readable forever, byte-identical). recording-group/v2 carries ``catalog_reference``\nto a published corpus-store snapshot instead and embeds no catalog; its prompts are read\nthrough ``corpus_store.resolve_group_catalog``. Containers (capture-reservation/v1,\nrecording-take/v1, recording-package-map/v1, responses) keep their own versions and nest\neither form. Absent optional fields are omitted so v1 canonical bytes never change.",
      "properties": {
        "capture_device": {
          "$ref": "#/$defs/CaptureDevice"
        },
        "capture_host": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Capture Host",
          "type": "string"
        },
        "catalog": {
          "anyOf": [
            {
              "$ref": "#/$defs/PromptSuite"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "catalog_reference": {
          "anyOf": [
            {
              "$ref": "#/$defs/CatalogReference"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "catalog_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "context_revision": {
          "$ref": "#/$defs/Revision"
        },
        "gate": {
          "$ref": "#/$defs/PreparedCaptureGate"
        },
        "group_id": {
          "$ref": "#/$defs/StableId"
        },
        "opened_at": {
          "$ref": "#/$defs/UtcTimestamp"
        },
        "reason": {
          "enum": [
            "app-start",
            "device-change",
            "configuration-change",
            "new-setup"
          ],
          "title": "Reason",
          "type": "string"
        },
        "room_tone_take_ids": {
          "default": [],
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "maxItems": 32,
          "title": "Room Tone Take Ids",
          "type": "array"
        },
        "schema_version": {
          "default": "cole-voice-lab.recording-group/v1",
          "enum": [
            "cole-voice-lab.recording-group/v1",
            "cole-voice-lab.recording-group/v2"
          ],
          "title": "Schema Version",
          "type": "string"
        },
        "setup_description": {
          "default": "",
          "maxLength": 1024,
          "title": "Setup Description",
          "type": "string"
        },
        "subject_id": {
          "$ref": "#/$defs/StableId"
        }
      },
      "required": [
        "group_id",
        "context_revision",
        "subject_id",
        "catalog_sha256",
        "capture_device",
        "capture_host",
        "opened_at",
        "reason",
        "gate"
      ],
      "title": "RecordingGroup",
      "type": "object"
    },
    "RecordingPackageEntry": {
      "additionalProperties": false,
      "properties": {
        "analysis_sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/Sha256"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "catalog_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "decision_revision": {
          "anyOf": [
            {
              "$ref": "#/$defs/Revision"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "edit_identity_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "edit_revision": {
          "anyOf": [
            {
              "$ref": "#/$defs/Revision"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "frame_range": {
          "anyOf": [
            {
              "$ref": "#/$defs/RecordingFrameRange"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "group_id": {
          "$ref": "#/$defs/StableId"
        },
        "original_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "package_relative_path": {
          "$ref": "#/$defs/RelativePath"
        },
        "prompt": {
          "$ref": "#/$defs/Prompt"
        },
        "recorded_at": {
          "$ref": "#/$defs/UtcTimestamp"
        },
        "subject_id": {
          "$ref": "#/$defs/StableId"
        },
        "take_id": {
          "$ref": "#/$defs/StableId"
        }
      },
      "required": [
        "take_id",
        "group_id",
        "subject_id",
        "catalog_sha256",
        "prompt",
        "package_relative_path",
        "original_sha256",
        "recorded_at",
        "edit_identity_sha256"
      ],
      "title": "RecordingPackageEntry",
      "type": "object"
    },
    "RecordingPackageMap": {
      "additionalProperties": false,
      "properties": {
        "entries": {
          "items": {
            "$ref": "#/$defs/RecordingPackageEntry"
          },
          "maxItems": 10000,
          "minItems": 1,
          "title": "Entries",
          "type": "array"
        },
        "group": {
          "$ref": "#/$defs/RecordingGroup"
        },
        "manifest_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "package_path": {
          "$ref": "#/$defs/RelativePath"
        },
        "registered_at": {
          "$ref": "#/$defs/UtcTimestamp"
        },
        "schema_version": {
          "const": "cole-voice-lab.recording-package-map/v1",
          "default": "cole-voice-lab.recording-package-map/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "selected_suite": {
          "anyOf": [
            {
              "$ref": "#/$defs/PromptSuite"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "session_id": {
          "$ref": "#/$defs/StableId"
        }
      },
      "required": [
        "session_id",
        "manifest_sha256",
        "package_path",
        "group",
        "entries",
        "registered_at"
      ],
      "title": "RecordingPackageMap",
      "type": "object"
    },
    "RelativePath": {
      "maxLength": 1024,
      "minLength": 1,
      "type": "string"
    },
    "Revision": {
      "maximum": 9223372036854775807,
      "minimum": 0,
      "type": "integer"
    },
    "Sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "StableId": {
      "maxLength": 128,
      "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?$",
      "type": "string"
    },
    "UtcTimestamp": {
      "format": "date-time",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "attempt": {
      "maximum": 3,
      "minimum": 1,
      "title": "Attempt",
      "type": "integer"
    },
    "build": {
      "$ref": "#/$defs/RecordingBuildIdentity"
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/RecordingError"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "generation": {
      "$ref": "#/$defs/StableId"
    },
    "kind": {
      "const": "result",
      "default": "result",
      "title": "Kind",
      "type": "string"
    },
    "operation_id": {
      "$ref": "#/$defs/StableId"
    },
    "package": {
      "anyOf": [
        {
          "$ref": "#/$defs/RecordingPackageMap"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "request_sha256": {
      "$ref": "#/$defs/Sha256"
    },
    "schema_version": {
      "const": "cole-voice-lab.recording-package-worker/v1",
      "default": "cole-voice-lab.recording-package-worker/v1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "generation",
    "operation_id",
    "request_sha256",
    "attempt",
    "build"
  ],
  "title": "PackageWorkerReply",
  "type": "object"
}
