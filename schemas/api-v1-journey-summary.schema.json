          "items": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Recording Ids",
          "type": "array"
        },
        "selected_count": {
          "minimum": 0,
          "title": "Selected Count",
          "type": "integer"
        },
        "strategy": {
          "title": "Strategy",
          "type": "string"
        },
        "target_size": {
          "title": "Target Size",
          "type": "integer"
        }
