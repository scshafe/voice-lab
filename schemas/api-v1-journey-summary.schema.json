        "review_queue_selected": {
          "minimum": 0,
          "title": "Review Queue Selected",
          "type": "integer"
        },
        "reviewed": {
          "minimum": 0,
          "title": "Reviewed",
          "type": "integer"
        },
        "rows": {
          "minimum": 0,
          "title": "Rows",
          "type": "integer"
        },
        "years": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Years",
          "type": "object"
        }
