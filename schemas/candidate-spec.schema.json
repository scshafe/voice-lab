{
  "$defs": {
    "CandidateId": {
      "maxLength": 80,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "type": "string"
    },
    "JsonValue": {},
    "StableId": {
      "maxLength": 128,
      "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?$",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "candidate_id": {
      "$ref": "#/$defs/CandidateId"
    },
    "code_license": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Code License",
      "type": "string"
    },
    "commercial_use_allowed": {
      "title": "Commercial Use Allowed",
      "type": "boolean"
    },
    "default_settings": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Default Settings",
      "type": "object"
    },
    "display_name": {
      "maxLength": 120,
      "minLength": 1,
      "title": "Display Name",
      "type": "string"
    },
    "enabled": {
      "default": true,
      "title": "Enabled",
      "type": "boolean"
    },
    "engine": {
      "enum": [
        "mlx-audio",
        "chatterbox",
        "f5-tts",
        "seed-vc"
      ],
      "title": "Engine",
      "type": "string"
    },
    "estimated_disk_gib": {
      "exclusiveMinimum": 0.0,
      "title": "Estimated Disk Gib",
      "type": "number"
    },
    "model_id": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Model Id",
      "type": "string"
    },
    "model_source": {
      "enum": [
        "huggingface",
        "git"
      ],
      "title": "Model Source",
      "type": "string"
    },
    "requires_reference_text": {
      "title": "Requires Reference Text",
      "type": "boolean"
    },
    "runtime_id": {
      "$ref": "#/$defs/StableId"
    },
    "supports_seed": {
      "title": "Supports Seed",
      "type": "boolean"
    },
    "track": {
      "enum": [
        "direct-tts",
        "voice-conversion"
      ],
      "title": "Track",
      "type": "string"
    },
    "weight_license": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Weight License",
      "type": "string"
    },
    "worker_module": {
      "pattern": "^[a-zA-Z_][a-zA-Z0-9_.]+$",
      "title": "Worker Module",
      "type": "string"
    }
  },
  "required": [
    "candidate_id",
    "display_name",
    "track",
    "engine",
    "runtime_id",
    "worker_module",
    "model_id",
    "model_source",
    "code_license",
    "weight_license",
    "commercial_use_allowed",
    "requires_reference_text",
    "supports_seed",
    "estimated_disk_gib"
  ],
  "title": "CandidateSpec",
  "type": "object"
}
