{
  "$defs": {
    "CatalogReference": {
      "additionalProperties": false,
      "description": "A published catalog version by id, version, exact suite digest and snapshot digest.\n\n``catalog_sha256`` is the canonical digest of the suite alone (the digest every take\nand coverage projection keys on); ``snapshot_sha256`` is the sha256 of the exact\nsnapshot file bytes, so the alias half of the file is pinned too. ``suite_id`` and\n``purpose`` repeat what the snapshot's suite declares so contract-level checks (purpose\nagainst the capture gate) need no file read; the store verifies all of them against the\nsnapshot whenever a reference is materialized.",
      "properties": {
        "catalog_id": {
          "$ref": "#/$defs/StableId"
        },
        "catalog_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "catalog_version": {
          "$ref": "#/$defs/PositiveRevision"
        },
        "purpose": {
          "enum": [
            "capture-pilot",
            "capture-corpus",
            "held-out-evaluation",
            "physical-test"
          ],
          "title": "Purpose",
          "type": "string"
        },
        "snapshot_path": {
          "$ref": "#/$defs/RelativePath"
        },
        "snapshot_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "suite_id": {
          "$ref": "#/$defs/StableId"
        }
      },
      "required": [
        "catalog_id",
        "catalog_version",
        "catalog_sha256",
        "snapshot_sha256",
        "suite_id",
        "purpose",
        "snapshot_path"
      ],
      "title": "CatalogReference",
      "type": "object"
    },
    "PlannedPackage": {
      "additionalProperties": false,
      "description": "One package of an export plan: the PC's take id, the Swift take's, the prompt, the\npackage's manifest digest and its bytes.",
      "properties": {
        "manifest_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "prompt_id": {
          "$ref": "#/$defs/StableId"
        },
        "size_bytes": {
          "exclusiveMinimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "source_take_id": {
          "$ref": "#/$defs/TakeId"
        },
        "take_id": {
          "$ref": "#/$defs/TakeId"
        }
      },
      "required": [
        "take_id",
        "source_take_id",
        "prompt_id",
        "manifest_sha256",
        "size_bytes"
      ],
      "title": "PlannedPackage",
      "type": "object"
    },
    "PositiveRevision": {
      "maximum": 9223372036854775807,
      "minimum": 1,
      "type": "integer"
    },
    "RelativePath": {
      "maxLength": 1024,
      "minLength": 1,
      "type": "string"
    },
    "Sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "StableId": {
      "maxLength": 128,
      "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?$",
      "type": "string"
    },
    "TakeId": {
      "pattern": "^take-[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "The payload an export approval names: which packages go to the PC, for which of its\ncatalog versions. It carries no time, so the same packages always make the same plan.",
  "properties": {
    "catalog": {
      "$ref": "#/$defs/CatalogReference"
    },
    "package_root": {
      "const": "tmp/corpus-import",
      "default": "tmp/corpus-import",
      "title": "Package Root",
      "type": "string"
    },
    "packages": {
      "items": {
        "$ref": "#/$defs/PlannedPackage"
      },
      "minItems": 1,
      "title": "Packages",
      "type": "array"
    },
    "schema_version": {
      "const": "cole-voice-lab.corpus-import-plan/v1",
      "default": "cole-voice-lab.corpus-import-plan/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "subject_id": {
      "$ref": "#/$defs/StableId"
    },
    "total_bytes": {
      "exclusiveMinimum": 0,
      "title": "Total Bytes",
      "type": "integer"
    }
  },
  "required": [
    "subject_id",
    "catalog",
    "packages",
    "total_bytes"
  ],
  "title": "CorpusImportPlan",
  "type": "object"
}
