{
  "$defs": {
    "AudioSpec": {
      "additionalProperties": false,
      "properties": {
        "channels": {
          "maximum": 32,
          "minimum": 1,
          "title": "Channels",
          "type": "integer"
        },
        "duration_seconds": {
          "exclusiveMinimum": 0.0,
          "title": "Duration Seconds",
          "type": "number"
        },
        "encoding": {
          "enum": [
            "pcm_s16le",
            "pcm_s24le",
            "pcm_s32le"
          ],
          "title": "Encoding",
          "type": "string"
        },
        "frames": {
          "minimum": 1,
          "title": "Frames",
          "type": "integer"
        },
        "sample_rate_hz": {
          "maximum": 384000,
          "minimum": 8000,
          "title": "Sample Rate Hz",
          "type": "integer"
        },
        "sample_width_bytes": {
          "enum": [
            2,
            3,
            4
          ],
          "title": "Sample Width Bytes",
          "type": "integer"
        }
      },
      "required": [
        "sample_rate_hz",
        "channels",
        "sample_width_bytes",
        "encoding",
        "frames",
        "duration_seconds"
      ],
      "title": "AudioSpec",
      "type": "object"
    },
    "CancelCommand": {
      "additionalProperties": false,
      "properties": {
        "cancelled_operation_id": {
          "$ref": "#/$defs/StableId"
        },
        "command": {
          "const": "cancel",
          "default": "cancel",
          "title": "Command",
          "type": "string"
        },
        "operation_id": {
          "$ref": "#/$defs/StableId"
        }
      },
      "required": [
        "operation_id",
        "cancelled_operation_id"
      ],
      "title": "CancelCommand",
      "type": "object"
    },
    "CancelFineTuneCommand": {
      "additionalProperties": false,
      "description": "Stop the fine-tune job ``cancelled_operation_id`` (a durable job, unlike ``cancel``).",
      "properties": {
        "cancelled_operation_id": {
          "$ref": "#/$defs/StableId"
        },
        "command": {
          "const": "cancel-fine-tune",
          "default": "cancel-fine-tune",
          "title": "Command",
          "type": "string"
        },
        "operation_id": {
          "$ref": "#/$defs/StableId"
        }
      },
      "required": [
        "operation_id",
        "cancelled_operation_id"
      ],
      "title": "CancelFineTuneCommand",
      "type": "object"
    },
    "CancelSynthesisCommand": {
      "additionalProperties": false,
      "description": "Stop the Speak request ``cancelled_operation_id`` (its worker's whole process group).",
      "properties": {
        "cancelled_operation_id": {
          "$ref": "#/$defs/StableId"
        },
        "command": {
          "const": "cancel-synthesis",
          "default": "cancel-synthesis",
          "title": "Command",
          "type": "string"
        },
        "operation_id": {
          "$ref": "#/$defs/StableId"
        }
      },
      "required": [
        "operation_id",
        "cancelled_operation_id"
      ],
      "title": "CancelSynthesisCommand",
      "type": "object"
    },
    "CaptureContinuityEvidence": {
      "additionalProperties": false,
      "description": "Successful native input continuity bound to one exact, privately saved WAV.",
      "properties": {
        "backend": {
          "const": "coreaudio-audioqueue",
          "title": "Backend",
          "type": "string"
        },
        "callback_count": {
          "exclusiveMinimum": 0,
          "title": "Callback Count",
          "type": "integer"
        },
        "continuity_checked": {
          "title": "Continuity Checked",
          "type": "boolean"
        },
        "device_uid": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Device Uid",
          "type": "string"
        },
        "first_sample_time": {
          "title": "First Sample Time",
          "type": "number"
        },
        "frames": {
          "exclusiveMinimum": 0,
          "title": "Frames",
          "type": "integer"
        },
        "last_sample_end": {
          "title": "Last Sample End",
          "type": "number"
        },
        "output_name": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Output Name",
          "type": "string"
        },
        "received_frames": {
          "exclusiveMinimum": 0,
          "title": "Received Frames",
          "type": "integer"
        },
        "schema_version": {
          "const": "cole-voice-lab.capture-continuity/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "stop_reason": {
          "enum": [
            "requested",
            "maximum-duration"
          ],
          "title": "Stop Reason",
          "type": "string"
        },
        "success": {
          "title": "Success",
          "type": "boolean"
        },
        "wav_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "wav_size_bytes": {
          "exclusiveMinimum": 0,
          "title": "Wav Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "backend",
        "device_uid",
        "output_name",
        "wav_sha256",
        "wav_size_bytes",
        "frames",
        "received_frames",
        "callback_count",
        "first_sample_time",
        "last_sample_end",
        "success",
        "continuity_checked",
        "stop_reason"
      ],
      "title": "CaptureContinuityEvidence",
      "type": "object"
    },
    "CaptureDevice": {
      "additionalProperties": false,
      "properties": {
        "backend": {
          "default": "avfoundation",
          "enum": [
            "avfoundation",
            "coreaudio"
          ],
          "title": "Backend",
          "type": "string"
        },
        "calibration_sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/Sha256"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "device_id": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Device Id",
          "type": "string"
        },
        "display_name": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Display Name",
          "type": "string"
        },
        "microphone_serial": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Microphone Serial"
        }
      },
      "required": [
        "device_id",
        "display_name"
      ],
      "title": "CaptureDevice",
      "type": "object"
    },
    "CaptureSealReceipt": {
      "additionalProperties": false,
      "properties": {
        "audio": {
          "$ref": "#/$defs/AudioSpec"
        },
        "continuity": {
          "$ref": "#/$defs/CaptureContinuityEvidence"
        },
        "first_sample_at": {
          "$ref": "#/$defs/UtcTimestamp"
        },
        "last_sample_at": {
          "$ref": "#/$defs/UtcTimestamp"
        },
        "original_path": {
          "$ref": "#/$defs/RelativePath"
        },
        "original_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "original_size_bytes": {
          "exclusiveMinimum": 44,
          "title": "Original Size Bytes",
          "type": "integer"
        },
        "process_generation": {
          "$ref": "#/$defs/StableId"
        },
        "recorder_build": {
          "$ref": "#/$defs/RecordingBuildIdentity"
        },
        "requested_at": {
          "$ref": "#/$defs/UtcTimestamp"
        },
        "reservation_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "schema_version": {
          "const": "cole-voice-lab.capture-seal/v1",
          "default": "cole-voice-lab.capture-seal/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "sealed_at": {
          "$ref": "#/$defs/UtcTimestamp"
        },
        "take_id": {
          "$ref": "#/$defs/StableId"
        }
      },
      "required": [
        "take_id",
        "reservation_sha256",
        "process_generation",
        "recorder_build",
        "original_path",
        "original_sha256",
        "original_size_bytes",
        "audio",
        "requested_at",
        "first_sample_at",
        "last_sample_at",
        "sealed_at",
        "continuity"
      ],
      "title": "CaptureSealReceipt",
      "type": "object"
    },
    "CatalogCommand": {
      "additionalProperties": false,
      "description": "Ask the service for the catalog it pinned for this process (the app's first request).\n\nThe service resolves the subject's active corpus-store catalog once per process and\nanswers with a ``CatalogEvent``; a later activation takes effect at the next launch.",
      "properties": {
        "command": {
          "const": "catalog",
          "default": "catalog",
          "title": "Command",
          "type": "string"
        },
        "operation_id": {
          "$ref": "#/$defs/StableId"
        }
      },
      "required": [
        "operation_id"
      ],
      "title": "CatalogCommand",
      "type": "object"
    },
    "CatalogReference": {
      "additionalProperties": false,
      "description": "A published catalog version by id, version, exact suite digest and snapshot digest.\n\n``catalog_sha256`` is the canonical digest of the suite alone (the digest every take\nand coverage projection keys on); ``snapshot_sha256`` is the sha256 of the exact\nsnapshot file bytes, so the alias half of the file is pinned too. ``suite_id`` and\n``purpose`` repeat what the snapshot's suite declares so contract-level checks (purpose\nagainst the capture gate) need no file read; the store verifies all of them against the\nsnapshot whenever a reference is materialized.",
      "properties": {
        "catalog_id": {
          "$ref": "#/$defs/StableId"
        },
        "catalog_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "catalog_version": {
          "$ref": "#/$defs/PositiveRevision"
        },
        "purpose": {
          "enum": [
            "capture-pilot",
            "capture-corpus",
            "held-out-evaluation",
            "physical-test"
          ],
          "title": "Purpose",
          "type": "string"
        },
        "snapshot_path": {
          "$ref": "#/$defs/RelativePath"
        },
        "snapshot_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "suite_id": {
          "$ref": "#/$defs/StableId"
        }
      },
      "required": [
        "catalog_id",
        "catalog_version",
        "catalog_sha256",
        "snapshot_sha256",
        "suite_id",
        "purpose",
        "snapshot_path"
      ],
      "title": "CatalogReference",
      "type": "object"
    },
    "ContinueLegacyRecordingCommand": {
      "additionalProperties": false,
      "description": "Continue an unfinished desktop session in a new native context.\n\n``context`` always embeds the session's frozen catalog and digest (the one place the\nembedded open-context form remains): a desktop session binds a catalog no corpus-store\nversion holds, and its sidecar evidence must match that catalog exactly.",
      "properties": {
        "command": {
          "const": "continue-legacy-recording",
          "default": "continue-legacy-recording",
          "title": "Command",
          "type": "string"
        },
        "context": {
          "$ref": "#/$defs/OpenContextCommand"
        },
        "operation_id": {
          "$ref": "#/$defs/StableId"
        },
        "session_evidence_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "session_id": {
          "$ref": "#/$defs/StableId"
        }
      },
      "required": [
        "operation_id",
        "session_id",
        "session_evidence_sha256",
        "context"
      ],
      "title": "ContinueLegacyRecordingCommand",
      "type": "object"
    },
    "DecisionCommand": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "enum": [
            "reject",
            "remove",
            "restore"
          ],
          "title": "Action",
          "type": "string"
        },
        "command": {
          "const": "decision",
          "default": "decision",
          "title": "Command",
          "type": "string"
        },
        "expected_decision_revision": {
          "$ref": "#/$defs/Revision"
        },
        "operation_id": {
          "$ref": "#/$defs/StableId"
        },
        "reason": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "selection": {
          "$ref": "#/$defs/RecordingSelection"
        },
        "take_id": {
          "$ref": "#/$defs/StableId"
        }
      },
      "required": [
        "selection",
        "operation_id",
        "take_id",
        "expected_decision_revision",
        "action"
      ],
      "title": "DecisionCommand",
      "type": "object"
    },
    "EditTakeCommand": {
      "additionalProperties": false,
      "properties": {
        "command": {
          "const": "edit",
          "default": "edit",
          "title": "Command",
          "type": "string"
        },
        "expected_edit_revision": {
          "$ref": "#/$defs/Revision"
        },
        "frame_range": {
          "$ref": "#/$defs/RecordingFrameRange"
        },
        "operation_id": {
          "$ref": "#/$defs/StableId"
        },
        "selection": {
          "$ref": "#/$defs/RecordingSelection"
        },
        "source_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "take_id": {
          "$ref": "#/$defs/StableId"
        }
      },
      "required": [
        "selection",
        "operation_id",
        "take_id",
        "source_sha256",
        "expected_edit_revision",
        "frame_range"
      ],
      "title": "EditTakeCommand",
      "type": "object"
    },
    "FineTuneCommand": {
      "additionalProperties": false,
      "description": "Train the voice model on the latest kept take of every spoken prompt (one job at a time).\n\n``epochs`` overrides the default training length. ``allow_missing`` trains on the\nprompts that have a kept take even when others have none; without it the job is refused\n``FINETUNE.CORPUS_INCOMPLETE`` unless every spoken prompt has one. The app always sends\n``true`` because the active catalog lists unrecorded standard sentence sets.",
      "properties": {
        "allow_missing": {
          "title": "Allow Missing",
          "type": "boolean"
        },
        "command": {
          "const": "fine-tune",
          "default": "fine-tune",
          "title": "Command",
          "type": "string"
        },
        "epochs": {
          "anyOf": [
            {
              "maximum": 10000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Epochs"
        },
        "operation_id": {
          "$ref": "#/$defs/StableId"
        }
      },
      "required": [
        "operation_id",
        "allow_missing"
      ],
      "title": "FineTuneCommand",
      "type": "object"
    },
    "FineTuneStatusCommand": {
      "additionalProperties": false,
      "description": "Ask whether fine-tuning is available, which job is active and which runs have finished.",
      "properties": {
        "command": {
          "const": "fine-tune-status",
          "default": "fine-tune-status",
          "title": "Command",
          "type": "string"
        },
        "operation_id": {
          "$ref": "#/$defs/StableId"
        }
      },
      "required": [
        "operation_id"
      ],
      "title": "FineTuneStatusCommand",
      "type": "object"
    },
    "FrameCount": {
      "maximum": 28800000,
      "minimum": 0,
      "type": "integer"
    },
    "HandshakeCommand": {
      "additionalProperties": false,
      "properties": {
        "build": {
          "$ref": "#/$defs/RecordingBuildIdentity"
        },
        "command": {
          "const": "handshake",
          "default": "handshake",
          "title": "Command",
          "type": "string"
        },
        "expected_peer_build": {
          "$ref": "#/$defs/RecordingBuildIdentity"
        },
        "role": {
          "enum": [
            "ui",
            "recorder",
            "service"
          ],
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "role",
        "build",
        "expected_peer_build"
      ],
      "title": "HandshakeCommand",
      "type": "object"
    },
    "HistoryCommand": {
      "additionalProperties": false,
      "properties": {
        "catalog_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "command": {
          "const": "history",
          "default": "history",
          "title": "Command",
          "type": "string"
        },
        "cursor": {
          "anyOf": [
            {
              "$ref": "#/$defs/StableId"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "group_cursor": {
          "anyOf": [
            {
              "$ref": "#/$defs/StableId"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "page_size": {
          "default": 50,
          "maximum": 200,
          "minimum": 1,
          "title": "Page Size",
          "type": "integer"
        },
        "prompt_cursor": {
          "anyOf": [
            {
              "$ref": "#/$defs/StableId"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "prompt_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/StableId"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "catalog_sha256"
      ],
      "title": "HistoryCommand",
      "type": "object"
    },
    "NavigateCommand": {
      "additionalProperties": false,
      "properties": {
        "command": {
          "const": "navigate",
          "default": "navigate",
          "title": "Command",
          "type": "string"
        },
        "mode": {
          "enum": [
            "selected-prompt",
            "continue-missing"
          ],
          "title": "Mode",
          "type": "string"
        },
        "operation_id": {
          "$ref": "#/$defs/StableId"
        },
        "selection": {
          "$ref": "#/$defs/RecordingSelection"
        },
        "target_prompt_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/StableId"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "operation_id",
        "selection",
        "mode"
      ],
      "title": "NavigateCommand",
      "type": "object"
    },
    "OpenContextCommand": {
      "additionalProperties": false,
      "description": "Open (or reuse) the native capture context of one subject on one catalog.\n\nThe app names the catalog its ``CatalogEvent`` delivered by ``catalog_reference``; the\nservice opens only the catalog it pinned for this process. The embedded form\n(``catalog`` plus ``catalog_sha256``) is legacy continuation only: it survives inside\n``ContinueLegacyRecordingCommand``, which binds a desktop session's frozen catalog that no\ncorpus-store version holds, and the service refuses it as a top-level command. Exactly\none form is present; absent fields are omitted, so an embedded command serializes (and\nreplays) byte-identically to the contract before the corpus store.",
      "properties": {
        "capture_device": {
          "$ref": "#/$defs/CaptureDevice"
        },
        "capture_host": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Capture Host",
          "type": "string"
        },
        "catalog": {
          "anyOf": [
            {
              "$ref": "#/$defs/PromptSuite"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "catalog_reference": {
          "anyOf": [
            {
              "$ref": "#/$defs/CatalogReference"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "catalog_sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/Sha256"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "command": {
          "const": "open-context",
          "default": "open-context",
          "title": "Command",
          "type": "string"
        },
        "expected_selection_revision": {
          "anyOf": [
            {
              "$ref": "#/$defs/Revision"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "new_setup": {
          "default": false,
          "title": "New Setup",
          "type": "boolean"
        },
        "operation_id": {
          "$ref": "#/$defs/StableId"
        },
        "pilot_approval_path": {
          "anyOf": [
            {
              "$ref": "#/$defs/RelativePath"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "pilot_approval_sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/Sha256"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "setup_description": {
          "default": "",
          "maxLength": 1024,
          "title": "Setup Description",
          "type": "string"
        },
        "subject_id": {
          "$ref": "#/$defs/StableId"
        }
      },
      "required": [
        "operation_id",
        "subject_id",
        "capture_device",
        "capture_host"
      ],
      "title": "OpenContextCommand",
      "type": "object"
    },
    "PositiveRevision": {
      "maximum": 9223372036854775807,
      "minimum": 1,
      "type": "integer"
    },
    "Prompt": {
      "additionalProperties": false,
      "description": "One catalog entry. Optional v2 fields are omitted when absent so v1 bytes never change.",
      "properties": {
        "category": {
          "enum": [
            "room-tone",
            "neutral",
            "conversational",
            "warm-narration",
            "technical",
            "numbers",
            "expressive",
            "reference",
            "procedure"
          ],
          "title": "Category",
          "type": "string"
        },
        "expected_seconds": {
          "exclusiveMinimum": 0.0,
          "maximum": 120.0,
          "title": "Expected Seconds",
          "type": "number"
        },
        "holdout": {
          "default": false,
          "title": "Holdout",
          "type": "boolean"
        },
        "instructions": {
          "anyOf": [
            {
              "maxLength": 2000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Instructions"
        },
        "labels": {
          "default": [],
          "items": {
            "$ref": "#/$defs/PromptLabel"
          },
          "maxItems": 8,
          "title": "Labels",
          "type": "array"
        },
        "prompt_id": {
          "$ref": "#/$defs/StableId"
        },
        "reference_candidate": {
          "default": false,
          "title": "Reference Candidate",
          "type": "boolean"
        },
        "style": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Style",
          "type": "string"
        },
        "text": {
          "anyOf": [
            {
              "maxLength": 2000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text"
        }
      },
      "required": [
        "prompt_id",
        "category",
        "style",
