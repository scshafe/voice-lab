{
  "$defs": {
    "BoundHostedTransferApproval": {
      "additionalProperties": false,
      "properties": {
        "file": {
          "$ref": "#/$defs/JsonEvidenceBinding"
        },
        "record": {
          "$ref": "#/$defs/HostedTransferApproval"
        }
      },
      "required": [
        "file",
        "record"
      ],
      "title": "BoundHostedTransferApproval",
      "type": "object"
    },
    "HostedTransferApproval": {
      "additionalProperties": false,
      "description": "A separate human authorization; this module never creates one implicitly.",
      "properties": {
        "approval_id": {
          "$ref": "#/$defs/StableId"
        },
        "approved": {
          "const": true,
          "title": "Approved",
          "type": "boolean"
        },
        "approved_at": {
          "format": "date-time",
          "title": "Approved At",
          "type": "string"
        },
        "approved_by": {
          "$ref": "#/$defs/cole_voice_lab__datasets__NonBlank__1"
        },
        "dataset_manifest_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "destination": {
          "$ref": "#/$defs/cole_voice_lab__datasets__NonBlank__2"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "payload_set_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "purpose": {
          "const": "private-fine-tuning",
          "default": "private-fine-tuning",
          "title": "Purpose",
          "type": "string"
        },
        "schema_version": {
          "const": "cole-voice-lab.hosted-transfer-approval/v1",
          "default": "cole-voice-lab.hosted-transfer-approval/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "statement": {
          "$ref": "#/$defs/cole_voice_lab__datasets__NonBlank__3"
        }
      },
      "required": [
        "approval_id",
        "approved",
        "destination",
        "dataset_manifest_sha256",
        "payload_set_sha256",
        "approved_at",
        "expires_at",
        "approved_by",
        "statement"
      ],
      "title": "HostedTransferApproval",
      "type": "object"
    },
    "JsonEvidenceBinding": {
      "additionalProperties": false,
      "description": "An exact, asset-root-relative canonical JSON file.",
      "properties": {
        "path": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "size_bytes": {
          "exclusiveMinimum": 0,
          "maximum": 1048576,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ],
      "title": "JsonEvidenceBinding",
      "type": "object"
    },
    "PayloadFileBinding": {
      "additionalProperties": false,
      "properties": {
        "media_type": {
          "enum": [
            "audio/wav",
            "application/json"
          ],
          "title": "Media Type",
          "type": "string"
        },
        "path": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "size_bytes": {
          "exclusiveMinimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "size_bytes",
        "media_type"
      ],
      "title": "PayloadFileBinding",
      "type": "object"
    },
    "Sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "StableId": {
      "maxLength": 128,
      "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?$",
      "type": "string"
    },
    "cole_voice_lab__datasets__NonBlank__1": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "cole_voice_lab__datasets__NonBlank__2": {
      "maxLength": 2048,
      "minLength": 1,
      "type": "string"
    },
    "cole_voice_lab__datasets__NonBlank__3": {
      "maxLength": 4096,
      "minLength": 1,
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "approval": {
      "anyOf": [
        {
          "$ref": "#/$defs/BoundHostedTransferApproval"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "created_by": {
      "$ref": "#/$defs/cole_voice_lab__datasets__NonBlank__1"
    },
    "dataset_id": {
      "$ref": "#/$defs/StableId"
    },
    "dataset_manifest": {
      "$ref": "#/$defs/JsonEvidenceBinding"
    },
    "destination": {
      "anyOf": [
        {
          "maxLength": 2048,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Destination"
    },
    "execution_performed": {
      "const": false,
      "default": false,
      "title": "Execution Performed",
      "type": "boolean"
    },
    "hosted_transfer_status": {
      "enum": [
        "prohibited",
        "approved-not-executed"
      ],
      "title": "Hosted Transfer Status",
      "type": "string"
    },
    "payload": {
      "items": {
        "$ref": "#/$defs/PayloadFileBinding"
      },
      "minItems": 2,
      "title": "Payload",
      "type": "array"
    },
    "payload_set_sha256": {
      "$ref": "#/$defs/Sha256"
    },
    "plan_id": {
      "$ref": "#/$defs/StableId"
    },
    "schema_version": {
      "const": "cole-voice-lab.fine-tuning-transfer-plan/v1",
      "default": "cole-voice-lab.fine-tuning-transfer-plan/v1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "plan_id",
    "dataset_id",
    "dataset_manifest",
    "created_at",
    "created_by",
    "payload",
    "payload_set_sha256",
    "hosted_transfer_status"
  ],
  "title": "FineTuningTransferPlan",
  "type": "object"
}
