{
  "$defs": {
    "BlobRef": {
      "additionalProperties": false,
      "description": "One stored blob, named by the SHA-256 and size of the bytes the store keeps.",
      "properties": {
        "sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "size": {
          "maximum": 16777216,
          "minimum": 0,
          "title": "Size",
          "type": "integer"
        }
      },
      "required": [
        "sha256",
        "size"
      ],
      "title": "BlobRef",
      "type": "object"
    },
    "LibraryId": {
      "maxLength": 64,
      "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,62}[a-z0-9])?$",
      "type": "string"
    },
    "PositiveStorageCounter": {
      "maximum": 9223372036854775807,
      "minimum": 1,
      "type": "integer"
    },
    "RefName": {
      "maxLength": 256,
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}(?:/[a-z0-9][a-z0-9._-]{0,63}){0,7}$",
      "type": "string"
    },
    "RefValue": {
      "additionalProperties": false,
      "description": "A named pointer at one blob; ``version`` counts its swaps, starting at 1.",
      "properties": {
        "name": {
          "$ref": "#/$defs/RefName"
        },
        "target": {
          "$ref": "#/$defs/BlobRef"
        },
        "updated_at": {
          "$ref": "#/$defs/UtcTimestamp"
        },
        "version": {
          "$ref": "#/$defs/PositiveStorageCounter"
        }
      },
      "required": [
        "name",
        "version",
        "target",
        "updated_at"
      ],
      "title": "RefValue",
      "type": "object"
    },
    "Sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "StorageCounter": {
      "maximum": 9223372036854775807,
      "minimum": 0,
      "type": "integer"
    },
    "UtcTimestamp": {
      "format": "date-time",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "The newest generation pushed to one destination (``\u2026/destinations/<d>/state.json``).\n\nGeneration 0 means nothing was pushed yet, and only then are ``manifest_sha256``, ``head``\nand ``ledger_tail_sha256`` null; ``head`` is always this library's head ref.\n``destination_sha256`` is the ``destination_digest`` of the ``LedgerDestination`` the\ngeneration went to, so a push whose binding names another vault, namespace or node is\nrefused instead of continuing this library's chain somewhere else.\n``ledger_tail_sha256`` is the ``ledger_entry_digest`` of the ledger entry that records\nthis generation \u2014 its ``upload-completed`` entry, or (before that entry is written, and in\nthe window between writing it and recording it here) the ``upload-started`` entry it\npairs with. No later entry's chain digest covers the ledger's last entry, so this is what\nmakes an edit of it visible.",
  "properties": {
    "destination_sha256": {
      "$ref": "#/$defs/Sha256"
    },
    "generation": {
      "$ref": "#/$defs/StorageCounter"
    },
    "head": {
      "anyOf": [
        {
          "$ref": "#/$defs/RefValue"
        },
        {
          "type": "null"
        }
      ]
    },
    "ledger_tail_sha256": {
      "anyOf": [
        {
          "$ref": "#/$defs/Sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "library_id": {
      "$ref": "#/$defs/LibraryId"
    },
    "manifest_sha256": {
      "anyOf": [
        {
          "$ref": "#/$defs/Sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "schema_version": {
      "const": "cole-voice-lab.replication-state/v1",
      "default": "cole-voice-lab.replication-state/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "updated_at": {
      "$ref": "#/$defs/UtcTimestamp"
    }
  },
  "required": [
    "library_id",
    "generation",
    "manifest_sha256",
    "head",
    "destination_sha256",
    "ledger_tail_sha256",
    "updated_at"
  ],
  "title": "ReplicationState",
  "type": "object"
}
