{
  "$defs": {
    "FrameCount": {
      "maximum": 28800000,
      "minimum": 0,
      "type": "integer"
    },
    "PositiveRevision": {
      "maximum": 9223372036854775807,
      "minimum": 1,
      "type": "integer"
    },
    "RecordingFrameRange": {
      "additionalProperties": false,
      "description": "Source-frame recipe, independent from eventual derivative rendering.",
      "properties": {
        "end_frame": {
          "maximum": 28800000,
          "minimum": 1,
          "title": "End Frame",
          "type": "integer"
        },
        "source_frames": {
          "maximum": 28800000,
          "minimum": 1,
          "title": "Source Frames",
          "type": "integer"
        },
        "start_frame": {
          "$ref": "#/$defs/FrameCount"
        }
      },
      "required": [
        "source_frames",
        "start_frame",
        "end_frame"
      ],
      "title": "RecordingFrameRange",
      "type": "object"
    },
    "Sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "StableId": {
      "maxLength": 128,
      "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?$",
      "type": "string"
    },
    "UtcTimestamp": {
      "format": "date-time",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Version 2 keeps a durable frame decision independent of derivative rendering.",
  "properties": {
    "edit_revision": {
      "$ref": "#/$defs/PositiveRevision"
    },
    "frame_range": {
      "$ref": "#/$defs/RecordingFrameRange"
    },
    "operation_id": {
      "$ref": "#/$defs/StableId"
    },
    "prompt_id": {
      "$ref": "#/$defs/StableId"
    },
    "schema_version": {
      "const": "cole-voice-lab.recording-edit/v2",
      "default": "cole-voice-lab.recording-edit/v2",
      "title": "Schema Version",
      "type": "string"
    },
    "source_sha256": {
      "$ref": "#/$defs/Sha256"
    },
    "subject_id": {
      "$ref": "#/$defs/StableId"
    },
    "take_id": {
      "$ref": "#/$defs/StableId"
    },
    "updated_at": {
      "$ref": "#/$defs/UtcTimestamp"
    }
  },
  "required": [
    "subject_id",
    "take_id",
    "prompt_id",
    "source_sha256",
    "frame_range",
    "edit_revision",
    "operation_id",
    "updated_at"
  ],
  "title": "RecordingEditRecipe",
  "type": "object"
}
