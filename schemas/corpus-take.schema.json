{
  "$defs": {
    "AudioSpec": {
      "additionalProperties": false,
      "properties": {
        "channels": {
          "maximum": 32,
          "minimum": 1,
          "title": "Channels",
          "type": "integer"
        },
        "duration_seconds": {
          "exclusiveMinimum": 0.0,
          "title": "Duration Seconds",
          "type": "number"
        },
        "encoding": {
          "enum": [
            "pcm_s16le",
            "pcm_s24le",
            "pcm_s32le"
          ],
          "title": "Encoding",
          "type": "string"
        },
        "frames": {
          "minimum": 1,
          "title": "Frames",
          "type": "integer"
        },
        "sample_rate_hz": {
          "maximum": 384000,
          "minimum": 8000,
          "title": "Sample Rate Hz",
          "type": "integer"
        },
        "sample_width_bytes": {
          "enum": [
            2,
            3,
            4
          ],
          "title": "Sample Width Bytes",
          "type": "integer"
        }
      },
      "required": [
        "sample_rate_hz",
        "channels",
        "sample_width_bytes",
        "encoding",
        "frames",
        "duration_seconds"
      ],
      "title": "AudioSpec",
      "type": "object"
    },
    "CaptureDevice": {
      "additionalProperties": false,
      "properties": {
        "backend": {
          "default": "avfoundation",
          "enum": [
            "avfoundation",
            "coreaudio",
            "portaudio"
          ],
          "title": "Backend",
          "type": "string"
        },
        "calibration_sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/Sha256"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "device_id": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Device Id",
          "type": "string"
        },
        "display_name": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Display Name",
          "type": "string"
        },
        "microphone_serial": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Microphone Serial"
        }
      },
      "required": [
        "device_id",
        "display_name"
      ],
      "title": "CaptureDevice",
      "type": "object"
    },
    "CatalogReference": {
      "additionalProperties": false,
      "description": "A published catalog version by id, version, exact suite digest and snapshot digest.\n\n``catalog_sha256`` is the canonical digest of the suite alone (the digest every take\nand coverage projection keys on); ``snapshot_sha256`` is the sha256 of the exact\nsnapshot file bytes, so the alias half of the file is pinned too. ``suite_id`` and\n``purpose`` repeat what the snapshot's suite declares so contract-level checks (purpose\nagainst the capture gate) need no file read; the store verifies all of them against the\nsnapshot whenever a reference is materialized.",
      "properties": {
        "catalog_id": {
          "$ref": "#/$defs/StableId"
        },
        "catalog_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "catalog_version": {
          "$ref": "#/$defs/PositiveRevision"
        },
        "purpose": {
          "enum": [
            "capture-pilot",
            "capture-corpus",
            "held-out-evaluation",
            "physical-test"
          ],
          "title": "Purpose",
          "type": "string"
        },
        "snapshot_path": {
          "$ref": "#/$defs/RelativePath"
        },
        "snapshot_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "suite_id": {
          "$ref": "#/$defs/StableId"
        }
      },
      "required": [
        "catalog_id",
        "catalog_version",
        "catalog_sha256",
        "snapshot_sha256",
        "suite_id",
        "purpose",
        "snapshot_path"
      ],
      "title": "CatalogReference",
      "type": "object"
    },
    "PositiveRevision": {
      "maximum": 9223372036854775807,
      "minimum": 1,
      "type": "integer"
    },
    "Prompt": {
      "additionalProperties": false,
      "description": "One catalog entry. Optional v2 fields are omitted when absent so v1 bytes never change.",
      "properties": {
        "category": {
          "enum": [
            "room-tone",
            "neutral",
            "conversational",
            "warm-narration",
            "technical",
            "numbers",
            "expressive",
            "reference",
            "procedure"
          ],
          "title": "Category",
          "type": "string"
        },
        "expected_seconds": {
          "exclusiveMinimum": 0.0,
          "maximum": 120.0,
          "title": "Expected Seconds",
          "type": "number"
        },
        "holdout": {
          "default": false,
          "title": "Holdout",
          "type": "boolean"
        },
        "instructions": {
          "anyOf": [
            {
              "maxLength": 2000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Instructions"
        },
        "labels": {
          "default": [],
          "items": {
            "$ref": "#/$defs/PromptLabel"
          },
          "maxItems": 8,
          "title": "Labels",
          "type": "array"
        },
        "prompt_id": {
          "$ref": "#/$defs/StableId"
        },
        "reference_candidate": {
          "default": false,
          "title": "Reference Candidate",
          "type": "boolean"
        },
        "style": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Style",
          "type": "string"
        },
        "text": {
          "anyOf": [
            {
              "maxLength": 2000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text"
        }
      },
      "required": [
        "prompt_id",
        "category",
        "style",
        "expected_seconds"
      ],
      "title": "Prompt",
      "type": "object"
    },
    "PromptLabel": {
      "maxLength": 32,
      "minLength": 2,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "type": "string"
    },
    "RelativePath": {
      "maxLength": 1024,
      "minLength": 1,
      "type": "string"
    },
    "Sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "StableId": {
      "maxLength": 128,
      "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?$",
      "type": "string"
    },
    "TakeAudio": {
      "additionalProperties": false,
      "description": "The take's one recording.",
      "properties": {
        "audio": {
          "$ref": "#/$defs/AudioSpec"
        },
        "path": {
          "const": "original.wav",
          "default": "original.wav",
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "size_bytes": {
          "exclusiveMinimum": 44,
          "maximum": 95040044,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "sha256",
        "size_bytes",
        "audio"
      ],
      "title": "TakeAudio",
      "type": "object"
    },
    "TakeClient": {
      "additionalProperties": false,
      "description": "The program that recorded the take: its name, version and platform, as it reports them.",
      "properties": {
        "name": {
          "$ref": "#/$defs/_Text"
        },
        "platform": {
          "$ref": "#/$defs/_Text"
        },
        "version": {
          "$ref": "#/$defs/_Text"
        }
      },
      "required": [
        "name",
        "version",
        "platform"
      ],
      "title": "TakeClient",
      "type": "object"
    },
    "TakeContinuity": {
      "additionalProperties": false,
      "description": "The worker's continuity evidence: its file, and what the PC shows without reading it.\n\n``started_at`` is when the worker's stream started (its clock); every field here equals\nthe evidence file's own.",
      "properties": {
        "device_name": {
          "$ref": "#/$defs/_Text"
        },
        "host_api": {
          "$ref": "#/$defs/_Text"
        },
        "max_abs_deviation_frames": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Max Abs Deviation Frames"
        },
        "path": {
          "const": "continuity.json",
          "default": "continuity.json",
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "simulated": {
          "title": "Simulated",
          "type": "boolean"
        },
        "size_bytes": {
          "exclusiveMinimum": 0,
          "maximum": 16384,
          "title": "Size Bytes",
          "type": "integer"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "stop_reason": {
          "enum": [
            "requested",
            "maximum-duration"
          ],
          "title": "Stop Reason",
          "type": "string"
        }
      },
      "required": [
        "sha256",
        "size_bytes",
        "host_api",
        "device_name",
        "simulated",
        "started_at",
        "stop_reason",
        "max_abs_deviation_frames"
      ],
      "title": "TakeContinuity",
      "type": "object"
    },
    "TakeId": {
      "pattern": "^take-[0-9a-f]{64}$",
      "type": "string"
    },
    "_Text": {
      "maxLength": 500,
      "minLength": 1,
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "``manifest.json`` of a take package: one take of one prompt, immutable.",
  "properties": {
    "audio": {
      "$ref": "#/$defs/TakeAudio"
    },
    "capture_device": {
      "$ref": "#/$defs/CaptureDevice"
    },
    "capture_host": {
      "$ref": "#/$defs/_Text"
    },
    "catalog": {
      "$ref": "#/$defs/CatalogReference"
    },
    "client": {
      "$ref": "#/$defs/TakeClient"
    },
    "continuity": {
      "$ref": "#/$defs/TakeContinuity"
    },
    "prompt": {
      "$ref": "#/$defs/Prompt"
    },
    "prompt_sha256": {
      "$ref": "#/$defs/Sha256"
    },
    "requested_at": {
      "format": "date-time",
      "title": "Requested At",
      "type": "string"
    },
    "schema_version": {
      "const": "cole-voice-lab.corpus-take/v1",
      "default": "cole-voice-lab.corpus-take/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "subject_id": {
      "$ref": "#/$defs/StableId"
    },
    "take_id": {
      "$ref": "#/$defs/TakeId"
    }
  },
  "required": [
    "take_id",
    "subject_id",
    "prompt",
    "prompt_sha256",
    "catalog",
    "requested_at",
    "capture_host",
    "client",
    "capture_device",
    "audio",
    "continuity"
  ],
  "title": "CorpusTakeManifest",
  "type": "object"
}
