{
  "$defs": {
    "AudioSpec": {
      "additionalProperties": false,
      "properties": {
        "channels": {
          "maximum": 32,
          "minimum": 1,
          "title": "Channels",
          "type": "integer"
        },
        "duration_seconds": {
          "exclusiveMinimum": 0.0,
          "title": "Duration Seconds",
          "type": "number"
        },
        "encoding": {
          "enum": [
            "pcm_s16le",
            "pcm_s24le",
            "pcm_s32le"
          ],
          "title": "Encoding",
          "type": "string"
        },
        "frames": {
          "minimum": 1,
          "title": "Frames",
          "type": "integer"
        },
        "sample_rate_hz": {
          "maximum": 384000,
          "minimum": 8000,
          "title": "Sample Rate Hz",
          "type": "integer"
        },
        "sample_width_bytes": {
          "enum": [
            2,
            3,
            4
          ],
          "title": "Sample Width Bytes",
          "type": "integer"
        }
      },
      "required": [
        "sample_rate_hz",
        "channels",
        "sample_width_bytes",
        "encoding",
        "frames",
        "duration_seconds"
      ],
      "title": "AudioSpec",
      "type": "object"
    },
    "CaptureContinuityEvidence": {
      "additionalProperties": false,
      "description": "Successful native input continuity bound to one exact, privately saved WAV.",
      "properties": {
        "backend": {
          "const": "coreaudio-audioqueue",
          "title": "Backend",
          "type": "string"
        },
        "callback_count": {
          "exclusiveMinimum": 0,
          "title": "Callback Count",
          "type": "integer"
        },
        "continuity_checked": {
          "title": "Continuity Checked",
          "type": "boolean"
        },
        "device_uid": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Device Uid",
          "type": "string"
        },
        "first_sample_time": {
          "title": "First Sample Time",
          "type": "number"
        },
        "frames": {
          "exclusiveMinimum": 0,
          "title": "Frames",
          "type": "integer"
        },
        "last_sample_end": {
          "title": "Last Sample End",
          "type": "number"
        },
        "output_name": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Output Name",
          "type": "string"
        },
        "received_frames": {
          "exclusiveMinimum": 0,
          "title": "Received Frames",
          "type": "integer"
        },
        "schema_version": {
          "const": "cole-voice-lab.capture-continuity/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "stop_reason": {
          "enum": [
            "requested",
            "maximum-duration"
          ],
          "title": "Stop Reason",
          "type": "string"
        },
        "success": {
          "title": "Success",
          "type": "boolean"
        },
        "wav_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "wav_size_bytes": {
          "exclusiveMinimum": 0,
          "title": "Wav Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "backend",
        "device_uid",
        "output_name",
        "wav_sha256",
        "wav_size_bytes",
        "frames",
        "received_frames",
        "callback_count",
        "first_sample_time",
        "last_sample_end",
        "success",
        "continuity_checked",
        "stop_reason"
      ],
      "title": "CaptureContinuityEvidence",
      "type": "object"
    },
    "CaptureSealReceipt": {
      "additionalProperties": false,
      "properties": {
        "audio": {
          "$ref": "#/$defs/AudioSpec"
        },
        "continuity": {
          "$ref": "#/$defs/CaptureContinuityEvidence"
        },
        "first_sample_at": {
          "$ref": "#/$defs/UtcTimestamp"
        },
        "last_sample_at": {
          "$ref": "#/$defs/UtcTimestamp"
        },
        "original_path": {
          "$ref": "#/$defs/RelativePath"
        },
        "original_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "original_size_bytes": {
          "exclusiveMinimum": 44,
          "title": "Original Size Bytes",
          "type": "integer"
        },
        "process_generation": {
          "$ref": "#/$defs/StableId"
        },
        "recorder_build": {
          "$ref": "#/$defs/RecordingBuildIdentity"
        },
        "requested_at": {
          "$ref": "#/$defs/UtcTimestamp"
        },
        "reservation_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "schema_version": {
          "const": "cole-voice-lab.capture-seal/v1",
          "default": "cole-voice-lab.capture-seal/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "sealed_at": {
          "$ref": "#/$defs/UtcTimestamp"
        },
        "take_id": {
          "$ref": "#/$defs/StableId"
        }
      },
      "required": [
        "take_id",
        "reservation_sha256",
        "process_generation",
        "recorder_build",
        "original_path",
        "original_sha256",
        "original_size_bytes",
        "audio",
        "requested_at",
        "first_sample_at",
        "last_sample_at",
        "sealed_at",
        "continuity"
      ],
      "title": "CaptureSealReceipt",
      "type": "object"
    },
    "ErrorCode": {
      "enum": [
        "RECORDING.INVALID_MESSAGE",
        "RECORDING.VERSION_MISMATCH",
        "RECORDING.BUILD_MISMATCH",
        "RECORDING.STALE_REVISION",
        "RECORDING.STALE_GENERATION",
        "RECORDING.OWNERSHIP_CONFLICT",
        "RECORDING.INVALID_TRANSITION",
        "RECORDING.DEVICE_UNAVAILABLE",
        "RECORDING.PERMISSION_DENIED",
        "RECORDING.PLAYBACK_ACTIVE",
        "RECORDING.DISK_SPACE",
        "RECORDING.WRITE_FAILED",
        "RECORDING.WAVEFORM_CACHE_UNAVAILABLE",
        "RECORDING.CONTINUITY_FAILED",
        "RECORDING.CAPTURE_OVERFLOW",
        "RECORDING.PARENT_LOST",
        "RECORDING.SOURCE_CHANGED",
        "RECORDING.HISTORY_UNKNOWN",
        "RECORDING.GATE_NOT_READY",
        "RECORDING.ANALYSIS_FAILED",
        "RECORDING.PLAYBACK_FAILED",
        "RECORDING.EDIT_FAILED",
        "RECORDING.PACKAGE_INCOMPLETE",
        "RECORDING.CANCELLED",
        "CORPUS.NO_ACTIVE_CATALOG",
        "CORPUS.CATALOG_UNKNOWN",
        "CORPUS.SNAPSHOT_MISMATCH",
        "CORPUS.STORE_MISSING"
      ],
      "type": "string"
    },
    "FrameCount": {
      "maximum": 28800000,
      "minimum": 0,
      "type": "integer"
    },
    "RecordingBuildIdentity": {
      "additionalProperties": false,
      "description": "Exact executable, source-tree and environment identities; mutable tags are insufficient.",
      "properties": {
        "build_id": {
          "$ref": "#/$defs/StableId"
        },
        "environment_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "executable_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "source_sha256": {
          "$ref": "#/$defs/Sha256"
        }
      },
      "required": [
        "build_id",
        "source_sha256",
        "executable_sha256",
        "environment_sha256"
      ],
      "title": "RecordingBuildIdentity",
      "type": "object"
    },
    "RecordingError": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "details": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "title": "Details",
          "type": "array"
        },
        "message": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "title": "RecordingError",
      "type": "object"
    },
    "RelativePath": {
      "maxLength": 1024,
      "minLength": 1,
      "type": "string"
    },
    "Sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "StableId": {
      "maxLength": 128,
      "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?$",
      "type": "string"
    },
    "UtcTimestamp": {
      "format": "date-time",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Untrusted native emergency evidence; successful sealing requires a complete seal receipt.\n\nWire bytes use the normal framed JSON contract. Python recovery validates this\nseparate schema and writes authoritative canonical evidence only after checks.\nNo byte order in native JSON is mistaken for canonical lab serialization.",
  "properties": {
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/RecordingError"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "partial_path": {
      "$ref": "#/$defs/RelativePath"
    },
    "process_generation": {
      "$ref": "#/$defs/StableId"
    },
    "received_frames": {
      "$ref": "#/$defs/FrameCount"
    },
    "recorded_at": {
      "$ref": "#/$defs/UtcTimestamp"
    },
    "reservation_sha256": {
      "$ref": "#/$defs/Sha256"
    },
    "schema_version": {
      "const": "cole-voice-lab.native-recovery/v1",
      "default": "cole-voice-lab.native-recovery/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "seal": {
      "anyOf": [
        {
          "$ref": "#/$defs/CaptureSealReceipt"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "state": {
      "enum": [
        "partial",
        "sealed"
      ],
      "title": "State",
      "type": "string"
    },
    "take_id": {
      "$ref": "#/$defs/StableId"
    },
    "written_frames": {
      "$ref": "#/$defs/FrameCount"
    }
  },
  "required": [
    "take_id",
    "reservation_sha256",
    "process_generation",
    "recorded_at",
    "partial_path",
    "received_frames",
    "written_frames",
    "state"
  ],
  "title": "NativeRecoveryReceipt",
  "type": "object"
}
