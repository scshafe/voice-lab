{
  "manifest_version": 1,
  "contract_id": "corpus-client.v1",
  "schema_version": 1,
  "openapi_path": "openapi.json",
  "required_semantics": [
    "device_code_sign_in_without_resource",
    "single_flight_refresh_rotation",
    "standing_approval_and_ledger_entry_before_the_first_byte",
    "corpus_take_v2_in_five_files",
    "canonical_json_byte_for_byte",
    "alsa_continuity_rule_in_integer_nanoseconds",
    "profile_scoped_library_and_history",
    "resumable_chunked_upload",
    "finalize_takes_only_the_clients_profile",
    "decisions_with_stable_request_ids_and_expected_revisions"
  ],
  "examples": [
    {
      "path": "examples/take/manifest.json",
      "schema": "CorpusTakeManifestV2",
      "expected": "valid"
    },
    {
      "path": "examples/take/continuity.json",
      "schema": "AlsaContinuityEvidence",
      "expected": "valid"
    },
    {
      "path": "examples/take/qc.json",
      "schema": "QcReport",
      "expected": "valid"
    },
    {
      "path": "examples/take/READY",
      "schema": "ReadyMarker",
      "expected": "valid"
    },
    {
      "path": "examples/take/original.wav.recipe.json",
      "schema": "WavRecipe",
      "expected": "valid"
    },
    {
      "path": "examples/intake-session-request.json",
      "schema": "IntakeSessionRequest",
      "expected": "valid"
    },
    {
      "path": "examples/home-host-approval.json",
      "schema": "HomeHostApproval",
      "expected": "valid"
    },
    {
      "path": "examples/home-host-binding.json",
      "schema": "HomeHostBinding",
      "expected": "valid"
    },
    {
      "path": "examples/home-host-ledger-upload-started.json",
      "schema": "HomeHostLedgerEntry",
      "expected": "valid"
    },
    {
      "path": "examples/take-decision-request.json",
      "schema": "TakeDecisionRequest",
      "expected": "valid"
    },
    {
      "path": "examples/refusal-client-scope.json",
      "schema": "ApiRefusal",
      "expected": "valid"
    },
    {
      "path": "examples/refusal-take-profile-not-allowed.json",
      "schema": "ApiRefusal",
      "expected": "valid"
    },
    {
      "path": "examples/canonical-json-vectors.json",
      "schema": "CanonicalJsonVectors",
      "expected": "valid"
    },
    {
      "path": "examples/invalid/manifest-48-khz.json",
      "schema": "CorpusTakeManifestV2",
      "expected": "invalid",
      "refusal": {
        "where": "the publisher refuses the package: the session's state is refused",
        "message_contains": "takes 16 kHz audio"
      }
    },
    {
      "path": "examples/invalid/manifest-another-vendor.json",
      "schema": "CorpusTakeManifestV2",
      "expected": "invalid",
      "refusal": {
        "where": "the publisher refuses the package: the session's state is refused",
        "message_contains": "Seeed USB device"
      }
    },
    {
      "path": "examples/invalid/manifest-another-product.json",
      "schema": "CorpusTakeManifestV2",
      "expected": "invalid",
      "refusal": {
        "where": "the publisher refuses the package: the session's state is refused",
        "message_contains": "product 0x0022"
      }
    },
    {
      "path": "examples/invalid/continuity-lost-period.json",
      "schema": "AlsaContinuityEvidence",
      "expected": "invalid",
      "refusal": {
        "where": "the publisher refuses the package: the session's state is refused",
        "message_contains": "beyond the tolerance"
      }
    },
    {
      "path": "examples/invalid/take-decision-request-unknown-field.json",
      "schema": "TakeDecisionRequest",
      "expected": "invalid",
      "refusal": {
        "where": "the API answers 422",
        "code": "invalid_request"
      }
    }
  ],
