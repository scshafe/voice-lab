{
  "$defs": {
    "Sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "An ``original.wav`` given by integers, so the repository holds no audio and a client in\nany language makes the same bytes.\n\nThe file is the plain 44-byte PCM header (RIFF, ``WAVE_FORMAT_PCM``: ``wav_header``), then\n``frames`` frames of ``channels`` interleaved samples, frame after frame. The sample of\nchannel ``c`` (from 0) in frame ``f`` (from 0) is ``((f * (c + 3) + offset) % modulus -\ncenter) * (c + 1) * scale``, little-endian and signed, in the width ``format`` gives. Every\nterm is a non-negative integer before the subtraction, so ``%`` means the same in C++ and\nPython.",
  "properties": {
    "center": {
      "minimum": 0,
      "title": "Center",
      "type": "integer"
    },
    "channels": {
      "maximum": 32,
      "minimum": 1,
      "title": "Channels",
      "type": "integer"
    },
    "format": {
      "enum": [
        "S16_LE",
        "S24_3LE",
        "S32_LE"
      ],
      "title": "Format",
      "type": "string"
    },
    "frames": {
      "minimum": 1,
      "title": "Frames",
      "type": "integer"
    },
    "modulus": {
      "minimum": 1,
      "title": "Modulus",
      "type": "integer"
    },
    "offset": {
      "minimum": 0,
      "title": "Offset",
      "type": "integer"
    },
    "rate": {
      "maximum": 384000,
      "minimum": 8000,
      "title": "Rate",
      "type": "integer"
    },
    "recipe": {
      "const": "corpus-client.v1/interleaved-sawtooth",
      "default": "corpus-client.v1/interleaved-sawtooth",
      "title": "Recipe",
      "type": "string"
    },
    "scale": {
      "minimum": 1,
      "title": "Scale",
      "type": "integer"
    },
    "sha256": {
      "$ref": "#/$defs/Sha256"
    },
    "size_bytes": {
      "exclusiveMinimum": 44,
      "title": "Size Bytes",
      "type": "integer"
    }
  },
  "required": [
    "format",
    "rate",
    "channels",
    "frames",
    "offset",
    "modulus",
    "center",
    "scale",
    "sha256",
    "size_bytes"
  ],
  "title": "WavRecipe",
  "type": "object"
}
