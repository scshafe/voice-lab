# Names only, for humans: no tool reads this file. Values are placed on the host
# by the owner's provisioning (`stack env-set voice-journey NAME`), never committed.
TS_AUTHKEY=                  # first join only; blanked once state/tailscale holds the identity
OIDC_CLIENT_ID=              # the voice-journey Pocket ID client (confidential, PKCE)
OIDC_CLIENT_SECRET=
ID_TAILNET_IP=               # the id node's tailscale IPv4 (containers resolve public names only)
NTFY_TAILNET_IP=             # the ntfy node's tailscale IPv4
VJ_MIRROR_GID=               # getent group vj-mirror; must match host.conf GROUPS
# OAUTH2_PROXY_COOKIE_SECRET is generated on the host
# VOICE_JOURNEY_IMAGE is written by each deploy (the pin)
