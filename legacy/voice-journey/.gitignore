# Web SPA build output + deps (the host builds on deploy; repo stays code + manifests)
web/node_modules/
web/dist/

# Generated manifests live in the data root ($VOICE_JOURNEY_DATA/manifests) on the
# server; a local run must not re-add them. Only manifests/chains.json is tracked.
manifests/*
!manifests/chains.json
