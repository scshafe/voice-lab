# Webhook delivery for ended speech jobs (docs/SPEECH_API.md §8, D-046): signs each event
# with its caller's secret (Standard Webhooks) and POSTs it to the job's callback URL, which
# must be on the caller's allowlist under the tailnet suffix and resolve to tailnet
# addresses only; no redirect is followed. Retries at 0, 30 s, 2, 10, 30 and 60 minutes.
#
# Installed by hand with the speech job runner (README.md here). The callers' secrets are
# root-owned files, /etc/voice-lab/speech-webhook-secrets/<caller> (root:root 0600), which
# systemd hands to this unit alone as credentials (LoadCredential=): the delivery process
# reads $CREDENTIALS_DIRECTORY/speech-webhook-secrets_<caller>. No other process of the
# voice-lab user (the API, the job runner) can read them.
#
# Network: the tailnet only, as the JWKS unit; the service user's egress table should also
# name each caller's node:443 (infra host.conf HOST_EGRESS_TAILNET).
[Unit]
Description=voice-lab speech: deliver webhooks (tailnet only)
ConditionPathExists=/etc/voice-lab/speech.json
ConditionPathIsDirectory=/data/voice-lab/state/speech
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=oneshot
User=voice-lab
Group=voice-lab
UMask=0077
ExecStart=/opt/voice-lab/current/bin/voice-lab speech deliver --config /etc/voice-lab/speech.json
LoadCredential=speech-webhook-secrets:/etc/voice-lab/speech-webhook-secrets
TimeoutStartSec=10min
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=100.64.0.0/10 fd7a:115c:a1e0::/48
ProtectSystem=strict
ReadWritePaths=/data/voice-lab/state/speech
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
