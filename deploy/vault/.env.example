# Interpolation only; copy outside Git, chmod 0600, then replace every placeholder.
# Locally built immutable image ID (sha256:64hex); the app image is never pulled.
VAULT_IMAGE=sha256:<reviewed-built-image-id>
# Exactly this version and a reviewed multi-arch digest, supplied with Cole at deployment.
TAILSCALE_IMAGE=tailscale/tailscale:v1.104.2@sha256:<reviewed-index-digest>
# Absolute, symlink-free directories. Data and its data/logs children: UID/GID 10001, 0700.
VAULT_DATA_DIR=<cole-chosen-large-disk-path>
# Persistent sensitive node identity, root-owned 0700 with this sidecar configuration.
VAULT_TS_STATE_DIR=<private-node-state-directory>
# Absolute directory containing the reviewed serve.json; mounted read-only.
VAULT_SERVE_CONFIG_DIR=<reviewed-serve-config-directory>
# Absolute 0600 file owned by UID 10001; configuration contains hashes, never raw tokens.
VAULT_CONFIG_FILE=<private-hashed-configuration-file>
# Only needed with compose.join.yaml; raw key never belongs in this environment file.
TS_AUTHKEY_FILE=<private-single-use-auth-key-file>
