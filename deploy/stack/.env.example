# Names only, for humans: no tool reads this file. Values are placed on the host
# by the owner's provisioning (tools/provision, `stack env-set`), never committed.
TS_AUTHKEY=                 # one-off, single-use, tagged tag:voice-lab (first join only)
OIDC_ISSUER=                # https://id.<tailnet>
OIDC_HOST=                  # id.<tailnet>
OIDC_CLIENT_ID=             # the confidential Pocket ID client `voice-lab` (the door)
OIDC_CLIENT_SECRET=
ID_TAILNET_IP=              # the id node's tailscale IP
VOICE_LAB_FQDN=             # voice-lab.<tailnet>
VOICE_LAB_UID=              # id -u voice-lab
VOICE_LAB_GID=              # id -g voice-lab
VOICE_LAB_SUBJECT=          # Cole's Pocket ID user id: the API's one allowed subject
VOICE_LAB_SPEECH_AUDIENCE=  # the speech caller's token audience (its client id, parley-relay); not a secret
# OAUTH2_PROXY_COOKIE_SECRET is generated on the host
