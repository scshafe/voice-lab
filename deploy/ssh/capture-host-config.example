Host cole-voice-lab-mini
  HostName <mini-tailnet-ip>
  User cole
  IdentityFile ~/.ssh/cole_voice_lab_intake_ed25519
  IdentitiesOnly yes
  BatchMode yes
  StrictHostKeyChecking yes
  UserKnownHostsFile ~/.ssh/known_hosts
  ConnectTimeout 10
  ServerAliveInterval 30
  ServerAliveCountMax 3
  RequestTTY no
  ClearAllForwardings yes
  ForwardAgent no
  ForwardX11 no
  PermitLocalCommand no
