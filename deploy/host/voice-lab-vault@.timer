# Nightly copy to one vault destination: enable it per destination
# (voice-lab-vault@laptop.timer starts voice-lab-vault@laptop.service). The cadence
# is generic; a destination that needs another (the Air's hourly probe, phase 3)
# gets a drop-in for its instance. Persistent= catches up a night the PC was off.
[Unit]
Description=voice-lab vault copy to %i, nightly

[Timer]
OnCalendar=*-*-* 02:30:00
RandomizedDelaySec=30min
Persistent=true

[Install]
WantedBy=timers.target
