#!/bin/sh
set -eu

repo_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$repo_dir"

.venv/bin/ruff format --check .
.venv/bin/ruff check .
.venv/bin/mypy src/cole_voice_lab
.venv/bin/pytest --cov=cole_voice_lab --cov-report=term-missing --cov-branch
.venv/bin/python -m build --no-isolation
.venv/bin/python -m cole_voice_lab.schema --check
.venv/bin/python scripts/guard-private-assets
