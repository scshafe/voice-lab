#!/bin/sh
set -eu

# Verification must not mutate the Homebrew Python prefix whose complete tree
# is checked against the immutable runtime lock by the test suite.
export PYTHONDONTWRITEBYTECODE=1
# Exercise real native widgets without opening operator windows or audio devices.
export QT_QPA_PLATFORM=offscreen

repo_dir=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
cd "$repo_dir"

.venv/bin/ruff format --check .
.venv/bin/ruff check .
.venv/bin/mypy src/cole_voice_lab
# The macOS mirror sender is its own stdlib-only package (apps/mirror, design §5.2).
.venv/bin/mypy apps/mirror/src
# The native app (Swift, Core Audio, launchd) builds and runs only on macOS. On
# another host (the Arch PC) everything else runs, and the tests that need macOS
# itself skip with the reason named (tests/macos_only.py; pytest -ra lists them).
if [ "$(uname -s)" = Darwin ]; then
    scripts/verify-native-recording --suite all
else
    echo "verify: not macOS; skipping the native recording app build and tests" >&2
fi
.venv/bin/python -I -B -m pytest --cov=cole_voice_lab --cov-report=term-missing --cov-branch
.venv/bin/python -I -B -m build --no-isolation
.venv/bin/python -I -B -m cole_voice_lab.schema --check
.venv/bin/python -I -B scripts/guard-private-assets
