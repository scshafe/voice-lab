#!/bin/sh
set -eu

# Verification must not mutate the Homebrew Python prefix whose complete tree
# is checked against the immutable runtime lock by the test suite.
export PYTHONDONTWRITEBYTECODE=1
# Exercise real native widgets without opening operator windows or audio devices.
export QT_QPA_PLATFORM=offscreen

repo_dir=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
cd "$repo_dir"

.venv/bin/ruff format --check .
.venv/bin/ruff check .
.venv/bin/mypy src/cole_voice_lab
# The macOS mirror sender is its own stdlib-only package (apps/mirror, design §5.2).
.venv/bin/mypy apps/mirror/src
# The desktop app is its own distribution (apps/desktop, voice-lab-desktop, D-037).
.venv/bin/mypy apps/desktop/src
# The native app (Swift, Core Audio, launchd) builds and runs only on macOS. On
# another host (the Arch PC) everything else runs, and the tests that need macOS
# itself skip with the reason named (tests/macos_only.py; pytest -ra lists them).
if [ "$(uname -s)" = Darwin ]; then
    scripts/verify-native-recording --suite all
else
    echo "verify: not macOS; skipping the native recording app build and tests" >&2
fi
# In parallel (pytest-xdist, one worker per core), then the `serial` tests alone: they run a
# real service or native process against a deadline. Coverage is appended across both passes
# and checked once, at the end.
.venv/bin/python -I -B -m pytest -n auto -m "not serial" \
    --cov=cole_voice_lab --cov-branch --cov-report= --cov-fail-under=0
.venv/bin/python -I -B -m pytest -m serial \
    --cov=cole_voice_lab --cov-branch --cov-append --cov-report=term-missing
# The desktop app's suite runs on its own, with pytest-qt (apps/desktop/pyproject.toml): its
# screens offscreen against a local /api/v1 on synthetic manifests, a simulated UMIK-1, and
# no audio device. Any Qt or QML warning fails it.
# (Named explicitly: pytest reads testpaths only when run from the rootdir.)
.venv/bin/python -I -B -m pytest -n auto -m "not serial" -c apps/desktop/pyproject.toml \
    apps/desktop/tests --cov=apps/desktop/src/voice_lab_desktop \
    --cov-config=apps/desktop/pyproject.toml --cov-branch --cov-report= --cov-fail-under=0
.venv/bin/python -I -B -m pytest -m serial -c apps/desktop/pyproject.toml apps/desktop/tests \
    --cov=apps/desktop/src/voice_lab_desktop --cov-config=apps/desktop/pyproject.toml \
    --cov-branch --cov-append --cov-report=term-missing
.venv/bin/python -I -B -m build --no-isolation
# Beside the backend in dist/, where guard-private-assets inspects every wheel built.
.venv/bin/python -I -B -m build --no-isolation --outdir dist apps/desktop
.venv/bin/python -I -B -m cole_voice_lab.schema --check
.venv/bin/python -I -B scripts/guard-private-assets
