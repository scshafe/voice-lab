#!/usr/bin/env python3
"""Create a new local macOS app launcher; never replace an existing application.

The launcher uses this checkout's installed Python environment. Its asset root
must already exist and validate as private. This command performs no downloads,
starts no capture, and does not bundle or copy Python, recordings, or model files.
"""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

from cole_voice_lab.desktop_application import create_desktop_application
from cole_voice_lab.errors import VoiceLabError


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--output", type=Path, required=True)
    parser.add_argument("--asset-root", type=Path, required=True)
    parser.add_argument("--python", type=Path, default=Path(sys.executable))
    parser.add_argument("--suite", default="pilot")
    parser.add_argument("--device")
    options = parser.parse_args()
    try:
        output = create_desktop_application(
            options.output,
            python=options.python,
            asset_root=options.asset_root,
            suite=options.suite,
            device=options.device,
        )
    except (VoiceLabError, OSError) as error:
        parser.error(str(error))
    print(json.dumps({"application": str(output), "portable": False}, indent=2))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
