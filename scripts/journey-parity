#!/usr/bin/env python3
"""Parity harness: the pinned Node journey pipeline against its Python port (design §5.3).

Runs every pipeline stage (index, filter, stt, lyric, reclassify, features, journeys:
``buildStages`` of voice-journey's ``src/watchd.mjs``) twice over two identical copies of
one data root (the ``VOICE_JOURNEY_DATA`` layout): once with Node and the voice-journey
tree at the pinned import commit (``git archive 1f236b5 legacy/voice-journey``), once with
``python -m cole_voice_lab.journey.<stage>``. Both runs use the same tool binaries
(``FFMPEG_BIN``, ``WHISPER_CPP_BIN``, ``WHISPER_CPP_MODEL``, ``VOICE_JOURNEY_PYTHON``, the
feature worker), the same approval text and the same pinned timestamps
(``--generated-at``, ``--reclassified-at``, ``--analyzed-at``). The two runs use the same
absolute data-root path one after the other, so every path a manifest records is the same.

After each stage the generated manifests that stage changed are compared, and at the end
every derived artifact (transcripts, feature detail): byte equality first; if the bytes
differ, a structural JSON comparison (key sets, key order, array lengths, types, values;
numbers within the absolute ``--float-tolerance``, by default 0, i.e. exact). A few paths
are known not to be comparable (wall-clock fields no flag pins, the filter's
self-description) or differ by decision (the ``source`` that Voice Memos rows of the index
carry since D-051, which Node never wrote); they are listed in the report with the reason
and counted apart. A rule may also name the one kind of difference and the one Python
value it excuses, so that anything else on the same path still counts.

The report is JSON on standard output (or ``--out``): per stage the exit codes and
timings, per file the two SHA-256 digests and the count of differences by JSON path. It
never carries content: no values, no transcript text, no recording file names. Array
indices are written ``[*]``, object keys that are not schema keys (keys that do not occur
in the Node or Python source) are written ``<key>``, and derived-artifact file names are
replaced by a hash of the name.

Modes:

``--fixture`` (the default) builds a synthetic corpus in a temporary directory: ffmpeg
``lavfi`` audio only (melodies with vibrato, chords, noise, speech-like bursts, silence),
AAC in ``.m4a`` like Voice Memos with ``YYYYMMDD HHMMSS-<8 hex>.m4a`` names over several
years, a mirror manifest, a measurement session, and two rounds (a second sync adds takes
and drops one from the mirror listing). ffmpeg is real; ``whisper-cli`` and the analysis
worker are deterministic fakes written into the temporary directory (the report says so).
``--show-values`` adds concrete paths and both values of the first differences (synthetic
data only).

``--data-root PATH --approval TEXT`` (owner-run, real corpus): reads the data root read
only. The phone drop and the measurement sessions are referenced in place
(``VOICE_JOURNEY_CORPUS_ROOT``, ``VOICE_JOURNEY_MEASUREMENT_DIR``, else
``PATH/corpus/phone`` and ``PATH/corpus/measurement``); only the generated manifests and
the transcript and feature stores are copied, into a private (0700) temporary directory
that is removed at the end, also on failure (``--fresh`` copies nothing and recomputes
everything). The tools come from the environment (the model defaults to
``PATH/models/ggml-medium.bin``, the analysis python to
``PATH/runtimes/analysis/bin/python``, the worker is the package's). Only the report is
printed; stage error output is discarded.

Exit codes: 0 parity (no unexpected difference, every stage ran on both sides), 1
differences or a failed stage, 2 a refused invocation.
"""

from __future__ import annotations

import argparse
import calendar
import contextlib
import hashlib
import io
import json
import os
import re
import shutil
import signal
import subprocess
import sys
import tarfile
import tempfile
import time
from collections.abc import Callable, Iterator, Mapping, Sequence
from dataclasses import dataclass, field
from pathlib import Path
from types import FrameType
from typing import Any

REPO_ROOT = Path(__file__).resolve().parent.parent
PINNED_COMMIT = "1f236b5"
NODE_TREE = "legacy/voice-journey"
REPORT_SCHEMA = "voice-lab.journey-parity-report.v1"
DEFAULT_TIMESTAMP = "2026-01-01T00:00:00.000Z"
FIXTURE_APPROVAL = "journey-parity fixture: synthetic audio only"
GENERATED_MANIFESTS = (
    "recording-index.json",
    "filtering-sample.json",
    "filter-results.json",
    "full-corpus-filter-results.json",
    "local-stt-transcripts.json",
    "local-lyric-indicators.json",
    "local-voice-features.json",
    "song-journeys.json",
)
ARTIFACT_DIRS = ("stt-transcripts", "voice-features")
MAX_EXAMPLES = 40
SIDES = ("node", "python")


class ParityError(Exception):
    """A refused invocation or an environment the harness cannot run in."""


# --------------------------------------------------------------------------- stages


@dataclass(frozen=True)
class Stage:
    key: str
    node_script: str
    python_module: str
    args: tuple[str, ...]


def build_stages(
    *, corpus_root: str, measurement_root: str, approval: str, timestamp: str, worker: str
) -> tuple[Stage, ...]:
    """watchd.mjs ``buildStages`` with the timestamps pinned and the worker named."""
    audio = ("--corpus-root", corpus_root, "--approval", approval, "--generated-at", timestamp)
    return (
        Stage(
            "index",
            "index-recordings.mjs",
            "index",
            (
                "--corpus-root",
                corpus_root,
                "--measurement-root",
                measurement_root,
                "--generated-at",
                timestamp,
            ),
        ),
        Stage("filter", "filter-proof.mjs", "filter", ("analyze-index", *audio)),
        Stage("stt", "local-stt.mjs", "stt", ("transcribe-index", *audio)),
        Stage("lyric", "lyric-indicators.mjs", "lyrics", ("analyze", "--generated-at", timestamp)),
        Stage(
            "reclassify", "reclassify.mjs", "reclassify", ("apply", "--reclassified-at", timestamp)
        ),
        Stage(
            "features", "features.mjs", "features", ("extract-index", *audio, "--worker", worker)
        ),
        Stage("journeys", "journeys.mjs", "journeys", ("analyze", "--analyzed-at", timestamp)),
    )


def stage_command(side: str, stage: Stage, *, node: str, tree: Path, python: str) -> list[str]:
    if side == "node":
        return [node, str(tree / "src" / stage.node_script), *stage.args]
    return [python, "-B", "-m", f"cole_voice_lab.journey.{stage.python_module}", *stage.args]


# ------------------------------------------------------------------- comparison


ANY_VALUE: Any = object()


@dataclass(frozen=True)
class IgnoreRule:
    """Differences in ``file`` at ``path`` (a regex over the general path, its descendants
    included) are counted apart with ``reason``. With ``kind`` the rule excuses only that
    kind of difference at exactly ``path``; with ``python_value`` only that Python value."""

    file: str
    path: str
    reason: str
    kind: str | None = None
    python_value: Any = ANY_VALUE

    def matches(self, file: str, difference: Difference) -> bool:
        if file != self.file or (self.kind is not None and difference.kind != self.kind):
            return False
        if self.python_value is not ANY_VALUE and difference.python != self.python_value:
            return False
        pattern = self.path if self.kind is not None else self.path + r"(?:[.\[].*)?"
        return re.fullmatch(pattern, difference.general) is not None


IGNORE_RULES = (
    IgnoreRule(
        "manifests/full-corpus-filter-results.json",
        r"\$\.updatedAt",
        "wall clock: filter-proof.mjs sets updatedAt to the current time; no flag pins it",
    ),
    IgnoreRule(
        "manifests/local-stt-transcripts.json",
        r"\$\.updatedAt",
        "wall clock: local-stt.mjs sets updatedAt to the current time; no flag pins it",
    ),
    IgnoreRule(
        "manifests/local-lyric-indicators.json",
        r"\$\.sourceTranscripts\.updatedAt",
        "copy of the transcript manifest's wall-clock updatedAt",
    ),
    IgnoreRule(
        "manifests/full-corpus-filter-results.json",
        r"\$\.reclassification\.sources\.results\.updatedAt",
        "reclassify.mjs records the filter results' wall-clock updatedAt",
    ),
    IgnoreRule(
        "manifests/local-voice-features.json",
        r"\$\.sourceResults\.updatedAt",
        "copy of the filter results' wall-clock updatedAt",
    ),
    IgnoreRule(
        "manifests/full-corpus-filter-results.json",
        r"\$\.toolChoices\[\*\]\.(?:name|version|notes)",
        "deliberate (filter.py docstring): the DSP tool choice names the Python implementation",
    ),
    IgnoreRule(
        "manifests/recording-index.json",
        r"\$\.recordings\[\*\]\.source",
        "deliberate (D-051, Recording v1 step 7): every row says its source; Voice Memos "
        "rows gain {type: voice-memos}, which Node never wrote (index.py docstring)",
        kind="extraInPython",
        python_value={"type": "voice-memos"},
    ),
)


@dataclass
class Difference:
    general: str
    concrete: str
    kind: str
    node: Any = None
    python: Any = None


@dataclass
class Comparison:
    differences: list[Difference] = field(default_factory=list)
    tolerated: int = 0


_SAFE_KEY = re.compile(r"[A-Za-z_][A-Za-z0-9_]{0,63}")
_YEAR_KEY = re.compile(r"(?:19|20)\d\d(?:-Q[1-4])?|unknown")
_SOURCE_TOKENS = (
    re.compile(r"""["'`]([A-Za-z_][A-Za-z0-9_]*)["'`]"""),
    re.compile(r"\b([A-Za-z_][A-Za-z0-9_]*)\s*:"),
    re.compile(r"\.([A-Za-z_][A-Za-z0-9_]*)\b"),
)


def schema_keys(sources: Sequence[Path]) -> frozenset[str]:
    """Identifiers in key positions (quoted, before a colon, after a dot) of the code."""
    keys: set[str] = set()
    for source in sources:
        text = source.read_text(encoding="utf-8")
        text = re.sub(r"/\*.*?\*/", "", text, flags=re.S)
        lines = [re.sub(r"(?:^|\s)(?://|#).*$", "", line) for line in text.splitlines()]
        for pattern in _SOURCE_TOKENS:
            for line in lines:
                keys.update(pattern.findall(line))
    return frozenset(keys)


def general_path(segments: Sequence[str | int], allowed: frozenset[str] | None) -> str:
    """The content-free form of a JSON path: ``[*]`` for indices, ``<key>`` for non-schema
    keys (every key is kept when ``allowed`` is None)."""
    out = "$"
    for segment in segments:
        if isinstance(segment, int):
            out += "[*]"
        elif allowed is None or (
            (_SAFE_KEY.fullmatch(segment) and segment in allowed) or _YEAR_KEY.fullmatch(segment)
        ):
            out += f".{segment}"
        else:
            out += ".<key>"
    return out


def concrete_path(segments: Sequence[str | int]) -> str:
    out = "$"
    for segment in segments:
        if isinstance(segment, int):
            out += f"[{segment}]"
        elif _SAFE_KEY.fullmatch(segment):
            out += f".{segment}"
        else:
            out += f"[{json.dumps(segment)}]"
    return out


def _kind_of(value: Any) -> str:
    if value is None:
        return "null"
    if isinstance(value, bool):
        return "boolean"
    if isinstance(value, int | float):
        return "number"
    if isinstance(value, str):
        return "string"
    if isinstance(value, list):
        return "array"
    return "object"


def compare_json(
    node: Any,
    python: Any,
    *,
    tolerance: float = 0.0,
    allowed: frozenset[str] | None = None,
) -> Comparison:
    """Structural comparison of two parsed JSON documents."""
    result = Comparison()

    def add(segments: list[str | int], kind: str, left: Any, right: Any) -> None:
        result.differences.append(
            Difference(general_path(segments, allowed), concrete_path(segments), kind, left, right)
        )

    def walk(left: Any, right: Any, segments: list[str | int]) -> None:
        left_kind, right_kind = _kind_of(left), _kind_of(right)
        if left_kind != right_kind:
            add(segments, "type", left, right)
        elif left_kind == "object":
            left_keys, right_keys = list(left), list(right)
            for key in left_keys:
                if key not in right:
                    add([*segments, key], "missingInPython", left[key], None)
            for key in right_keys:
                if key not in left:
                    add([*segments, key], "extraInPython", None, right[key])
            common_left = [key for key in left_keys if key in right]
            common_right = [key for key in right_keys if key in left]
            if common_left != common_right:
                add(segments, "keyOrder", common_left, common_right)
            for key in common_left:
                walk(left[key], right[key], [*segments, key])
        elif left_kind == "array":
            if len(left) != len(right):
                add(segments, "length", len(left), len(right))
            for index in range(min(len(left), len(right))):
                walk(left[index], right[index], [*segments, index])
        elif left_kind == "number":
            if left != right:
                if tolerance > 0 and abs(float(left) - float(right)) <= tolerance:
                    result.tolerated += 1
                else:
                    add(segments, "value", left, right)
        elif left != right:
            add(segments, "value", left, right)

    walk(node, python, [])
    return result


def _sha256(path: Path | None) -> str | None:
    if path is None or not path.is_file():
        return None
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for block in iter(lambda: handle.read(1 << 20), b""):
            digest.update(block)
    return digest.hexdigest()


def _load_json(path: Path) -> tuple[bool, Any]:
    def refuse(token: str) -> Any:
        raise ValueError(token)

    try:
        return True, json.loads(path.read_text(encoding="utf-8"), parse_constant=refuse)
    except (UnicodeDecodeError, ValueError):
        return False, None


def compare_file(
    label: str,
    node_path: Path | None,
    python_path: Path | None,
    *,
    tolerance: float,
    allowed: frozenset[str] | None,
    rules: Sequence[IgnoreRule] = IGNORE_RULES,
    show_values: bool = False,
) -> dict[str, Any]:
    """One file's report entry: digests, byte equality and differences by general path."""
    node_digest, python_digest = _sha256(node_path), _sha256(python_path)
    entry: dict[str, Any] = {
        "file": label,
        "nodeSha256": node_digest,
        "pythonSha256": python_digest,
        "byteIdentical": node_digest is not None and node_digest == python_digest,
    }
    differences: list[Difference] = []
    tolerated = 0
    if entry["byteIdentical"]:
        pass
    elif node_digest is None or python_digest is None:
        side = "missingInNode" if node_digest is None else "missingInPython"
        differences.append(Difference("$", "$", side))
    else:
        assert node_path is not None and python_path is not None
        node_ok, node_doc = _load_json(node_path)
        python_ok, python_doc = _load_json(python_path)
        if node_ok and python_ok:
            comparison = compare_json(node_doc, python_doc, tolerance=tolerance, allowed=allowed)
            differences, tolerated = comparison.differences, comparison.tolerated
            if not differences and not tolerated:
                differences.append(Difference("$", "$", "formatting"))
        else:
            differences.append(Difference("$", "$", "bytes"))
    by_path: dict[str, dict[str, Any]] = {}
    ignored: dict[str, dict[str, Any]] = {}
    unexpected: list[Difference] = []
    for difference in differences:
        rule = next((r for r in rules if r.matches(label, difference)), None)
        bucket = by_path if rule is None else ignored
        slot = bucket.setdefault(difference.general, {"count": 0, "kinds": {}})
        slot["count"] += 1
        slot["kinds"][difference.kind] = slot["kinds"].get(difference.kind, 0) + 1
        if rule is None:
            unexpected.append(difference)
        else:
            slot["reason"] = rule.reason
    entry["differences"] = len(unexpected)
    entry["ignoredDifferences"] = sum(slot["count"] for slot in ignored.values())
    entry["toleratedDifferences"] = tolerated
    entry["byPath"] = dict(sorted(by_path.items()))
    if ignored:
        entry["ignoredByPath"] = dict(sorted(ignored.items()))
    if show_values and unexpected:
        entry["examples"] = [
            {"path": d.concrete, "kind": d.kind, "node": d.node, "python": d.python}
            for d in unexpected[:MAX_EXAMPLES]
        ]
    return entry


def artifact_label(relative: Path, *, reveal: bool) -> str:
    """``artifacts/<store>/#<hash><ext>``: no recording names unless ``reveal``."""
    parts = relative.parts
    if reveal:
        return "artifacts/" + "/".join(parts)
    store = parts[0] if len(parts) > 1 and parts[0] in ARTIFACT_DIRS else None
    name = "/".join(parts[1:] if store else parts)
    hashed = "#" + hashlib.sha256(name.encode("utf-8")).hexdigest()[:16]
    suffix = Path(name).suffix if re.fullmatch(r"\.[a-z]{1,5}", Path(name).suffix) else ""
    return f"artifacts/{store}/{hashed}{suffix}" if store else f"artifacts/{hashed}{suffix}"


def manifest_label(name: str) -> str:
    if name in GENERATED_MANIFESTS:
        return f"manifests/{name}"
    return "manifests/#" + hashlib.sha256(name.encode("utf-8")).hexdigest()[:16]


# ---------------------------------------------------------------- the two runs


@dataclass
class StageRun:
    exit_code: int | None = None
    seconds: float = 0.0
    stderr_tail: str = ""


@dataclass
class Plan:
    """What the runs need: where the corpus is, the template data root, the tools."""

    template: Path
    corpus_root: Path
    measurement_root: Path
    env: dict[str, str]
    worker: Path
    approval: str
    rounds: list[Callable[[], None]]
    tools: dict[str, str]
    corpus: dict[str, Any] = field(default_factory=dict)


def _tree_files(root: Path) -> dict[str, str]:
    if not root.is_dir():
        return {}
    return {
        path.relative_to(root).as_posix(): _sha256(path) or ""
        for path in sorted(root.rglob("*"))
        if path.is_file()
    }


def run_side(
    side: str,
    plan: Plan,
    stages: Sequence[Stage],
    *,
    work: Path,
    node: str,
    tree: Path,
    python: str,
) -> list[list[StageRun]]:
    """Run every round of every stage for one side at ``work/run``; snapshot the manifests
    after each stage into ``work/snap/<side>/<round>-<index>``; move the result to
    ``work/out/<side>``."""
    run_root = work / "run"
    if run_root.exists():
        shutil.rmtree(run_root)
    shutil.copytree(plan.template, run_root, symlinks=True)
    cwd = work / "cwd"
    cwd.mkdir(exist_ok=True)
    env = dict(plan.env)
    env["VOICE_JOURNEY_DATA"] = str(run_root)
    if side == "python":
        source = str(REPO_ROOT / "src")
        env["PYTHONPATH"] = source + (
            os.pathsep + env["PYTHONPATH"] if env.get("PYTHONPATH") else ""
        )
    runs: list[list[StageRun]] = []
    failed = False
    for round_index, prepare in enumerate(plan.rounds):
        prepare()
        round_runs: list[StageRun] = []
        for stage_index, stage in enumerate(stages):
            record = StageRun()
            if not failed:
                command = stage_command(side, stage, node=node, tree=tree, python=python)
                started = time.monotonic()
                completed = subprocess.run(
                    command,
                    cwd=cwd,
                    env=env,
                    stdin=subprocess.DEVNULL,
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.PIPE,
                    check=False,
                )
                record.seconds = round(time.monotonic() - started, 3)
                record.exit_code = completed.returncode
                record.stderr_tail = completed.stderr.decode("utf-8", "replace")[-2000:]
                failed = completed.returncode != 0
                snapshot = work / "snap" / side / f"{round_index}-{stage_index}"
                shutil.copytree(run_root / "manifests", snapshot, dirs_exist_ok=True)
            round_runs.append(record)
        runs.append(round_runs)
    out = work / "out" / side
    out.parent.mkdir(parents=True, exist_ok=True)
    run_root.rename(out)
    return runs


def compare_runs(
    plan: Plan,
    stages: Sequence[Stage],
    runs: Mapping[str, list[list[StageRun]]],
    *,
    work: Path,
    tolerance: float,
    allowed: frozenset[str] | None,
    show_values: bool,
) -> tuple[list[dict[str, Any]], list[dict[str, Any]]]:
    """Per stage, the manifests it changed on either side; then every derived artifact."""
    stage_reports: list[dict[str, Any]] = []
    previous = {side: _tree_files(plan.template / "manifests") for side in SIDES}
    for round_index in range(len(plan.rounds)):
        for stage_index, stage in enumerate(stages):
            snaps = {side: work / "snap" / side / f"{round_index}-{stage_index}" for side in SIDES}
            current = {side: _tree_files(snaps[side]) for side in SIDES}
            changed = sorted(
                {
                    name
                    for side in SIDES
                    for name, digest in current[side].items()
                    if previous[side].get(name) != digest
                }
            )
            files = [
                compare_file(
                    manifest_label(name),
                    snaps["node"] / name if name in current["node"] else None,
                    snaps["python"] / name if name in current["python"] else None,
                    tolerance=tolerance,
                    allowed=allowed,
                    show_values=show_values,
                )
                for name in changed
            ]
            sides: dict[str, Any] = {}
            for side in SIDES:
                record = runs[side][round_index][stage_index]
                sides[side] = {"exitCode": record.exit_code, "seconds": record.seconds}
                if show_values and record.exit_code:
                    sides[side]["stderrTail"] = record.stderr_tail
            ran = all(sides[side]["exitCode"] == 0 for side in SIDES)
            differences = sum(entry["differences"] for entry in files)
            stage_reports.append(
                {
                    "round": round_index + 1,
                    "stage": stage.key,
                    "result": (
                        "failed" if not ran else "identical" if not differences else "differences"
                    ),
                    **sides,
                    "files": files,
                }
            )
            previous = {side: current[side] or previous[side] for side in SIDES}
    artifacts: list[dict[str, Any]] = []
    roots = {side: work / "out" / side / "artifacts" for side in SIDES}
    names = sorted(
        {
            path.relative_to(roots[side])
            for side in SIDES
            if roots[side].is_dir()
            for path in roots[side].rglob("*")
            if path.is_file()
        }
    )
    for relative in names:
        node_file, python_file = roots["node"] / relative, roots["python"] / relative
        artifacts.append(
            compare_file(
                artifact_label(relative, reveal=show_values),
                node_file if node_file.is_file() else None,
                python_file if python_file.is_file() else None,
                tolerance=tolerance,
                allowed=allowed,
                show_values=show_values,
            )
        )
    return stage_reports, artifacts


# ------------------------------------------------------------------- the Node tree


def commit_available(commit: str = PINNED_COMMIT, repo: Path = REPO_ROOT) -> bool:
    if shutil.which("git") is None:
        return False
    probe = subprocess.run(
        ["git", "-C", str(repo), "cat-file", "-e", f"{commit}^{{commit}}"],
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
    )
    return probe.returncode == 0


def extract_node_tree(destination: Path, commit: str) -> Path:
    if not commit_available(commit):
        raise ParityError(f"commit {commit} is not available in {REPO_ROOT} (shallow clone?)")
    archive = subprocess.run(
        ["git", "-C", str(REPO_ROOT), "archive", "--format=tar", commit, NODE_TREE],
        stdin=subprocess.DEVNULL,
        capture_output=True,
        check=True,
    )
    with tarfile.open(fileobj=io.BytesIO(archive.stdout)) as bundle:
        bundle.extractall(destination, filter="data")
    tree = destination / NODE_TREE
    if not (tree / "src" / "watchd.mjs").is_file():
        raise ParityError(f"{NODE_TREE} at {commit} has no src/watchd.mjs")
    return tree


# --------------------------------------------------------------------- real corpus


def _inside(path: Path, root: Path) -> bool:
    return path == root or root in path.parents


def real_plan(args: argparse.Namespace, work: Path) -> Plan:
    if not args.approval:
        raise ParityError("--data-root requires --approval TEXT (the stages read audio)")
    data_root = Path(args.data_root).resolve()
    repo = REPO_ROOT.resolve()
    if _inside(data_root, repo) or _inside(repo, data_root):
        raise ParityError("refusing a data root inside the repository (or containing it)")
    if not data_root.is_dir():
        raise ParityError("the data root is not a directory")
    environ = os.environ
    corpus_root = Path(
        args.corpus_root
        or environ.get("VOICE_JOURNEY_CORPUS_ROOT")
        or data_root / "corpus" / "phone"
    ).resolve()
    measurement_root = Path(
        environ.get("VOICE_JOURNEY_MEASUREMENT_DIR") or data_root / "corpus" / "measurement"
    ).resolve()
    for name, path in (("corpus root", corpus_root), ("measurement root", measurement_root)):
        if _inside(path, repo):
            raise ParityError(f"refusing a {name} inside the repository")
    if not corpus_root.is_dir():
        raise ParityError("the corpus root is not a directory")
    template = work / "template"
    (template / "manifests").mkdir(parents=True)
    (template / "artifacts").mkdir()
    if not args.fresh:
        for name in GENERATED_MANIFESTS:
            source = data_root / "manifests" / name
            if source.is_file():
                shutil.copy2(source, template / "manifests" / name)
        for store in ARTIFACT_DIRS:
            source = data_root / "artifacts" / store
            if source.is_dir():
                shutil.copytree(source, template / "artifacts" / store, symlinks=True)
    worker = REPO_ROOT / "src" / "cole_voice_lab" / "resources" / "journey_extract_features.py"
    env = _base_env(work)
    env.update(
        FFMPEG_BIN=environ.get("FFMPEG_BIN", "ffmpeg"),
        WHISPER_CPP_BIN=environ.get("WHISPER_CPP_BIN", "whisper-cli"),
        WHISPER_CPP_MODEL=environ.get(
            "WHISPER_CPP_MODEL", str(data_root / "models" / "ggml-medium.bin")
        ),
        VOICE_JOURNEY_PYTHON=environ.get(
            "VOICE_JOURNEY_PYTHON", str(data_root / "runtimes" / "analysis" / "bin" / "python")
        ),
    )
    if environ.get("WHISPER_CPP_THREADS"):
        env["WHISPER_CPP_THREADS"] = environ["WHISPER_CPP_THREADS"]
    return Plan(
        template=template,
        corpus_root=corpus_root,
        measurement_root=measurement_root,
        env=env,
        worker=worker,
        approval=args.approval,
        rounds=[lambda: None],
        tools={
            "ffmpeg": "environment (FFMPEG_BIN)",
            "whisperCli": "environment (WHISPER_CPP_BIN, WHISPER_CPP_MODEL)",
            "analysisWorker": "package resources/journey_extract_features.py in "
            "VOICE_JOURNEY_PYTHON",
        },
        corpus={"fresh": bool(args.fresh)},
    )


def _base_env(work: Path) -> dict[str, str]:
    """The inherited environment minus every pipeline variable, with a private TMPDIR."""
    prefixes = ("VOICE_JOURNEY_", "WHISPER_CPP_", "FFMPEG_BIN")
    env = {key: value for key, value in os.environ.items() if not key.startswith(prefixes)}
    env.pop("PYTHONPATH", None)
    tmp = work / "tmp"
    tmp.mkdir(exist_ok=True)
    env.update(TMPDIR=str(tmp), TZ="UTC", LC_ALL="C.UTF-8", PYTHONDONTWRITEBYTECODE="1")
    return env


