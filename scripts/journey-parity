)
FIXTURE_HELD_BACK = ("20221010 101010", "melody", "A", 3.0, 210.0, 12.0, 5.5, 1)
FIXTURE_SAMPLE_RATE = 44100


def _suffix(stamp: str, index: int) -> str:
    return hashlib.sha256(f"{stamp}#{index}".encode()).hexdigest()[:8].upper()


def _chain(variable: str, values: Sequence[float]) -> str:
    expression = repr(float(values[-1]))
    for index in range(len(values) - 2, -1, -1):
        expression = f"if(eq({variable},{index}),{float(values[index])!r},{expression})"
    return expression


def _melody_expression(song: Song, base: float, detune: float, vibrato: float) -> str:
    note = song.note_seconds
    pitch = _chain("ld(2)", [float(step) for step in song.pattern])
    cents = _chain("ld(3)", [detune * factor for factor in (1.0, -1.0, 0.5, -0.5, 0.0)])
    frequency = f"{base!r}*pow(2,(ld(1)+30/100*sin(2*PI*{vibrato!r}*t))/12)"
    gate = f"if(lt(mod(t,{note!r}),{note * 0.85!r}),1,0)"
    return (
        f"st(2,mod(floor(t/{note!r}),{len(song.pattern)}));st(3,mod(floor(t/{note!r}),5));"
        f"st(1,{pitch}+{cents}/100);st(0,ld(0)+2*PI*{frequency}/{FIXTURE_SAMPLE_RATE});"
        f"0.45*{gate}*(sin(ld(0))+0.25*sin(2*ld(0)))"
    )


def _source_args(
    kind: str, song: str, seconds: float, base: float, detune: float, rate: float, seed: int
) -> list[str]:
    sr = FIXTURE_SAMPLE_RATE
    kind = FIXTURE_KINDS[kind][0]
    if kind in ("melody", "mixed"):
        expression = _melody_expression(SONGS[song], base, detune, rate)
        if kind == "mixed":
            cut = round(seconds * 0.35, 3)
            expression = f"if(lt(t,{cut!r}),({expression}),0.08*(2*random(4)-1))"
        return ["-f", "lavfi", "-i", f"aevalsrc=exprs='{expression}':s={sr}:d={seconds!r}"]
    if kind == "chord":
        chord = (
            f"0.2*(sin(2*PI*{base!r}*t)+sin(2*PI*{base * 1.25!r}*t)+sin(2*PI*{base * 1.5!r}*t))"
            "*(0.8+0.2*sin(2*PI*0.5*t))"
        )
        return ["-f", "lavfi", "-i", f"aevalsrc=exprs='{chord}':s={sr}:d={seconds!r}"]
    if kind in ("noise", "speech"):
        color = "white" if kind == "noise" else "pink"
        source = f"anoisesrc=d={seconds!r}:c={color}:r={sr}:a=0.25:seed={seed}"
        if kind == "speech":
            source += ",volume='if(lt(mod(t,0.37),0.21),1,0.04)':eval=frame"
        return ["-f", "lavfi", "-i", source]
    return ["-f", "lavfi", "-i", f"anullsrc=r={sr}:cl=mono", "-t", repr(seconds)]


def _encode(ffmpeg: str, source: list[str], out: Path) -> None:
    command = [
        ffmpeg, "-hide_banner", "-nostdin", "-v", "error", "-y", *source,
        "-ac", "1", "-c:a", "aac", "-b:a", "96k", "-map_metadata", "-1",
        "-fflags", "+bitexact", "-flags:a", "+bitexact", str(out),
    ]  # fmt: skip
    subprocess.run(command, check=True, stdin=subprocess.DEVNULL, capture_output=True)


def _recording_id(filename: str) -> str:
    return hashlib.sha256(filename.encode("utf-8")).hexdigest()[:16]


def _mirror_manifest(
    directory: Path, names: Sequence[str], run_id: str, sizes: Mapping[str, int]
) -> None:
    files = []
    for name in names:
        files.append(
            {
                "path": name,
                "sizeBytes": sizes.get(name, (directory / name).stat().st_size),
                "sha256": _sha256(directory / name),
            }
        )
    manifest = {
        "schema": "voice-journey-mirror-manifest/1",
        "runId": run_id,
        "generatedAt": DEFAULT_TIMESTAMP,
        "files": files,
    }
    mirror = directory / "_mirror"
    mirror.mkdir(exist_ok=True)
    (mirror / "latest.json").write_text(json.dumps(manifest, indent=2) + "\n", encoding="utf-8")


def fixture_plan(work: Path, *, ffmpeg: str) -> Plan:
    """Synthesize the corpus, the fakes and the empty template data root."""
    fixture = work / "fixture"
    audio = fixture / "audio"
    audio.mkdir(parents=True)
    takes: dict[str, dict[str, Any]] = {}
    files: list[tuple[str, int, int]] = []  # (name, round, mtime ns)
    specs = [*((take, False) for take in FIXTURE_TAKES), (FIXTURE_HELD_BACK, True)]
    for index, ((stamp, kind, song, seconds, base, detune, rate, round_no), held) in enumerate(
        specs
    ):
        name = f"{stamp}-{_suffix(stamp, index)}.m4a"
        _encode(
            ffmpeg, _source_args(kind, song, seconds, base, detune, rate, index + 1), audio / name
        )
        mtime_ns = (
            calendar.timegm(time.strptime(stamp, "%Y%m%d %H%M%S")) + int(seconds) + 1
        ) * 10**9
        mtime_ns += 123_456_789 + index * 1_000_501
        files.append((name, round_no, mtime_ns))
        text = FIXTURE_KINDS[kind][1]
        language = "la" if text == "vocalise" else "en"
        takes[_recording_id(name)] = {"text": text, "song": song, "language": language}
        if held:
            held_name = name
    corpus = fixture / "data" / "corpus"
    phone = corpus / "phone"
    measurement = corpus / "measurement"
    session = measurement / "fixture-session-2021"
    session.mkdir(parents=True)
    subprocess.run(
        [ffmpeg, "-hide_banner", "-nostdin", "-v", "error", "-y", "-f", "lavfi", "-i",
         "sine=frequency=220:sample_rate=48000:duration=1", "-c:a", "pcm_s16le",
         "-fflags", "+bitexact", "-flags:a", "+bitexact", str(session / "seg-01.wav")],
        check=True, stdin=subprocess.DEVNULL, capture_output=True,
    )  # fmt: skip
    (session / "session.json").write_text(
        json.dumps(
            {
                "chainId": "umik1",
                "startedAt": "2021-05-01T10:00:00.000Z",
                "files": [{"name": "seg-01.wav"}, {"name": "seg-02.wav"}],
                "segments": [{"file": "seg-01.wav", "key": "sustain-a"}],
            },
            indent=2,
        )
        + "\n",
        encoding="utf-8",
    )
    os.utime(session / "seg-01.wav", ns=(1_619_863_200_500_000_000,) * 2)
    round_one = [name for name, round_no, _ in files if round_no == 1]
    newest_round_one = max(round_one)
    dropped = sorted(round_one)[5]

    def populate(round_no: int) -> None:
        if phone.exists():
            shutil.rmtree(phone)
        phone.mkdir(parents=True)
        for name, file_round, mtime_ns in files:
            if file_round <= round_no:
                shutil.copyfile(audio / name, phone / name)
                os.utime(phone / name, ns=(mtime_ns, mtime_ns))
        (phone / f".{round_one[0]}.Xy12Ab").write_bytes(b"partial")
        (phone / ".rsync-partial").mkdir()
        (phone / "notes.txt").write_text("not a recording\n", encoding="utf-8")
        present = sorted(name for name, file_round, _ in files if file_round <= round_no)
        if round_no == 1:
            listed = [name for name in present if name != newest_round_one]
        else:
            listed = [name for name in present if name != dropped]
        sizes = {held_name: (phone / held_name).stat().st_size + 1}
        _mirror_manifest(phone, listed, f"fixture-round-{round_no}", sizes)

    bin_dir = fixture / "bin"
    bin_dir.mkdir()
    plan_path = fixture / "whisper-plan.json"
    plan_path.write_text(
        json.dumps(
            {
                "songs": {key: list(song.lines) for key, song in SONGS.items()},
                "speech": list(SPEECH_LINES),
                "repeat": REPEAT_LINE,
                "takes": takes,
            },
            indent=2,
        ),
        encoding="utf-8",
    )
    whisper_source = fixture / "fake_whisper.py"
    whisper_source.write_text(
        FAKE_WHISPER.replace("@PLAN@", json.dumps(str(plan_path))), encoding="utf-8"
    )
    whisper = bin_dir / "whisper-cli"
    whisper.write_text(
        f'#!/bin/sh\nexec "{sys.executable}" -B "{whisper_source}" "$@"\n', encoding="utf-8"
    )
    whisper.chmod(0o755)
    worker = fixture / "fake_extract_features.py"
    worker.write_text(FAKE_WORKER, encoding="utf-8")
    model = fixture / "models" / "ggml-fixture.bin"
    model.parent.mkdir()
    model.write_bytes(b"not a model: the fixture whisper-cli only checks that it exists\n")
    template = fixture / "template"
    (template / "manifests").mkdir(parents=True)
    (template / "artifacts").mkdir()
    env = _base_env(work)
    env.update(
        FFMPEG_BIN=ffmpeg,
        WHISPER_CPP_BIN=str(whisper),
        WHISPER_CPP_MODEL=str(model),
        VOICE_JOURNEY_PYTHON=sys.executable,
    )
    version = (
        subprocess.run(
            [ffmpeg, "-version"], capture_output=True, check=True, stdin=subprocess.DEVNULL
        )
        .stdout.decode("utf-8", "replace")
        .splitlines()[0]
    )
    return Plan(
        template=template,
        corpus_root=phone,
        measurement_root=measurement,
        env=env,
        worker=worker,
        approval=FIXTURE_APPROVAL,
        rounds=[lambda: populate(1), lambda: populate(2)],
        tools={
            "ffmpeg": f"real: {version}",
            "whisperCli": "fake: deterministic fixture whisper-cli (text from a per-take plan "
            "of lyric lines, segment times from the decoded wav)",
            "analysisWorker": "fake: deterministic stdlib worker on the extractor's protocol "
            "(zero-crossing f0 contour; hashed quality and spectral numbers)",
        },
        corpus={
            "recordings": len(files),
            "rounds": 2,
            "years": sorted({stamp[:4] for stamp, *_ in FIXTURE_TAKES}),
            "kinds": sorted({kind for _, kind, *_ in FIXTURE_TAKES}),
            "measurementSessions": 1,
        },
    )


FAKE_WHISPER = r'''
"""Fixture whisper-cli: deterministic outputs shaped like whisper.cpp's -otxt/-oj."""

import array
import hashlib
import json
import math
import os
import sys
import wave

PLAN = @PLAN@


def stamp(ms):
    hours, rest = divmod(ms, 3_600_000)
    minutes, rest = divmod(rest, 60_000)
    seconds, millis = divmod(rest, 1000)
    return f"{hours:02d}:{minutes:02d}:{seconds:02d},{millis:03d}"


def main(argv):
    if "--version" in argv:
        print("whisper-cli fixture 1.7.6 (voice-lab journey parity fake)")
        return 0
    options, flags, index = {}, set(), 0
    while index < len(argv):
        arg = argv[index]
        if arg in ("-m", "-f", "-l", "-of", "-t"):
            options[arg] = argv[index + 1]
            index += 2
        elif arg in ("-otxt", "-oj"):
            flags.add(arg)
            index += 1
        else:
            sys.stderr.write(f"error: unknown argument: {arg}\n")
            return 2
    if not os.path.isfile(options.get("-m", "")):
        sys.stderr.write("error: failed to load model\n")
        return 3
    with wave.open(options["-f"], "rb") as handle:
        rate = handle.getframerate()
        data = handle.readframes(handle.getnframes())
    samples = array.array("h")
    samples.frombytes(data)
    if sys.byteorder == "big":
        samples.byteswap()
    duration_ms = int(len(samples) * 1000 / rate)
    energy = math.sqrt(sum(s * s for s in samples) / max(1, len(samples))) / 32768
    digest = hashlib.sha256(data).digest()
    base = options["-of"]
    with open(PLAN, encoding="utf-8") as handle:
        plan = json.load(handle)
    take = plan["takes"].get(
        os.path.basename(base), {"text": "speech", "song": "", "language": "en"}
    )
    language = take["language"] if options.get("-l", "auto") == "auto" else options["-l"]
    lines = []
    if energy < 0.003:
        lines = []
    elif take["text"] == "vocalise":
        lines = ["Ah, ah, ooh, ah.", "Ooh, ah, ah."][: 1 + digest[0] % 2]
    elif take["text"] == "speech":
        lines = [plan["speech"][digest[1] % len(plan["speech"])]]
    elif take["text"] == "repeat":
        lines = [plan["repeat"], plan["repeat"]]
    elif take["text"] == "song":
        song = plan["songs"][take["song"]]
        count = max(2, min(len(song), round(duration_ms / 1500)))
        lines = list(song[:count])
        if digest[2] % 3 == 0:
            words = lines[-1].split()
            lines[-1] = " ".join(words[:-1])
    else:
        lines = ["[noise]"] if digest[3] % 2 else []
    segments = []
    for number, line in enumerate(lines):
        start = number * duration_ms // max(1, len(lines))
        end = (number + 1) * duration_ms // max(1, len(lines))
        segments.append(
            {
                "timestamps": {"from": stamp(start), "to": stamp(end)},
                "offsets": {"from": start, "to": end},
                "text": " " + line,
            }
        )
    payload = {
        "systeminfo": "AVX = 1 | AVX2 = 1 | FMA = 1 | fixture",
        "model": {"type": "medium", "multilingual": True, "vocab": 51865, "ftype": 1},
        "params": {"model": options["-m"], "language": language, "translate": False},
        "result": {"language": language},
        "transcription": segments,
    }
    if "-oj" in flags:
        with open(base + ".json", "w", encoding="utf-8") as handle:
            handle.write(json.dumps(payload, indent="\t", ensure_ascii=False) + "\n")
    if "-otxt" in flags:
        with open(base + ".txt", "w", encoding="utf-8") as handle:
            handle.write("".join(segment["text"] + "\n" for segment in segments))
    return 0


sys.exit(main(sys.argv[1:]))
'''

FAKE_WORKER = r'''
"""Fixture feature worker: the extractor's stdin/stdout protocol, stdlib only."""

import array
import hashlib
import json
import math
import sys
import wave
from bisect import bisect_left, bisect_right

CONFIG = {
    "sampleRate": 22050,
    "f0": {
        "engine": "praat_ac",
        "floorHz": 75.0,
        "ceilingHz": 1200.0,
        "timeStepSeconds": 0.01,
        "outlier": {
            "windowSeconds": 0.5,
            "maxDeviationCents": 600.0,
            "maxGlobalDeviationCents": 1800.0,
        },
    },
    "vibrato": {
        "minSustainSeconds": 0.8,
        "bandHz": [3.5, 8.5],
        "minExtentCents": 15.0,
        "minBandPowerShare": 0.2,
        "detrendWindowSeconds": 0.5,
    },
    "tuning": {"referenceHz": 440.0, "inTuneCents": 25.0},
    "spectral": {
        "nFft": 2048,
        "hopSeconds": 0.01,
        "singerFormantBandHz": [2800.0, 3400.0],
        "rolloffShare": 0.85,
    },
    "phrasing": {"minPauseSeconds": 0.3},
    "methodId": "voice-journey.feature-extract.v1",
}
VERSIONS = {
    "python": "fixture",
    "parselmouth": None,
    "praat": None,
    "librosa": None,
    "numpy": "fixture-worker-1",
}


def rnd(value, places=3):
    if value is None:
        return None
    value = float(value)
    if math.isnan(value) or math.isinf(value):
        return None
    return round(value, places)


def percentile(ordered, q):
    position = (len(ordered) - 1) * q / 100.0
    low = math.floor(position)
    high = min(low + 1, len(ordered) - 1)
    return ordered[low] + (ordered[high] - ordered[low]) * (position - low)


def median(values):
    return percentile(sorted(values), 50)


def cents(hz):
    return 1200.0 * math.log2(hz / 440.0)


def runs_of(mask):
    runs, start = [], None
    for index, flag in enumerate(mask):
        if flag and start is None:
            start = index
        elif not flag and start is not None:
            runs.append((start, index))
            start = None
    if start is not None:
        runs.append((start, len(mask)))
    return runs


def analyze(path):
    with wave.open(path, "rb") as handle:
        rate = handle.getframerate()
        data = handle.readframes(handle.getnframes())
    samples = array.array("h")
    samples.frombytes(data)
    if sys.byteorder == "big":
        samples.byteswap()
    count = len(samples)
    duration = count / rate
    if duration < 2.5:
        raise ValueError(f"fixture worker refuses takes shorter than 2.5 s ({duration:.2f} s)")
    digest = hashlib.sha256(data).digest()
    unit = [byte / 255.0 for byte in digest]
    squares = [0.0]
    total = 0.0
    for sample in samples:
        total += sample * sample
        squares.append(total)
    crossings = []
    for index in range(1, count):
        before, after = samples[index - 1], samples[index]
        if before < 0 <= after and max(map(abs, samples[index : index + 66])) > 1600:
            crossings.append((index - 1 + (-before) / (after - before)) / rate)
    step = CONFIG["f0"]["timeStepSeconds"]
    half = 0.025
    frames = int(duration / step)
    times, f0, levels = [], [], []
    for frame in range(frames):
        t = (frame + 0.5) * step
        low, high = max(0, int((t - 0.005) * rate)), min(count, int((t + 0.005) * rate))
        level = math.sqrt((squares[high] - squares[low]) / max(1, high - low)) / 32768.0
        first, last = bisect_left(crossings, t - half), bisect_right(crossings, t + half)
        hz = 0.0
        if level > 0.02 and last - first >= 3:
            span = crossings[last - 1] - crossings[first]
            hz = (last - first - 1) / span if span > 0 else 0.0
            if not 75.0 <= hz <= 1200.0:
                hz = 0.0
        times.append(t)
        f0.append(hz)
        levels.append(level)
    raw = [hz > 0 for hz in f0]
    voiced_count = sum(raw)
    mask = list(raw)
    local_rejected = global_rejected = 0
    if voiced_count >= 5:
        window = 50
        for index, flag in enumerate(raw):
            if not flag:
                continue
            around = [
                cents(f0[j])
                for j in range(max(0, index - window), min(frames, index + window + 1))
                if raw[j]
            ]
            if len(around) >= 3 and abs(cents(f0[index]) - median(around)) > 600.0:
                mask[index] = False
                local_rejected += 1
        remaining = [cents(f0[i]) for i in range(frames) if mask[i]]
        if len(remaining) >= 5:
            center = median(remaining)
            for index in range(frames):
                if mask[index] and abs(cents(f0[index]) - center) > 1800.0:
                    mask[index] = False
                    global_rejected += 1
    voiced = [f0[i] for i in range(frames) if mask[i]]
    if len(voiced) >= 5:
        ordered = sorted(voiced)
        pitch = {f"p{q:02d}": rnd(percentile(ordered, q), 1) for q in (5, 25, 50, 75, 95)}
        span = rnd(12.0 * math.log2(percentile(ordered, 95) / percentile(ordered, 5)), 2)
        middle = median(voiced)
        mad = rnd(median([abs(12.0 * math.log2(hz / middle)) for hz in voiced]), 3)
        values = [cents(hz) for hz in voiced]
        if len(values) >= 10:
            angles = [(value % 100.0) * 2.0 * math.pi / 100.0 for value in values]
            offset = (
                math.atan2(
                    sum(map(math.sin, angles)) / len(angles),
                    sum(map(math.cos, angles)) / len(angles),
                )
                * 100.0
                / (2.0 * math.pi)
            )
            deviation = [((value - offset + 50.0) % 100.0) - 50.0 for value in values]
            tuning = {
                "offsetCents": rnd(offset, 1),
                "medianAbsCentError": rnd(median([abs(d) for d in deviation]), 1),
                "within25CentsShare": rnd(sum(abs(d) <= 25.0 for d in deviation) / len(deviation)),
            }
        else:
            tuning = {"offsetCents": None, "medianAbsCentError": None, "within25CentsShare": None}
    else:
        pitch = {f"p{q:02d}": None for q in (5, 25, 50, 75, 95)}
        span = mad = None
        tuning = {"offsetCents": None, "medianAbsCentError": None, "within25CentsShare": None}
    runs = runs_of(mask)
    sustained = [(a, b) for a, b in runs if b - a >= 80]
    segments = []
    vibrato_frames = 0
    for a, b in sustained:
        values = [cents(f0[i]) for i in range(a, b)]
        trend = [
            sum(values[max(0, i - 25) : i + 26]) / len(values[max(0, i - 25) : i + 26])
            for i in range(len(values))
        ]
        residual = [value - smooth for value, smooth in zip(values, trend)]
        changes = sum(1 for x, y in zip(residual, residual[1:]) if (x < 0) != (y < 0))
        rate_hz = changes / 2.0 / ((b - a) * step)
        extent = max(abs(r) for r in residual) * 0.7
        if 3.5 <= rate_hz <= 8.5 and extent >= 15.0:
            vibrato_frames += b - a
            segments.append(
                {
                    "startSeconds": rnd(a * step, 2),
                    "durationSeconds": rnd((b - a) * step, 2),
                    "rateHz": rnd(rate_hz, 2),
                    "extentCents": rnd(extent, 1),
                }
            )
    sustained_frames = sum(b - a for a, b in sustained)
    rates = [segment["rateHz"] for segment in segments]
    extents = [segment["extentCents"] for segment in segments]
    voiced_share = sum(mask) / frames if frames else 0.0
    loud = sorted(20.0 * math.log10(max(levels[i], 1e-5)) for i in range(frames) if mask[i])
    durations = [(b - a) * step for a, b in runs]
    gaps = sum(1 for (_, end), (start, _) in zip(runs, runs[1:]) if (start - end) * step >= 0.3)
    summary = {
        "durationSeconds": rnd(duration),
        "voicing": {
            "voicedShare": rnd(voiced_share),
            "frameCount": frames,
            "rejectedOutlierShare": rnd(local_rejected / voiced_count if voiced_count else 0.0),
            "rejectedGlobalOutlierShare": rnd(
                global_rejected / voiced_count if voiced_count else 0.0
            ),
        },
        "pitch": {"f0Hz": pitch, "rangeSemitonesP05P95": span, "madSemitones": mad},
        "tuning": tuning,
        "vibrato": {
            "sustainedSegmentCount": len(sustained),
            "vibratoSegmentCount": len(segments),
            "meanRateHz": rnd(sum(rates) / len(rates), 2) if rates else None,
            "meanExtentCents": rnd(sum(extents) / len(extents), 1) if extents else None,
            "vibratoTimeShare": rnd(vibrato_frames / sustained_frames)
            if sustained_frames
            else None,
        },
        "quality": {
            "jitterLocal": rnd(0.002 + unit[0] * 0.01, 5),
            "shimmerLocal": rnd(0.02 + unit[1] * 0.06, 5),
            "meanHnrDb": rnd(8.0 + 12.0 * voiced_share + unit[2] * 2.0, 2),
            "cpps": rnd(9.0 + 7.0 * voiced_share - (mad or 0.0) + unit[3] * 3.0, 2),
        },
        "spectral": {
            "centroidHzMean": rnd(900.0 + unit[4] * 900.0, 1),
            "centroidHzSd": rnd(80.0 + unit[5] * 200.0, 1),
            "rolloffHzMean": rnd(2400.0 + unit[6] * 1800.0, 1),
            "singerFormantRatio": rnd(0.001 + unit[7] * 0.05, 4),
        },
        "dynamics": {
            "voicedRmsDbP10": rnd(percentile(loud, 10), 1) if loud else None,
            "voicedRmsDbP50": rnd(percentile(loud, 50), 1) if loud else None,
            "voicedRmsDbP90": rnd(percentile(loud, 90), 1) if loud else None,
            "dynamicSpreadDb": rnd(percentile(loud, 90) - percentile(loud, 10), 1)
            if loud
            else None,
        },
        "phrasing": {
            "longestSustainedSeconds": rnd(max(durations), 2) if durations else None,
            "meanVoicedSegmentSeconds": rnd(sum(durations) / len(durations), 2)
            if durations
            else None,
            "pauseRatePerMinute": rnd(gaps / (duration / 60.0), 2),
        },
    }
    contour = [[rnd(times[i], 2), rnd(f0[i], 1)] for i in range(0, frames, 5) if mask[i]]
    detail = {
        "methodId": CONFIG["methodId"],
        "f0ContourVoiced50ms": contour,
        "vibratoSegments": segments,
        "qualityNotes": [],
        "config": CONFIG,
    }
    return summary, detail


def main():
    sys.stdout.write(
        json.dumps(
            {"hello": {"versions": VERSIONS, "methodId": CONFIG["methodId"], "config": CONFIG}}
        )
        + "\n"
    )
    sys.stdout.flush()
    for line in sys.stdin:
        line = line.strip()
        if not line:
            continue
        task = json.loads(line)
        try:
            summary, detail = analyze(task["wavPath"])
            result = {
                "recordingId": task.get("recordingId"),
                "status": "completed",
                "summary": summary,
                "detail": detail,
            }
        except Exception as error:
            result = {
                "recordingId": task.get("recordingId"),
                "status": "failed",
                "error": f"{type(error).__name__}: {error}",
                "trace": "fixture",
            }
        sys.stdout.write(json.dumps(result) + "\n")
        sys.stdout.flush()


main()
'''


# ---------------------------------------------------------------------------- main


def parse_args(argv: Sequence[str] | None) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        prog="journey-parity",
        description="Compare the pinned Node journey pipeline with the Python port.",
    )
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument("--fixture", action="store_true", help="synthetic corpus (the default)")
    mode.add_argument("--data-root", help="a real VOICE_JOURNEY_DATA root, read only")
    parser.add_argument("--approval", help="operator approval text (required with --data-root)")
    parser.add_argument("--corpus-root", help="the phone drop (default: see the docstring)")
    parser.add_argument("--fresh", action="store_true", help="--data-root: copy no manifests")
    parser.add_argument("--float-tolerance", type=float, default=0.0)
    parser.add_argument("--timestamp", default=DEFAULT_TIMESTAMP, help="the pinned timestamps")
    parser.add_argument("--commit", default=PINNED_COMMIT, help="the pinned Node tree commit")
    parser.add_argument("--node-tree", help="an extracted legacy/voice-journey tree instead")
    parser.add_argument("--node", default="node")
    parser.add_argument("--python", default=sys.executable)
    parser.add_argument("--out", help="write the report here instead of standard output")
    parser.add_argument("--show-values", action="store_true", help="--fixture only")
    parser.add_argument("--keep-workdir", action="store_true", help="--fixture only")
    args = parser.parse_args(argv)
    if args.float_tolerance < 0:
        parser.error("--float-tolerance must not be negative")
    if args.data_root and (args.show_values or args.keep_workdir):
        parser.error("--show-values and --keep-workdir are for --fixture only")
    if not args.data_root and (args.approval or args.corpus_root or args.fresh):
        parser.error("--approval, --corpus-root and --fresh need --data-root")
    return args


def _terminate(signum: int, _frame: FrameType | None) -> None:
    raise SystemExit(128 + signum)


@contextlib.contextmanager
def private_workdir(keep: bool) -> Iterator[Path]:
    work = Path(tempfile.mkdtemp(prefix="journey-parity-")).resolve()
    work.chmod(0o700)
    previous = {sig: signal.signal(sig, _terminate) for sig in (signal.SIGTERM, signal.SIGHUP)}
    try:
        if _inside(work, REPO_ROOT.resolve()):
            raise ParityError("refusing a temporary directory inside the repository")
        yield work
    finally:
        for sig, handler in previous.items():
            signal.signal(sig, handler)
        if keep:
            sys.stderr.write(f"journey-parity: kept {work}\n")
        else:
            shutil.rmtree(work, ignore_errors=True)


def build_report(args: argparse.Namespace, work: Path) -> dict[str, Any]:
    started = time.monotonic()
    fixture = not args.data_root
    plan = None if fixture else real_plan(args, work)
    node = shutil.which(args.node)
    if node is None:
        raise ParityError(f"node not found: {args.node}")
    if plan is None:
        ffmpeg = shutil.which(os.environ.get("FFMPEG_BIN", "ffmpeg"))
        if ffmpeg is None:
            raise ParityError("ffmpeg not found (FFMPEG_BIN or PATH)")
        plan = fixture_plan(work, ffmpeg=ffmpeg)
    tree = (
        Path(args.node_tree).resolve()
        if args.node_tree
        else extract_node_tree(work / "pinned", args.commit)
    )
    stages = build_stages(
        corpus_root=str(plan.corpus_root),
        measurement_root=str(plan.measurement_root),
        approval=plan.approval,
        timestamp=args.timestamp,
        worker=str(plan.worker),
    )
    sources = [*sorted((tree / "src").glob("*.mjs"))]
    sources += sorted((REPO_ROOT / "src" / "cole_voice_lab" / "journey").glob("*.py"))
    allowed = None if args.show_values else schema_keys(sources)
    node_version = (
        subprocess.run(
            [node, "--version"], capture_output=True, check=True, stdin=subprocess.DEVNULL
        )
        .stdout.decode()
        .strip()
    )
    runs = {
        side: run_side(side, plan, stages, work=work, node=node, tree=tree, python=args.python)
        for side in SIDES
    }
    stage_reports, artifacts = compare_runs(
        plan,
        stages,
        runs,
        work=work,
        tolerance=args.float_tolerance,
        allowed=allowed,
        show_values=args.show_values,
    )
    entries = [entry for report in stage_reports for entry in report["files"]] + artifacts
    differences = sum(entry["differences"] for entry in entries)
    failed = [f"{r['round']}:{r['stage']}" for r in stage_reports if r["result"] == "failed"]
    artifact_differences = sum(entry["differences"] for entry in artifacts)
    return {
        "schema": REPORT_SCHEMA,
        "mode": "fixture" if fixture else "data-root",
        "ok": differences == 0 and not failed,
        "pinnedNodeTree": {"commit": args.commit if not args.node_tree else "external tree"},
        "runtimes": {
            "node": node_version,
            "python": sys.version.split()[0],
        },
        "tools": plan.tools,
        "corpus": plan.corpus,
        "floatTolerance": args.float_tolerance,
        "pinnedTimestamp": args.timestamp,
        "summary": {
            "stages": {f"{r['round']}:{r['stage']}": r["result"] for r in stage_reports},
            "files": len(entries),
            "byteIdentical": sum(1 for entry in entries if entry["byteIdentical"]),
            "filesWithDifferences": sum(1 for entry in entries if entry["differences"]),
            "differences": differences,
            "ignoredDifferences": sum(entry["ignoredDifferences"] for entry in entries),
            "toleratedDifferences": sum(entry["toleratedDifferences"] for entry in entries),
            "artifacts": len(artifacts),
            "artifactDifferences": artifact_differences,
            "failedStages": failed,
            "seconds": {
                side: round(sum(run.seconds for rnd in runs[side] for run in rnd), 3)
                for side in SIDES
            },
            "totalSeconds": round(time.monotonic() - started, 3),
        },
        "ignoreRules": [
            {
                "file": rule.file,
                "path": rule.path,
                "reason": rule.reason,
                **({"kind": rule.kind} if rule.kind is not None else {}),
            }
            for rule in IGNORE_RULES
        ],
        "stages": stage_reports,
        "artifacts": artifacts,
    }


def main(argv: Sequence[str] | None = None) -> int:
    args = parse_args(argv)
    try:
        with private_workdir(args.keep_workdir) as work:
            report = build_report(args, work)
    except ParityError as error:
        sys.stderr.write(f"journey-parity: {error}\n")
        return 2
    except subprocess.CalledProcessError as error:
        # Never echo the command line or its output: they can name private files.
        sys.stderr.write(f"journey-parity: a setup command failed (exit {error.returncode})\n")
        return 2
    text = json.dumps(report, indent=2) + "\n"
    if args.out:
        Path(args.out).write_text(text, encoding="utf-8")
    else:
        sys.stdout.write(text)
    return 0 if report["ok"] else 1


if __name__ == "__main__":
    raise SystemExit(main())
